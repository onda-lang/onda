import std/smoothing

namespace std::gain:
  const DB_TO_GAIN_SCALE: f64 = 0.11512925464970229

  proc Constant<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      gain = 1.0

    sample:
      out1 = in1 * gain

  proc Db<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      db = 0.0 => update_gain

    init<T>:
      linear_gain = 1.0

    def update_gain():
      linear_gain = exp(db * T(DB_TO_GAIN_SCALE))

    sample:
      out1 = in1 * linear_gain

  proc Smoothed<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      gain = 1.0
      time_s = 0.05 => update_time

    init<T>:
      smooth = std::smoothing::Lag<T>(time_s = time_s)

    def update_time():
      smooth.time_s = time_s

    sample:
      out1 = in1 * smooth(gain)

  proc SmoothedDb<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      db = 0.0 => update_gain
      time_s = 0.05 => update_time

    init<T>:
      smooth = std::smoothing::Lag<T>(time_s = time_s)
      target_gain = 1.0

    def update_gain():
      target_gain = exp(db * T(DB_TO_GAIN_SCALE))

    def update_time():
      smooth.time_s = time_s

    sample:
      out1 = in1 * smooth(target_gain)
