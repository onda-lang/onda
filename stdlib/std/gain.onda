# Amplitude adjustment in linear gain or decibels.
# Supports both direct control and smoothed gain changes.
# Smoothed and SmoothedDb start at the requested initial gain and smooth later
# changes in linear amplitude. SmoothedDb converts its dB target before smoothing.
# lag_s is a time constant: about 63.2% of the remaining change in that time.

import std/smoothing
import std/levels

namespace std::gain:
  proc Constant<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      gain = 1.0

    sample:
      out1 = in1 * gain

  proc Db<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      db = 0.0 => update_gain

    init<T>:
      linear_gain = 1.0

    def update_gain():
      linear_gain = std::levels::db_to_gain<T>(db)

    sample:
      out1 = in1 * linear_gain

  proc Smoothed<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      gain = 1.0
      lag_s = 0.05 => update_lag

    init<T>:
      smooth = std::smoothing::Lag<T>(lag_s = lag_s)
      smooth.reset(gain)

    def update_lag():
      smooth.lag_s = lag_s

    sample:
      out1 = in1 * smooth(gain)

  proc SmoothedDb<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      db = 0.0 => update_gain
      lag_s = 0.05 => update_lag

    init<T>:
      smooth = std::smoothing::Lag<T>(lag_s = lag_s)
      target_gain = std::levels::db_to_gain<T>(db)
      smooth.reset(target_gain)

    def update_gain():
      target_gain = std::levels::db_to_gain<T>(db)

    def update_lag():
      smooth.lag_s = lag_s

    sample:
      out1 = in1 * smooth(target_gain)
