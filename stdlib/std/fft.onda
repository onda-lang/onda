import std/math
import std/complex

namespace std::fft<N = 256>:
  assert(N > 1 && (N & (N - 1)) == 0)

  const def _hann_window() -> f64[N]:
    values: f64[N]
    if (N <= 1):
      values[0] = 1.0
    else:
      denom = f64(N - 1)
      for i in 0..N:
        phase = TWO_PI * f64(i) / denom
        values[i] = 0.5 - 0.5 * cos(phase)
    return values
  
  const def _rectangular_window() -> f64[N]:
    values: f64[N]
    for i in 0..N:
      values[i] = 1.0
    return values

  const def _hamming_window() -> f64[N]:
    values: f64[N]
    if (N <= 1):
      values[0] = 1.0
    else:
      denom = f64(N - 1)
      for i in 0..N:
        phase = TWO_PI * f64(i) / denom
        values[i] = 0.54 - 0.46 * cos(phase)
    return values

  const def _blackman_window() -> f64[N]:
    values: f64[N]
    if (N <= 1):
      values[0] = 1.0
    else:
      denom = f64(N - 1)
      for i in 0..N:
        phase = TWO_PI * f64(i) / denom
        values[i] = 0.42 - 0.5 * cos(phase) + 0.08 * cos(2.0 * phase)
    return values

  const Hann: f64[N] = _hann_window()
  const Rectangular: f64[N] = _rectangular_window()
  const Hamming: f64[N] = _hamming_window()
  const Blackman: f64[N] = _blackman_window()

  const _WindowHann: i32 = 1
  const _WindowRectangular: i32 = 2
  const _WindowHamming: i32 = 3
  const _WindowBlackman: i32 = 4
  
  def _min_i(a: i32, b: i32):
    if (a < b):
      return a
    return b

  def _ilog2(n: i32):
    bits = 0
    value = n
    while (value > 1):
      value = value >> 1
      bits = bits + 1
    return bits

  def _bit_reverse(value: i32, bits: i32):
    x = value
    rev = 0
    i = 0
    while (i < bits):
      rev = (rev << 1) | (x & 1)
      x = x >> 1
      i = i + 1
    return rev

  def _build_bitrev(bitrev: i32[], n: i32):
    bits = _ilog2(n)
    for i in 0..n:
      bitrev[i] = _bit_reverse(i, bits)

  def _wrap_add(base: i32, offset: i32, n: i32):
    idx = base + offset
    if (idx >= n):
      idx = idx - n
    return idx


  struct FFT<T>:
    bins: std::complex::Complex<T>[N]
    twiddles: std::complex::Complex<T>[N]
    bitrev: i32[N]
    prepared: bool

    def size(self):
      return N

    def real_bin_count(self):
      return (N >> 1) + 1

    def clear(self):
      for i in 0..N:
        self.bins[i].clear()

    def set_bin(self, i: i32, re, im):
      self.bins[i].set(re, im)

    def load_real(self, input: T[]):
      count = _min_i(input.len(), N)
      for i in 0..count:
        self.bins[i].set(input[i], 0.0)
      for i in count..N:
        self.bins[i].clear()

    def load_complex(self, real: T[], imag: T[]):
      count = _min_i(real.len(), imag.len())
      count = _min_i(count, N)
      for i in 0..count:
        self.bins[i].set(real[i], imag[i])
      for i in count..N:
        self.bins[i].clear()

    def store_real(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.bins[i].real()

    def store_imag(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.bins[i].imag()

    def store_magnitude(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.magnitude(i)

    def store_power(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.power(i)

    def store_phase(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.phase(i)

    def store_real_packed(self, output: T[]):
      half = N >> 1
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = 0.0
      real_count = _min_i(count, half + 1)
      for i in 0..real_count:
        output[i] = self.bins[i].real()
      imag_count = _min_i(count - (half + 1), half - 1)
      for i in 0..imag_count:
        output[half + 1 + i] = self.bins[i + 1].imag()

    def load_real_packed(self, input: T[]):
      self.clear()
      half = N >> 1
      count = _min_i(input.len(), N)

      if (count > 0):
        self.set_bin(0, input[0], 0.0)

      if (count > half):
        self.set_bin(half, input[half], 0.0)

      imag_count = _min_i(count - (half + 1), half - 1)
      if (imag_count < 0):
        imag_count = 0

      real_count = _min_i(count, half)
      for i in 1..real_count:
        self.set_bin(i, input[i], 0.0)
        self.set_bin(N - i, input[i], 0.0)

      for i in 0..imag_count:
        imag_v = input[half + 1 + i]
        bin = i + 1
        self.set_bin(bin, self.real(bin), imag_v)
        self.set_bin(N - bin, self.real(N - bin), -imag_v)

    def store_real_spectrum_magnitude(self, output: T[]):
      count = _min_i(output.len(), self.real_bin_count())
      for i in 0..count:
        output[i] = self.magnitude(i)

    def store_real_spectrum_power(self, output: T[]):
      count = _min_i(output.len(), self.real_bin_count())
      for i in 0..count:
        output[i] = self.power(i)

    def store_real_spectrum_phase(self, output: T[]):
      count = _min_i(output.len(), self.real_bin_count())
      for i in 0..count:
        output[i] = self.phase(i)

    def real(self, i: i32):
      return self.bins[i].real()

    def imag(self, i: i32):
      return self.bins[i].imag()

    def power(self, i: i32):
      re = self.real(i)
      im = self.imag(i)
      return re * re + im * im

    def magnitude(self, i: i32):
      return sqrt(self.power(i))

    def phase(self, i: i32):
      return atan2(self.imag(i), self.real(i))

    def forward_real(self, input: T[]):
      self.load_real(input)
      self.forward()

    def forward_real_packed(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_packed(output)

    def forward_complex(self, real: T[], imag: T[]):
      self.load_complex(real, imag)
      self.forward()

    def forward_real_magnitude(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_magnitude(output)

    def forward_real_power(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_power(output)

    def forward_real_phase(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_phase(output)

    def forward(self):
      self._transform(false)

    def inverse(self):
      self._transform(true)

    def inverse_real_packed(self, input: T[], output: T[]):
      self.load_real_packed(input)
      self.inverse()
      self.store_real(output)

    def _ensure_tables(self):
      if (!self.prepared):
        _build_bitrev(self.bitrev, N)
        angle_step: T = TWO_PI / T(N)
        step_r = cos(angle_step)
        step_i = sin(angle_step)
        half = N >> 1
        if (half > 0):
          self.twiddles[0].set(1.0, 0.0)
          wr: T = 1.0
          wi: T = 0.0
          for i in 1..half:
            next_wr = wr * step_r - wi * step_i
            next_wi = wr * step_i + wi * step_r
            wr = next_wr
            wi = next_wi
            self.twiddles[i].set(wr, wi)
        self.prepared = true

    def _transform(self, inverse: bool):
      self._transform_prefix(N, 0, inverse)

    def _transform_prefix(self, n: i32, bit_shift: i32, inverse: bool):
      self._ensure_tables()
      for i in 0..n:
        j = self.bitrev[i] >> bit_shift
        if (j > i):
          temp_r = self.bins[i].real()
          temp_i = self.bins[i].imag()
          self.bins[i].set(self.bins[j].real(), self.bins[j].imag())
          self.bins[j].set(temp_r, temp_i)

      stage = 2
      while (stage <= n):
        half = stage >> 1
        tw_stride = N / stage

        start = 0
        while (start < n):
          k = 0
          while (k < half):
            tw_idx = k * tw_stride
            wr = self.twiddles[tw_idx].real()
            wi = self.twiddles[tw_idx].imag()
            if (!inverse):
              wi = -wi

            even_i = start + k
            odd_i = even_i + half

            odd_r = self.bins[odd_i].real()
            odd_i_v = self.bins[odd_i].imag()

            tw_r = wr * odd_r - wi * odd_i_v
            tw_i = wr * odd_i_v + wi * odd_r

            even_r = self.bins[even_i].real()
            even_i_v = self.bins[even_i].imag()

            self.bins[even_i].set(even_r + tw_r, even_i_v + tw_i)
            self.bins[odd_i].set(even_r - tw_r, even_i_v - tw_i)

            k = k + 1
          start = start + stage
        stage = stage << 1

      if (inverse):
        inverse_scale: T = 1.0 / T(n)
        for i in 0..n:
          self.bins[i].set(self.bins[i].real() * inverse_scale, self.bins[i].imag() * inverse_scale)

  struct STFT<T>:
    fft: FFT<T>
    window_kind: i32 = _WindowHann

    def size(self):
      return N

    def real_bin_count(self):
      return (N >> 1) + 1

    def _window_value(self, i: i32) -> T:
      if (self.window_kind == _WindowHann):
        return T(Hann[i])
      elif (self.window_kind == _WindowRectangular):
        return T(Rectangular[i])
      elif (self.window_kind == _WindowHamming):
        return T(Hamming[i])
      elif (self.window_kind == _WindowBlackman):
        return T(Blackman[i])
      return T(Hann[i])

    def set_hann(self):
      self.window_kind = _WindowHann

    def set_rectangular(self):
      self.window_kind = _WindowRectangular

    def set_hamming(self):
      self.window_kind = _WindowHamming

    def set_blackman(self):
      self.window_kind = _WindowBlackman

    def window_value(self, i: i32):
      return self._window_value(i)

    def store_window(self, output: T[]):
      count = _min_i(output.len(), N)
      kind = self.window_kind
      if (kind == _WindowHann):
        for i in 0..count:
          output[i] = T(Hann[i])
      elif (kind == _WindowRectangular):
        for i in 0..count:
          output[i] = T(Rectangular[i])
      elif (kind == _WindowHamming):
        for i in 0..count:
          output[i] = T(Hamming[i])
      elif (kind == _WindowBlackman):
        for i in 0..count:
          output[i] = T(Blackman[i])
      else:
        for i in 0..count:
          output[i] = T(Hann[i])

    def clear(self):
      self.fft.clear()

    def real(self, i: i32):
      return self.fft.real(i)

    def imag(self, i: i32):
      return self.fft.imag(i)

    def power(self, i: i32):
      return self.fft.power(i)

    def magnitude(self, i: i32):
      return self.fft.magnitude(i)

    def phase(self, i: i32):
      return self.fft.phase(i)

    def store_real_packed(self, output: T[]):
      self.fft.store_real_packed(output)

    def store_real_spectrum_magnitude(self, output: T[]):
      self.fft.store_real_spectrum_magnitude(output)

    def store_real_spectrum_power(self, output: T[]):
      self.fft.store_real_spectrum_power(output)

    def store_real_spectrum_phase(self, output: T[]):
      self.fft.store_real_spectrum_phase(output)

    def _load_windowed_real(self, input: T[]):
      count = _min_i(input.len(), N)
      kind = self.window_kind
      if (kind == _WindowHann):
        for i in 0..count:
          self.fft.set_bin(i, input[i] * T(Hann[i]), 0.0)
      elif (kind == _WindowRectangular):
        for i in 0..count:
          self.fft.set_bin(i, input[i] * T(Rectangular[i]), 0.0)
      elif (kind == _WindowHamming):
        for i in 0..count:
          self.fft.set_bin(i, input[i] * T(Hamming[i]), 0.0)
      elif (kind == _WindowBlackman):
        for i in 0..count:
          self.fft.set_bin(i, input[i] * T(Blackman[i]), 0.0)
      else:
        for i in 0..count:
          self.fft.set_bin(i, input[i] * T(Hann[i]), 0.0)
      for i in count..N:
        self.fft.set_bin(i, 0.0, 0.0)

    def forward_real(self, input: T[]):
      self._load_windowed_real(input)
      self.fft.forward()

    def forward_real_packed(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_packed(output)

    def forward_real_magnitude(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_magnitude(output)

    def forward_real_power(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_power(output)

    def forward_real_phase(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_phase(output)

  struct RealFFT<T>:
    fft: FFT<T>
    input: T[N]
    window_kind: i32 = _WindowHann
    write: i32
    filled: i32
    since_hop: i32
    ready: bool

    def size(self):
      return N

    def real_bin_count(self):
      return (N >> 1) + 1

    def hop_size(self):
      return N >> 1

    def _window_value(self, i: i32) -> T:
      if (self.window_kind == _WindowHann):
        return T(Hann[i])
      return T(Rectangular[i])

    def set_rectangular(self):
      self.window_kind = _WindowRectangular

    def set_hann(self):
      self.window_kind = _WindowHann

    def clear(self):
      self.fft.clear()
      self.write = 0
      self.filled = 0
      self.since_hop = 0
      self.ready = false
      for i in 0..N:
        self.input[i] = 0.0

    def push(self, x: T):
      self.input[self.write] = x
      self.ready = false

      self.write = self.write + 1
      if (self.write >= N):
        self.write = 0

      if (self.filled < N):
        self.filled = self.filled + 1

      self.since_hop = self.since_hop + 1
      if (self.filled >= N && self.since_hop >= (N >> 1)):
        self.since_hop = 0
        kind = self.window_kind
        half = N >> 1
        if (kind == _WindowHann):
          for i in 0..half:
            even = i << 1
            odd = even + 1
            even_idx = _wrap_add(self.write, even, N)
            odd_idx = _wrap_add(self.write, odd, N)
            self.fft.set_bin(
              i,
              self.input[even_idx] * T(Hann[even]),
              self.input[odd_idx] * T(Hann[odd]),
            )
        else:
          for i in 0..half:
            even = i << 1
            odd = even + 1
            even_idx = _wrap_add(self.write, even, N)
            odd_idx = _wrap_add(self.write, odd, N)
            self.fft.set_bin(
              i,
              self.input[even_idx] * T(Rectangular[even]),
              self.input[odd_idx] * T(Rectangular[odd]),
            )

        # A real N-point transform is reconstructed from one complex N/2-point
        # transform. Only the non-redundant positive spectrum is materialized.
        self.fft._transform_prefix(half, 1, false)
        z0_re = self.fft.real(0)
        z0_im = self.fft.imag(0)
        self.fft.set_bin(0, z0_re + z0_im, 0.0)
        self.fft.set_bin(half, z0_re - z0_im, 0.0)

        quarter = half >> 1
        for k in 1..quarter:
          mirror = half - k
          a_re = self.fft.real(k)
          a_im = self.fft.imag(k)
          mirror_re = self.fft.real(mirror)
          mirror_im = self.fft.imag(mirror)

          even_re = (a_re + mirror_re) * 0.5
          even_im = (a_im - mirror_im) * 0.5
          odd_re = (a_im + mirror_im) * 0.5
          odd_im = (mirror_re - a_re) * 0.5
          tw_re = self.fft.twiddles[k].real()
          tw_im = self.fft.twiddles[k].imag()
          rotated_re = tw_re * odd_re + tw_im * odd_im
          rotated_im = tw_re * odd_im - tw_im * odd_re

          bin_re = even_re + rotated_re
          bin_im = even_im + rotated_im
          mirror_bin_re = even_re - rotated_re
          mirror_bin_im = -even_im + rotated_im
          self.fft.set_bin(k, bin_re, bin_im)
          self.fft.set_bin(mirror, mirror_bin_re, mirror_bin_im)

        if (quarter > 0):
          quarter_re = self.fft.real(quarter)
          quarter_im = self.fft.imag(quarter)
          self.fft.set_bin(quarter, quarter_re, -quarter_im)
        self.ready = true
      if (self.ready):
        return true
      return false

    def is_ready(self):
      return self.ready

    def real(self, i: i32):
      return self.fft.real(i)

    def imag(self, i: i32):
      return self.fft.imag(i)

    def power(self, i: i32):
      re = self.real(i)
      im = self.imag(i)
      return re * re + im * im

    def magnitude(self, i: i32):
      return sqrt(self.power(i))

    def phase(self, i: i32):
      return atan2(self.imag(i), self.real(i))

    def packed_value(self, i: i32):
      half = N >> 1
      if (i <= half):
        return self.real(i)
      return self.imag(i - half)

    def store_real_packed(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.packed_value(i)

  struct RealIFFT<T>:
    fft: FFT<T>
    output: T[N]
    norm: T[N]
    window_kind: i32 = _WindowHann
    frame: i32
    pending: i32
    overlap_frames: i32

    def size(self):
      return N

    def hop_size(self):
      return N >> 1

    def _window_value(self, i: i32) -> T:
      if (self.window_kind == _WindowHann):
        return T(Hann[i])
      return T(Rectangular[i])

    def set_hann(self):
      self.window_kind = _WindowHann

    def set_rectangular(self):
      self.window_kind = _WindowRectangular

    def clear(self):
      self.fft.clear()
      self.frame = 0
      self.pending = 0
      self.overlap_frames = 0
      for i in 0..N:
        self.output[i] = 0.0
        self.norm[i] = 0.0

    def load_packed(self, input: T[]):
      half = N >> 1
      count = _min_i(input.len(), N)
      for k in 0..(half + 1):
        re: T = 0.0
        im: T = 0.0
        if (k < count):
          re = input[k]
        if (k > 0 && k < half && half + k < count):
          im = input[half + k]
        self.fft.set_bin(k, re, im)
      self._inverse_loaded_real_spectrum()

    def load_complex(self, real: T[], imag: T[]):
      count = _min_i(real.len(), imag.len())
      count = _min_i(count, N)
      half = N >> 1
      for k in 0..(half + 1):
        re: T = 0.0
        im: T = 0.0
        if (k < count):
          re = real[k]
          im = imag[k]
        self.fft.set_bin(k, re, im)
      self._inverse_loaded_real_spectrum()

    def _inverse_loaded_real_spectrum(self):
      self.fft._ensure_tables()
      half = N >> 1
      dc = self.fft.real(0)
      nyquist = self.fft.real(half)
      self.fft.set_bin(0, (dc + nyquist) * 0.5, (dc - nyquist) * 0.5)
      quarter = half >> 1
      for k in 1..quarter:
        mirror = half - k
        x_re = self.fft.real(k)
        x_im = self.fft.imag(k)
        mirror_re = self.fft.real(mirror)
        mirror_im = self.fft.imag(mirror)

        even_re = (x_re + mirror_re) * 0.5
        even_im = (x_im - mirror_im) * 0.5
        rotated_re = (x_re - mirror_re) * 0.5
        rotated_im = (x_im + mirror_im) * 0.5
        tw_re = self.fft.twiddles[k].real()
        tw_im = self.fft.twiddles[k].imag()
        odd_re = tw_re * rotated_re - tw_im * rotated_im
        odd_im = tw_im * rotated_re + tw_re * rotated_im

        self.fft.set_bin(k, even_re - odd_im, even_im + odd_re)
        self.fft.set_bin(mirror, even_re + odd_im, odd_re - even_im)

      if (quarter > 0):
        quarter_re = self.fft.real(quarter)
        quarter_im = self.fft.imag(quarter)
        self.fft.set_bin(quarter, quarter_re, -quarter_im)

      self.fft._transform_prefix(half, 1, true)
      self._accumulate_real_ifft_frame()

    def _accumulate_real_ifft_frame(self):
      half = N >> 1
      kind = self.window_kind
      if (kind == _WindowHann):
        for i in 0..half:
          even = i << 1
          odd = even + 1
          even_idx = _wrap_add(self.frame, even, N)
          odd_idx = _wrap_add(self.frame, odd, N)
          even_w = T(Hann[even])
          odd_w = T(Hann[odd])
          self.output[even_idx] = self.output[even_idx] + self.fft.real(i) * even_w
          self.output[odd_idx] = self.output[odd_idx] + self.fft.imag(i) * odd_w
          self.norm[even_idx] = self.norm[even_idx] + even_w * even_w
          self.norm[odd_idx] = self.norm[odd_idx] + odd_w * odd_w
      else:
        for i in 0..half:
          even = i << 1
          odd = even + 1
          even_idx = _wrap_add(self.frame, even, N)
          odd_idx = _wrap_add(self.frame, odd, N)
          even_w = T(Rectangular[even])
          odd_w = T(Rectangular[odd])
          self.output[even_idx] = self.output[even_idx] + self.fft.real(i) * even_w
          self.output[odd_idx] = self.output[odd_idx] + self.fft.imag(i) * odd_w
          self.norm[even_idx] = self.norm[even_idx] + even_w * even_w
          self.norm[odd_idx] = self.norm[odd_idx] + odd_w * odd_w
      if (kind == _WindowHann && self.overlap_frames < 2):
        self.overlap_frames = self.overlap_frames + 1
      else:
        self.overlap_frames = 2
      self.pending = N

    def tick(self):
      if (self.pending <= 0):
        return T(0.0)

      y = self.output[self.frame]
      denom = self.norm[self.frame]
      if (self.overlap_frames < 2):
        y = 0.0
      elif (denom > 0.0):
        y = y / denom

      self.output[self.frame] = 0.0
      self.norm[self.frame] = 0.0
      self.frame = self.frame + 1
      if (self.frame >= N):
        self.frame = 0
      self.pending = self.pending - 1
      if (self.pending <= 0):
        self.overlap_frames = 0
      return y

    def is_active(self):
      return self.pending > 0
