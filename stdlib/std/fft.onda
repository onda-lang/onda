import std/math
import std/complex

# Keep coefficients in the arithmetic precision of each specialization.
namespace std::_fft_coefficients<Count = 256>:
  const def narrow(values: f64[]) -> f32[Count]:
    result: f32[Count]
    for i in 0..Count:
      result[i] = f32(values[i])
    return result

  # Precision-specific base widths balance register use and vectorization.
  def odd_base_width(precision: f32, n: i32):
    if n < 8:
      return n
    return 8

  def odd_base_width(precision: f64, n: i32):
    return n

  def at(precision: f32, wide: f64[], single: f32[], i: i32):
    return single.read_unsafe(i)

  def at(precision: f64, wide: f64[], single: f32[], i: i32):
    return wide.read_unsafe(i)

# Namespace specialization fixes each stage's strides before optimization.
namespace std::_fft_radix4<Stage = 4>:
  def transform<T>(real: T[], imag: T[], n: i32, direction: T,
    wide_real: f64[], wide_imag: f64[], single_real: f32[], single_imag: f32[],
    base: i32 = 0, odd_length: bool = false):
    # Binary bit reversal swaps the middle two radix-4 inputs.
    stage = Stage
    if odd_length:
      stage *= 2
    quarter = stage >> 2
    start = base
    while start < base + n:
      for k in 0..quarter:
        a = start + k
        b = a + quarter
        c = b + quarter
        d = c + quarter
        ar = real.read_unsafe(a)
        ai = imag.read_unsafe(a)
        br = real.read_unsafe(b)
        bi = imag.read_unsafe(b)
        cr = real.read_unsafe(c)
        ci = imag.read_unsafe(c)
        dr = real.read_unsafe(d)
        di = imag.read_unsafe(d)

        if stage > 4:
          coeff = 3 * (quarter - 1) + k
          w1r = std::_fft_coefficients::at(T(0.0), wide_real, single_real, coeff)
          w1i = direction * std::_fft_coefficients::at(T(0.0), wide_imag, single_imag, coeff)
          w2r = std::_fft_coefficients::at(T(0.0), wide_real, single_real, coeff + quarter)
          w2i = direction * std::_fft_coefficients::at(T(0.0), wide_imag, single_imag, coeff + quarter)
          w3r = std::_fft_coefficients::at(T(0.0), wide_real, single_real, coeff + 2 * quarter)
          w3i = direction * std::_fft_coefficients::at(T(0.0), wide_imag, single_imag, coeff + 2 * quarter)
          temp = w2r * br - w2i * bi
          bi = w2r * bi + w2i * br
          br = temp
          temp = w1r * cr - w1i * ci
          ci = w1r * ci + w1i * cr
          cr = temp
          temp = w3r * dr - w3i * di
          di = w3r * di + w3i * dr
          dr = temp

        ur = ar + br
        ui = ai + bi
        vr = ar - br
        vi = ai - bi
        pr = cr + dr
        sum_i = ci + di
        tr = direction * (cr - dr)
        ti = direction * (ci - di)
        real.write_unsafe(a, ur + pr)
        imag.write_unsafe(a, ui + sum_i)
        real.write_unsafe(b, vr - ti)
        imag.write_unsafe(b, vi + tr)
        real.write_unsafe(c, ur - pr)
        imag.write_unsafe(c, ui - sum_i)
        real.write_unsafe(d, vr + ti)
        imag.write_unsafe(d, vi - tr)
      start += stage

namespace std::fft<N = 256>:
  assert(N > 1 && (N & (N - 1)) == 0)

  const def _hann_window() -> f64[N]:
    values: f64[N]
    if (N <= 1):
      values[0] = 1.0
    else:
      denom = f64(N - 1)
      for i in 0..N:
        phase = TWO_PI * f64(i) / denom
        values[i] = 0.5 - 0.5 * cos(phase)
    return values
  
  const def _rectangular_window() -> f64[N]:
    values: f64[N]
    for i in 0..N:
      values[i] = 1.0
    return values

  const def _hamming_window() -> f64[N]:
    values: f64[N]
    if (N <= 1):
      values[0] = 1.0
    else:
      denom = f64(N - 1)
      for i in 0..N:
        phase = TWO_PI * f64(i) / denom
        values[i] = 0.54 - 0.46 * cos(phase)
    return values

  const def _blackman_window() -> f64[N]:
    values: f64[N]
    if (N <= 1):
      values[0] = 1.0
    else:
      denom = f64(N - 1)
      for i in 0..N:
        phase = TWO_PI * f64(i) / denom
        values[i] = 0.42 - 0.5 * cos(phase) + 0.08 * cos(2.0 * phase)
    return values

  const Hann: f64[N] = _hann_window()
  const Rectangular: f64[N] = _rectangular_window()
  const Hamming: f64[N] = _hamming_window()
  const Blackman: f64[N] = _blackman_window()

  const _WindowHann = 1
  const _WindowRectangular = 2
  const _WindowHamming = 3
  const _WindowBlackman = 4
  
  def _min_i(a: i32, b: i32):
    if (a < b):
      return a
    return b

  def _read_unchecked(values: [], index: i32):
    return values.read_unsafe(index)

  def _write_unchecked(values: [], index: i32, value):
    values.write_unsafe(index, value)

  const def _bit_reverse_table() -> i32[N]:
    values: i32[N]
    values[0] = 0
    for i in 1..N:
      values[i] = (values[i >> 1] >> 1) | ((i & 1) * (N >> 1))
    return values

  const def _twiddle_real() -> f64[N / 2]:
    values: f64[N / 2]
    for i in 0..(N / 2):
      values[i] = cos(TWO_PI * f64(i) / f64(N))
    return values

  const def _twiddle_imag() -> f64[N / 2]:
    values: f64[N / 2]
    for i in 0..(N / 2):
      values[i] = sin(TWO_PI * f64(i) / f64(N))
    return values

  # Bits 0, 2, 4, ... distinguish powers of four from twice a power of four.
  const _PowerOfFourBits = 1431655765

  const _BitReverse: i32[N] = _bit_reverse_table()
  const _TwiddleReal: f64[N / 2] = _twiddle_real()
  const _TwiddleImag: f64[N / 2] = _twiddle_imag()

  # Each radix-4 stage has three contiguous coefficient planes. A stage of
  # length 4*q starts at 3*(q-1), the sum of the preceding stage lengths.
  const _Radix4CoefficientCount = N + N / 2

  const def _radix4_coefficients(imaginary: bool) -> f64[_Radix4CoefficientCount]:
    values: f64[_Radix4CoefficientCount]
    for level in 2..31:
      stage = 1 << level
      if stage <= N:
        quarter = stage >> 2
        for power in 1..4:
          for k in 0..quarter:
            phase = TWO_PI * f64(power * k) / f64(stage)
            position = power * k
            value: f64 = 0.0
            if imaginary:
              if position == quarter:
                value = 1.0
              elif position != 0 && position != (stage >> 1):
                value = sin(phase)
            else:
              if position == 0:
                value = 1.0
              elif position == (stage >> 1):
                value = -1.0
              elif position != quarter:
                value = cos(phase)
            values[3 * (quarter - 1) + (power - 1) * quarter + k] = value
    return values

  const _Radix4Real: f64[_Radix4CoefficientCount] = _radix4_coefficients(false)
  const _Radix4Imag: f64[_Radix4CoefficientCount] = _radix4_coefficients(true)
  const _TwiddleReal32: f32[N / 2] = std::_fft_coefficients<N / 2>::narrow(_TwiddleReal)
  const _TwiddleImag32: f32[N / 2] = std::_fft_coefficients<N / 2>::narrow(_TwiddleImag)
  const _Radix4Real32: f32[_Radix4CoefficientCount] = std::_fft_coefficients<_Radix4CoefficientCount>::narrow(_Radix4Real)
  const _Radix4Imag32: f32[_Radix4CoefficientCount] = std::_fft_coefficients<_Radix4CoefficientCount>::narrow(_Radix4Imag)

  def _twiddle_real_at(precision, i: i32):
    return std::_fft_coefficients::at(precision, _TwiddleReal, _TwiddleReal32, i)

  def _twiddle_imag_at(precision, i: i32):
    return std::_fft_coefficients::at(precision, _TwiddleImag, _TwiddleImag32, i)

  def _wrap_add(base: i32, offset: i32, n: i32):
    idx = base + offset
    if idx >= n:
      idx -= n
    return idx


  struct FFT<T>:
    bin_real: T[N]
    bin_imag: T[N]

    def size(self):
      return N

    def real_bin_count(self):
      return (N >> 1) + 1

    def clear(self):
      self.bin_real[:] = 0.0
      self.bin_imag[:] = 0.0

    def set_bin(self, i: i32, re, im):
      self.bin_real[i] = re
      self.bin_imag[i] = im

    # The radix loop and real-transform reconstruction establish these bounds.
    # Isolating unchecked access here retains safe, clamped public accessors.
    def _real_at(self, i: i32):
      return _read_unchecked(self.bin_real, i)

    def _imag_at(self, i: i32):
      return _read_unchecked(self.bin_imag, i)

    def _set_bin_at(self, i: i32, re, im):
      _write_unchecked(self.bin_real, i, re)
      _write_unchecked(self.bin_imag, i, im)

    def load_real(self, input: T[]):
      count = _min_i(input.len(), N)
      for i in 0..count:
        self.set_bin(i, input[i], 0.0)
      for i in count..N:
        self.set_bin(i, 0.0, 0.0)

    def load_complex(self, real: T[], imag: T[]):
      count = _min_i(real.len(), imag.len())
      count = _min_i(count, N)
      for i in 0..count:
        self.set_bin(i, real[i], imag[i])
      for i in count..N:
        self.set_bin(i, 0.0, 0.0)

    def load_complex(self, input: std::complex::Complex<T>[]):
      count = _min_i(input.len(), N)
      for i in 0..count:
        value = input[i]
        self.bin_real[i] = value.re
        self.bin_imag[i] = value.im
      for i in count..N:
        self.bin_real[i] = 0.0
        self.bin_imag[i] = 0.0

    def store_real(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.real(i)

    def store_imag(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.imag(i)

    def store_complex(self, output: std::complex::Complex<T>[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i].set(self.real(i), self.imag(i))

    def store_magnitude(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.magnitude(i)

    def store_power(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.power(i)

    def store_phase(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.phase(i)

    def store_real_packed(self, output: T[]):
      half = N >> 1
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = 0.0
      real_count = _min_i(count, half + 1)
      for i in 0..real_count:
        output[i] = self.real(i)
      imag_count = _min_i(count - (half + 1), half - 1)
      for i in 0..imag_count:
        output[half + 1 + i] = self.imag(i + 1)

    def load_real_packed(self, input: T[]):
      self.clear()
      half = N >> 1
      count = _min_i(input.len(), N)

      if count > 0:
        self.set_bin(0, input[0], 0.0)

      if count > half:
        self.set_bin(half, input[half], 0.0)

      imag_count = _min_i(count - (half + 1), half - 1)
      if imag_count < 0:
        imag_count = 0

      real_count = _min_i(count, half)
      for i in 1..real_count:
        self.set_bin(i, input[i], 0.0)
        self.set_bin(N - i, input[i], 0.0)

      for i in 0..imag_count:
        imag_v = input[half + 1 + i]
        bin = i + 1
        self.set_bin(bin, self.real(bin), imag_v)
        self.set_bin(N - bin, self.real(N - bin), -imag_v)

    def store_real_spectrum_magnitude(self, output: T[]):
      count = _min_i(output.len(), self.real_bin_count())
      for i in 0..count:
        output[i] = self.magnitude(i)

    def store_real_spectrum_power(self, output: T[]):
      count = _min_i(output.len(), self.real_bin_count())
      for i in 0..count:
        output[i] = self.power(i)

    def store_real_spectrum_phase(self, output: T[]):
      count = _min_i(output.len(), self.real_bin_count())
      for i in 0..count:
        output[i] = self.phase(i)

    def real(self, i: i32):
      return self.bin_real[i]

    def imag(self, i: i32):
      return self.bin_imag[i]

    def power(self, i: i32):
      re = self.real(i)
      im = self.imag(i)
      return re * re + im * im

    def magnitude(self, i: i32):
      return sqrt(self.power(i))

    def phase(self, i: i32):
      return atan2(self.imag(i), self.real(i))

    def forward_real(self, input: T[]):
      self._load_real_pairs(input)
      self._forward_loaded_real()
      self._complete_real_spectrum()

    def forward_real_packed(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_packed(output)

    def forward_complex(self, real: T[], imag: T[]):
      self.load_complex(real, imag)
      self.forward()

    def forward_complex(self, input: std::complex::Complex<T>[]):
      self.load_complex(input)
      self.forward()

    def forward_real_magnitude(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_magnitude(output)

    def forward_real_power(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_power(output)

    def forward_real_phase(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_phase(output)

    def forward(self):
      self._transform(false)

    def inverse(self):
      self._transform(true)

    def inverse_real_packed(self, input: T[], output: T[]):
      self.load_real_packed(input)
      self.inverse()
      self.store_real(output)

    def _transform(self, inverse: bool):
      self._transform_prefix(N, 0, inverse)

    def _transform_prefix(self, n: i32, bit_shift: i32, inverse: bool):
      for i in 0..n:
        j = _BitReverse.read_unsafe(i) >> bit_shift
        if j > i:
          temp_r = self._real_at(i)
          temp_i = self._imag_at(i)
          other_r = self._real_at(j)
          other_i = self._imag_at(j)
          self._set_bin_at(i, other_r, other_i)
          self._set_bin_at(j, temp_r, temp_i)

      direction: T = -1.0
      if inverse:
        direction = 1.0

      # Start odd binary lengths with radix-2, then use radix-4 throughout.
      odd_length = (n & _PowerOfFourBits) == 0
      if odd_length:
        width = std::_fft_coefficients::odd_base_width(T(0.0), n)
        for group in 0..(n / width):
          base = group * width
          self._radix2_base(width, base)
          if n >= 8:
            std::_fft_radix4<4>::transform(self.bin_real, self.bin_imag, width, direction,
              _Radix4Real, _Radix4Imag, _Radix4Real32, _Radix4Imag32, base, true)
        if n >= 32:
          std::_fft_radix4<16>::transform(self.bin_real, self.bin_imag, n, direction,
            _Radix4Real, _Radix4Imag, _Radix4Real32, _Radix4Imag32, 0, true)
      elif n >= 16:
        for group in 0..(n >> 4):
          base = group << 4
          std::_fft_radix4<4>::transform(self.bin_real, self.bin_imag, 16, direction,
            _Radix4Real, _Radix4Imag, _Radix4Real32, _Radix4Imag32, base)
          std::_fft_radix4<16>::transform(self.bin_real, self.bin_imag, 16, direction,
            _Radix4Real, _Radix4Imag, _Radix4Real32, _Radix4Imag32, base)
      elif n >= 4:
        std::_fft_radix4<4>::transform(self.bin_real, self.bin_imag, n, direction,
          _Radix4Real, _Radix4Imag, _Radix4Real32, _Radix4Imag32)

      # Literal namespace arguments keep stage geometry static in each kernel.
      if n >= 64:
        std::_fft_radix4<64>::transform(self.bin_real, self.bin_imag, n, direction,
          _Radix4Real, _Radix4Imag, _Radix4Real32, _Radix4Imag32, 0, odd_length)
      if n >= 256:
        std::_fft_radix4<256>::transform(self.bin_real, self.bin_imag, n, direction,
          _Radix4Real, _Radix4Imag, _Radix4Real32, _Radix4Imag32, 0, odd_length)
      if n >= 1024:
        std::_fft_radix4<1024>::transform(self.bin_real, self.bin_imag, n, direction,
          _Radix4Real, _Radix4Imag, _Radix4Real32, _Radix4Imag32, 0, odd_length)
      if n >= 4096:
        std::_fft_radix4<4096>::transform(self.bin_real, self.bin_imag, n, direction,
          _Radix4Real, _Radix4Imag, _Radix4Real32, _Radix4Imag32, 0, odd_length)
      if n >= 16384:
        std::_fft_radix4<16384>::transform(self.bin_real, self.bin_imag, n, direction,
          _Radix4Real, _Radix4Imag, _Radix4Real32, _Radix4Imag32, 0, odd_length)
      if n >= 65536:
        std::_fft_radix4<65536>::transform(self.bin_real, self.bin_imag, n, direction,
          _Radix4Real, _Radix4Imag, _Radix4Real32, _Radix4Imag32, 0, odd_length)
      if n >= 262144:
        std::_fft_radix4<262144>::transform(self.bin_real, self.bin_imag, n, direction,
          _Radix4Real, _Radix4Imag, _Radix4Real32, _Radix4Imag32, 0, odd_length)
      if n >= 1048576:
        std::_fft_radix4<1048576>::transform(self.bin_real, self.bin_imag, n, direction,
          _Radix4Real, _Radix4Imag, _Radix4Real32, _Radix4Imag32, 0, odd_length)
      if n >= 4194304:
        std::_fft_radix4<4194304>::transform(self.bin_real, self.bin_imag, n, direction,
          _Radix4Real, _Radix4Imag, _Radix4Real32, _Radix4Imag32, 0, odd_length)
      if n >= 16777216:
        std::_fft_radix4<16777216>::transform(self.bin_real, self.bin_imag, n, direction,
          _Radix4Real, _Radix4Imag, _Radix4Real32, _Radix4Imag32, 0, odd_length)
      if n >= 67108864:
        std::_fft_radix4<67108864>::transform(self.bin_real, self.bin_imag, n, direction,
          _Radix4Real, _Radix4Imag, _Radix4Real32, _Radix4Imag32, 0, odd_length)
      if n >= 268435456:
        std::_fft_radix4<268435456>::transform(self.bin_real, self.bin_imag, n, direction,
          _Radix4Real, _Radix4Imag, _Radix4Real32, _Radix4Imag32, 0, odd_length)
      if n >= 1073741824:
        std::_fft_radix4<1073741824>::transform(self.bin_real, self.bin_imag, n, direction,
          _Radix4Real, _Radix4Imag, _Radix4Real32, _Radix4Imag32, 0, odd_length)

      if inverse:
        inverse_scale = T(1.0) / T(n)
        for i in 0..n:
          self._set_bin_at(
            i,
            self._real_at(i) * inverse_scale,
            self._imag_at(i) * inverse_scale
          )

    def _radix2_base(self, n: i32, base: i32):
      for pair in 0..(n >> 1):
        a = base + (pair << 1)
        b = a + 1
        ar = self._real_at(a)
        ai = self._imag_at(a)
        br = self._real_at(b)
        bi = self._imag_at(b)
        self._set_bin_at(a, ar + br, ai + bi)
        self._set_bin_at(b, ar - br, ai - bi)

    def _load_real_pairs(self, input: T[]):
      count = _min_i(input.len(), N)
      pairs = count >> 1
      for i in 0..pairs:
        self._set_bin_at(i, input.read_unsafe(2 * i), input.read_unsafe(2 * i + 1))
      for i in pairs..(N >> 1):
        self._set_bin_at(i, 0.0, 0.0)
      if (count & 1) != 0:
        self._set_bin_at(pairs, input.read_unsafe(count - 1), 0.0)

    def _complete_real_spectrum(self):
      for k in ((N >> 1) + 1)..N:
        self._set_bin_at(k, self._real_at(N - k), -self._imag_at(N - k))

    # Complete an N-point real transform after bins 0..N/2 have been loaded
    # with the even samples as real parts and odd samples as imaginary parts.
    def _forward_loaded_real(self):
      half = N >> 1
      self._transform_prefix(half, 1, false)

      z0_re = self._real_at(0)
      z0_im = self._imag_at(0)
      self._set_bin_at(0, z0_re + z0_im, 0.0)
      self._set_bin_at(half, z0_re - z0_im, 0.0)

      quarter = half >> 1
      for k in 1..quarter:
        mirror = half - k
        a_re = self._real_at(k)
        a_im = self._imag_at(k)
        mirror_re = self._real_at(mirror)
        mirror_im = self._imag_at(mirror)

        even_re = (a_re + mirror_re) * 0.5
        even_im = (a_im - mirror_im) * 0.5
        odd_re = (a_im + mirror_im) * 0.5
        odd_im = (mirror_re - a_re) * 0.5
        tw_re = _twiddle_real_at(T(0.0), k)
        tw_im = _twiddle_imag_at(T(0.0), k)
        rotated_re = tw_re * odd_re + tw_im * odd_im
        rotated_im = tw_re * odd_im - tw_im * odd_re

        self._set_bin_at(k, even_re + rotated_re, even_im + rotated_im)
        self._set_bin_at(mirror, even_re - rotated_re, -even_im + rotated_im)

      if quarter > 0:
        quarter_re = self._real_at(quarter)
        quarter_im = self._imag_at(quarter)
        self._set_bin_at(quarter, quarter_re, -quarter_im)

    # Prepare and execute the inverse of the positive real spectrum currently
    # stored in bins 0..N/2. The result is interleaved across the first N/2
    # complex bins: even samples in real parts and odd samples in imaginary parts.
    def _inverse_loaded_real(self):
      half = N >> 1
      dc = self._real_at(0)
      nyquist = self._real_at(half)
      self._set_bin_at(0, (dc + nyquist) * 0.5, (dc - nyquist) * 0.5)

      quarter = half >> 1
      for k in 1..quarter:
        mirror = half - k
        x_re = self._real_at(k)
        x_im = self._imag_at(k)
        mirror_re = self._real_at(mirror)
        mirror_im = self._imag_at(mirror)

        even_re = (x_re + mirror_re) * 0.5
        even_im = (x_im - mirror_im) * 0.5
        rotated_re = (x_re - mirror_re) * 0.5
        rotated_im = (x_im + mirror_im) * 0.5
        tw_re = _twiddle_real_at(T(0.0), k)
        tw_im = _twiddle_imag_at(T(0.0), k)
        odd_re = tw_re * rotated_re - tw_im * rotated_im
        odd_im = tw_im * rotated_re + tw_re * rotated_im

        self._set_bin_at(k, even_re - odd_im, even_im + odd_re)
        self._set_bin_at(mirror, even_re + odd_im, odd_re - even_im)

      if quarter > 0:
        quarter_re = self._real_at(quarter)
        quarter_im = self._imag_at(quarter)
        self._set_bin_at(quarter, quarter_re, -quarter_im)

      self._transform_prefix(half, 1, true)

  # Reusable, non-windowed real transform workspace. It exposes only the
  # non-redundant spectrum and uses one N/2 complex transform in each direction.
  struct RealTransform<T>:
    fft: FFT<T>

    def size(self):
      return N

    def real_bin_count(self):
      return (N >> 1) + 1

    def clear(self):
      self.fft.clear()

    def real(self, i: i32):
      return self.fft.real(i)

    def imag(self, i: i32):
      return self.fft.imag(i)

    def forward(self, input: T[]):
      self.fft._load_real_pairs(input)
      self.fft._forward_loaded_real()

    def inverse(self, real: T[], imag: T[], output: T[]):
      half = N >> 1
      count = _min_i(_min_i(real.len(), imag.len()), half + 1)
      for i in 0..(half + 1):
        re: T = 0.0
        im: T = 0.0
        if i < count:
          re = real.read_unsafe(i)
          im = imag.read_unsafe(i)
        self.fft._set_bin_at(i, re, im)

      self.fft._inverse_loaded_real()

      output_count = _min_i(output.len(), N)
      for i in 0..half:
        even = i << 1
        odd = even + 1
        if even < output_count:
          output.write_unsafe(even, self.fft._real_at(i))
        if odd < output_count:
          output.write_unsafe(odd, self.fft._imag_at(i))

  struct STFT<T>:
    fft: FFT<T>
    window_kind = _WindowHann

    def size(self):
      return N

    def real_bin_count(self):
      return (N >> 1) + 1

    def _window_value(self, i: i32) -> T:
      if (self.window_kind == _WindowHann):
        return T(Hann[i])
      elif (self.window_kind == _WindowRectangular):
        return T(Rectangular[i])
      elif (self.window_kind == _WindowHamming):
        return T(Hamming[i])
      elif (self.window_kind == _WindowBlackman):
        return T(Blackman[i])
      return T(Hann[i])

    def set_hann(self):
      self.window_kind = _WindowHann

    def set_rectangular(self):
      self.window_kind = _WindowRectangular

    def set_hamming(self):
      self.window_kind = _WindowHamming

    def set_blackman(self):
      self.window_kind = _WindowBlackman

    def window_value(self, i: i32):
      return self._window_value(i)

    def store_window(self, output: T[]):
      count = _min_i(output.len(), N)
      kind = self.window_kind
      if (kind == _WindowHann):
        for i in 0..count:
          output[i] = T(Hann[i])
      elif (kind == _WindowRectangular):
        for i in 0..count:
          output[i] = T(Rectangular[i])
      elif (kind == _WindowHamming):
        for i in 0..count:
          output[i] = T(Hamming[i])
      elif (kind == _WindowBlackman):
        for i in 0..count:
          output[i] = T(Blackman[i])
      else:
        for i in 0..count:
          output[i] = T(Hann[i])

    def clear(self):
      self.fft.clear()

    def real(self, i: i32):
      return self.fft.real(i)

    def imag(self, i: i32):
      return self.fft.imag(i)

    def power(self, i: i32):
      return self.fft.power(i)

    def magnitude(self, i: i32):
      return self.fft.magnitude(i)

    def phase(self, i: i32):
      return self.fft.phase(i)

    def store_real_packed(self, output: T[]):
      self.fft.store_real_packed(output)

    def store_real_spectrum_magnitude(self, output: T[]):
      self.fft.store_real_spectrum_magnitude(output)

    def store_real_spectrum_power(self, output: T[]):
      self.fft.store_real_spectrum_power(output)

    def store_real_spectrum_phase(self, output: T[]):
      self.fft.store_real_spectrum_phase(output)

    def _load_windowed_pairs(self, input: T[], window: f64[]):
      count = _min_i(input.len(), N)
      pairs = count >> 1
      for i in 0..pairs:
        even = 2 * i
        odd = even + 1
        self.fft._set_bin_at(i,
          input.read_unsafe(even) * T(window.read_unsafe(even)),
          input.read_unsafe(odd) * T(window.read_unsafe(odd)))
      for i in pairs..(N >> 1):
        self.fft._set_bin_at(i, 0.0, 0.0)
      if (count & 1) != 0:
        i = count - 1
        self.fft._set_bin_at(pairs, input.read_unsafe(i) * T(window.read_unsafe(i)), 0.0)

    def forward_real(self, input: T[]):
      kind = self.window_kind
      if kind == _WindowRectangular:
        self.fft._load_real_pairs(input)
      elif kind == _WindowHamming:
        self._load_windowed_pairs(input, Hamming)
      elif kind == _WindowBlackman:
        self._load_windowed_pairs(input, Blackman)
      else:
        self._load_windowed_pairs(input, Hann)
      self.fft._forward_loaded_real()
      self.fft._complete_real_spectrum()

    def forward_real_packed(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_packed(output)

    def forward_real_magnitude(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_magnitude(output)

    def forward_real_power(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_power(output)

    def forward_real_phase(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_phase(output)

  struct RealFFT<T>:
    fft: FFT<T>
    input: T[N]
    window_kind = _WindowHann
    write = 0 {N, wrap}
    filled = 0
    since_hop = 0
    ready = false

    def size(self):
      return N

    def real_bin_count(self):
      return (N >> 1) + 1

    def hop_size(self):
      return N >> 1

    def _window_value(self, i: i32) -> T:
      if (self.window_kind == _WindowHann):
        return T(Hann[i])
      return T(Rectangular[i])

    def set_rectangular(self):
      self.window_kind = _WindowRectangular

    def set_hann(self):
      self.window_kind = _WindowHann

    def clear(self):
      self.fft.clear()
      self.write = 0
      self.filled = 0
      self.since_hop = 0
      self.ready = false
      for i in 0..N:
        self.input[i] = 0.0

    def push(self, x: T):
      self.input[self.write] = x
      self.ready = false

      self.write += 1

      if self.filled < N:
        self.filled += 1

      self.since_hop += 1
      if self.filled >= N && self.since_hop >= (N >> 1):
        self.since_hop = 0
        kind = self.window_kind
        half = N >> 1
        if kind == _WindowHann:
          for i in 0..half:
            even = i << 1
            odd = even + 1
            even_idx = _wrap_add(self.write, even, N)
            odd_idx = _wrap_add(self.write, odd, N)
            self.fft.set_bin(
              i,
              self.input[even_idx] * T(Hann[even]),
              self.input[odd_idx] * T(Hann[odd])
            )
        else:
          for i in 0..half:
            even = i << 1
            odd = even + 1
            even_idx = _wrap_add(self.write, even, N)
            odd_idx = _wrap_add(self.write, odd, N)
            self.fft.set_bin(
              i,
              self.input[even_idx] * T(Rectangular[even]),
              self.input[odd_idx] * T(Rectangular[odd])
            )

        # A real N-point transform is reconstructed from one complex N/2-point
        # transform. Only the non-redundant positive spectrum is materialized.
        self.fft._forward_loaded_real()
        self.ready = true
      if self.ready:
        return true
      return false

    def is_ready(self):
      return self.ready

    def real(self, i: i32):
      return self.fft.real(i)

    def imag(self, i: i32):
      return self.fft.imag(i)

    def power(self, i: i32):
      re = self.real(i)
      im = self.imag(i)
      return re * re + im * im

    def magnitude(self, i: i32):
      return sqrt(self.power(i))

    def phase(self, i: i32):
      return atan2(self.imag(i), self.real(i))

    def packed_value(self, i: i32):
      half = N >> 1
      if i <= half:
        return self.real(i)
      return self.imag(i - half)

    def store_real_packed(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.packed_value(i)

  struct RealIFFT<T>:
    fft: FFT<T>
    output: T[N]
    norm: T[N]
    window_kind = _WindowHann
    frame = 0 {N, wrap}
    pending = 0
    overlap_frames = 0

    def size(self):
      return N

    def hop_size(self):
      return N >> 1

    def _window_value(self, i: i32) -> T:
      if (self.window_kind == _WindowHann):
        return T(Hann[i])
      return T(Rectangular[i])

    def set_hann(self):
      self.window_kind = _WindowHann

    def set_rectangular(self):
      self.window_kind = _WindowRectangular

    def clear(self):
      self.fft.clear()
      self.frame = 0
      self.pending = 0
      self.overlap_frames = 0
      for i in 0..N:
        self.output[i] = 0.0
        self.norm[i] = 0.0

    def load_packed(self, input: T[]):
      half = N >> 1
      count = _min_i(input.len(), N)
      for k in 0..(half + 1):
        re: T = 0.0
        im: T = 0.0
        if k < count:
          re = input[k]
        if k > 0 && k < half && half + k < count:
          im = input[half + k]
        self.fft.set_bin(k, re, im)
      self._inverse_loaded_real_spectrum()

    def load_complex(self, real: T[], imag: T[]):
      count = _min_i(real.len(), imag.len())
      count = _min_i(count, N)
      half = N >> 1
      for k in 0..(half + 1):
        re: T = 0.0
        im: T = 0.0
        if k < count:
          re = real[k]
          im = imag[k]
        self.fft.set_bin(k, re, im)
      self._inverse_loaded_real_spectrum()

    def _inverse_loaded_real_spectrum(self):
      self.fft._inverse_loaded_real()
      self._accumulate_real_ifft_frame()

    def _accumulate_real_ifft_frame(self):
      half = N >> 1
      kind = self.window_kind
      if kind == _WindowHann:
        for i in 0..half:
          even = i << 1
          odd = even + 1
          even_idx = _wrap_add(self.frame, even, N)
          odd_idx = _wrap_add(self.frame, odd, N)
          even_w = T(Hann[even])
          odd_w = T(Hann[odd])
          self.output[even_idx] = self.output[even_idx] + self.fft.real(i) * even_w
          self.output[odd_idx] = self.output[odd_idx] + self.fft.imag(i) * odd_w
          self.norm[even_idx] = self.norm[even_idx] + even_w * even_w
          self.norm[odd_idx] = self.norm[odd_idx] + odd_w * odd_w
      else:
        for i in 0..half:
          even = i << 1
          odd = even + 1
          even_idx = _wrap_add(self.frame, even, N)
          odd_idx = _wrap_add(self.frame, odd, N)
          even_w = T(Rectangular[even])
          odd_w = T(Rectangular[odd])
          self.output[even_idx] = self.output[even_idx] + self.fft.real(i) * even_w
          self.output[odd_idx] = self.output[odd_idx] + self.fft.imag(i) * odd_w
          self.norm[even_idx] = self.norm[even_idx] + even_w * even_w
          self.norm[odd_idx] = self.norm[odd_idx] + odd_w * odd_w
      if kind == _WindowHann && self.overlap_frames < 2:
        self.overlap_frames += 1
      else:
        self.overlap_frames = 2
      self.pending = N

    def tick(self):
      if self.pending <= 0:
        return T(0.0)

      y = self.output[self.frame]
      denom = self.norm[self.frame]
      if self.overlap_frames < 2:
        y = 0.0
      elif denom > 0.0:
        y = y / denom

      self.output[self.frame] = 0.0
      self.norm[self.frame] = 0.0
      self.frame += 1
      self.pending -= 1
      if self.pending <= 0:
        self.overlap_frames = 0
      return y

    def is_active(self):
      return self.pending > 0
