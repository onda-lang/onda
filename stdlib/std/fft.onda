import std/math
import std/complex

namespace std::fft<N = 256>:
  assert(N > 0 && (N & (N - 1)) == 0)

  def _min_i(a: i32, b: i32):
    if (a < b):
      return a
    return b

  def _ilog2(n: i32):
    bits = 0
    value = n
    while (value > 1):
      value = value >> 1
      bits = bits + 1
    return bits

  def _bit_reverse(value: i32, bits: i32):
    x = value
    rev = 0
    i = 0
    while (i < bits):
      rev = (rev << 1) | (x & 1)
      x = x >> 1
      i = i + 1
    return rev

  def _build_bitrev(bitrev: i32[], n: i32):
    bits = _ilog2(n)
    for i in 0..n:
      bitrev[i] = _bit_reverse(i, bits)

  def _wrap_add(base: i32, offset: i32, n: i32):
    idx = base + offset
    if (idx >= n):
      idx = idx - n
    return idx

  struct FFT<T>:
    bins: std::complex::Complex<T>[N]
    twiddles: std::complex::Complex<T>[N]
    bitrev: i32[N]
    prepared: bool

    def size(self):
      return N

    def real_bin_count(self):
      return (N >> 1) + 1

    def clear(self):
      for i in 0..N:
        self.bins[i].clear()

    def set_bin(self, i: i32, re, im):
      self.bins[i].set(re, im)

    def load_real(self, input: T[]):
      self.clear()
      count = _min_i(input.len(), N)
      for i in 0..count:
        self.bins[i].set(input[i], 0.0)

    def load_complex(self, real: T[], imag: T[]):
      self.clear()
      count = _min_i(real.len(), imag.len())
      count = _min_i(count, N)
      for i in 0..count:
        self.bins[i].set(real[i], imag[i])

    def store_real(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.bins[i].real()

    def store_imag(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.bins[i].imag()

    def store_magnitude(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.magnitude(i)

    def store_power(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.power(i)

    def store_phase(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.phase(i)

    def store_real_packed(self, output: T[]):
      half = N >> 1
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = 0.0
      real_count = _min_i(count, half + 1)
      for i in 0..real_count:
        output[i] = self.bins[i].real()
      imag_count = _min_i(count - (half + 1), half - 1)
      for i in 0..imag_count:
        output[half + 1 + i] = self.bins[i + 1].imag()

    def load_real_packed(self, input: T[]):
      self.clear()
      half = N >> 1
      count = _min_i(input.len(), N)

      if (count > 0):
        self.set_bin(0, input[0], 0.0)

      if (count > half):
        self.set_bin(half, input[half], 0.0)

      imag_count = _min_i(count - (half + 1), half - 1)
      if (imag_count < 0):
        imag_count = 0

      real_count = _min_i(count, half)
      for i in 1..real_count:
        self.set_bin(i, input[i], 0.0)
        self.set_bin(N - i, input[i], 0.0)

      for i in 0..imag_count:
        imag_v = input[half + 1 + i]
        bin = i + 1
        self.set_bin(bin, self.real(bin), imag_v)
        self.set_bin(N - bin, self.real(N - bin), -imag_v)

    def store_real_spectrum_magnitude(self, output: T[]):
      count = _min_i(output.len(), self.real_bin_count())
      for i in 0..count:
        output[i] = self.magnitude(i)

    def store_real_spectrum_power(self, output: T[]):
      count = _min_i(output.len(), self.real_bin_count())
      for i in 0..count:
        output[i] = self.power(i)

    def store_real_spectrum_phase(self, output: T[]):
      count = _min_i(output.len(), self.real_bin_count())
      for i in 0..count:
        output[i] = self.phase(i)

    def real(self, i: i32):
      return self.bins[i].real()

    def imag(self, i: i32):
      return self.bins[i].imag()

    def power(self, i: i32):
      re = self.real(i)
      im = self.imag(i)
      return re * re + im * im

    def magnitude(self, i: i32):
      return sqrt(self.power(i))

    def phase(self, i: i32):
      return atan2(self.imag(i), self.real(i))

    def forward_real(self, input: T[]):
      self.load_real(input)
      self.forward()

    def forward_real_packed(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_packed(output)

    def forward_complex(self, real: T[], imag: T[]):
      self.load_complex(real, imag)
      self.forward()

    def forward_real_magnitude(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_magnitude(output)

    def forward_real_power(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_power(output)

    def forward_real_phase(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_phase(output)

    def forward(self):
      self._transform(false)

    def inverse(self):
      self._transform(true)

    def inverse_real_packed(self, input: T[], output: T[]):
      self.load_real_packed(input)
      self.inverse()
      self.store_real(output)

    def _ensure_tables(self):
      if (!self.prepared):
        _build_bitrev(self.bitrev, N)
        angle_step: T = TWO_PI / T(N)
        step_r = cos(angle_step)
        step_i = sin(angle_step)
        half = N >> 1
        if (half > 0):
          self.twiddles[0].set(1.0, 0.0)
          wr: T = 1.0
          wi: T = 0.0
          for i in 1..half:
            next_wr = wr * step_r - wi * step_i
            next_wi = wr * step_i + wi * step_r
            wr = next_wr
            wi = next_wi
            self.twiddles[i].set(wr, wi)
        self.prepared = true

    def _transform(self, inverse: bool):
      self._ensure_tables()
      for i in 0..N:
        j = self.bitrev[i]
        if (j > i):
          temp_r = self.bins[i].real()
          temp_i = self.bins[i].imag()
          self.bins[i].set(self.bins[j].real(), self.bins[j].imag())
          self.bins[j].set(temp_r, temp_i)

      stage = 2
      while (stage <= N):
        half = stage >> 1
        tw_stride = N / stage

        start = 0
        while (start < N):
          k = 0
          while (k < half):
            tw_idx = k * tw_stride
            wr = self.twiddles[tw_idx].real()
            wi = self.twiddles[tw_idx].imag()
            if (!inverse):
              wi = -wi

            even_i = start + k
            odd_i = even_i + half

            odd_r = self.bins[odd_i].real()
            odd_i_v = self.bins[odd_i].imag()

            tw_r = wr * odd_r - wi * odd_i_v
            tw_i = wr * odd_i_v + wi * odd_r

            even_r = self.bins[even_i].real()
            even_i_v = self.bins[even_i].imag()

            self.bins[even_i].set(even_r + tw_r, even_i_v + tw_i)
            self.bins[odd_i].set(even_r - tw_r, even_i_v - tw_i)

            k = k + 1
          start = start + stage
        stage = stage << 1

      if (inverse):
        inverse_scale: T = 1.0 / T(N)
        for i in 0..N:
          self.bins[i].set(self.bins[i].real() * inverse_scale, self.bins[i].imag() * inverse_scale)

  struct STFT<T>:
    fft: FFT<T>
    window: T[N]
    window_ready: bool

    def size(self):
      return N

    def real_bin_count(self):
      return (N >> 1) + 1

    def _set_single_point_window(self, value: T):
      self.window[0] = value
      self.window_ready = true

    def _window_denominator(self):
      if (N <= 1):
        return T(1.0)
      return T(N - 1)

    def _ensure_window(self):
      if (!self.window_ready):
        self.set_rectangular()

    def set_rectangular(self):
      for i in 0..N:
        self.window[i] = 1.0
      self.window_ready = true

    def set_hann(self):
      if (N <= 1):
        self._set_single_point_window(T(1.0))
      else:
        denom: T = self._window_denominator()
        for i in 0..N:
          phase: T = TWO_PI * T(i) / denom
          self.window[i] = 0.5 - 0.5 * cos(phase)
        self.window_ready = true

    def set_hamming(self):
      if (N <= 1):
        self._set_single_point_window(T(1.0))
      else:
        denom: T = self._window_denominator()
        for i in 0..N:
          phase: T = TWO_PI * T(i) / denom
          self.window[i] = 0.54 - 0.46 * cos(phase)
        self.window_ready = true

    def set_blackman(self):
      if (N <= 1):
        self._set_single_point_window(T(1.0))
      else:
        denom: T = self._window_denominator()
        for i in 0..N:
          phase: T = TWO_PI * T(i) / denom
          self.window[i] = 0.42 - 0.5 * cos(phase) + 0.08 * cos(2.0 * phase)
        self.window_ready = true

    def window_value(self, i: i32):
      self._ensure_window()
      return self.window[i]

    def store_window(self, output: T[]):
      self._ensure_window()
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.window[i]

    def clear(self):
      self.fft.clear()

    def real(self, i: i32):
      return self.fft.real(i)

    def imag(self, i: i32):
      return self.fft.imag(i)

    def power(self, i: i32):
      return self.fft.power(i)

    def magnitude(self, i: i32):
      return self.fft.magnitude(i)

    def phase(self, i: i32):
      return self.fft.phase(i)

    def store_real_packed(self, output: T[]):
      self.fft.store_real_packed(output)

    def store_real_spectrum_magnitude(self, output: T[]):
      self.fft.store_real_spectrum_magnitude(output)

    def store_real_spectrum_power(self, output: T[]):
      self.fft.store_real_spectrum_power(output)

    def store_real_spectrum_phase(self, output: T[]):
      self.fft.store_real_spectrum_phase(output)

    def _load_windowed_real(self, input: T[]):
      self._ensure_window()
      self.fft.clear()
      count = _min_i(input.len(), N)
      for i in 0..count:
        self.fft.set_bin(i, input[i] * self.window[i], 0.0)

    def forward_real(self, input: T[]):
      self._load_windowed_real(input)
      self.fft.forward()

    def forward_real_packed(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_packed(output)

    def forward_real_magnitude(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_magnitude(output)

    def forward_real_power(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_power(output)

    def forward_real_phase(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_phase(output)

  struct RealFFT<T>:
    fft: FFT<T>
    input: T[N]
    packed: T[N]
    window: T[N]
    write: i32
    filled: i32
    since_hop: i32
    ready: bool
    window_ready: bool

    def size(self):
      return N

    def real_bin_count(self):
      return (N >> 1) + 1

    def hop_size(self):
      return N >> 1

    def _set_single_point_window(self, value: T):
      self.window[0] = value
      self.window_ready = true

    def _window_denominator(self):
      if (N <= 1):
        return T(1.0)
      return T(N - 1)

    def _ensure_window(self):
      if (!self.window_ready):
        self.set_hann()

    def set_rectangular(self):
      for i in 0..N:
        self.window[i] = 1.0
      self.window_ready = true

    def set_hann(self):
      if (N <= 1):
        self._set_single_point_window(T(1.0))
      else:
        denom: T = self._window_denominator()
        for i in 0..N:
          phase: T = TWO_PI * T(i) / denom
          self.window[i] = 0.5 - 0.5 * cos(phase)
        self.window_ready = true

    def clear(self):
      self.fft.clear()
      self.write = 0
      self.filled = 0
      self.since_hop = 0
      self.ready = false
      for i in 0..N:
        self.input[i] = 0.0
        self.packed[i] = 0.0

    def push(self, x: T):
      self.input[self.write] = x
      self.ready = false

      self.write = self.write + 1
      if (self.write >= N):
        self.write = 0

      if (self.filled < N):
        self.filled = self.filled + 1

      self.since_hop = self.since_hop + 1
      if (self.filled >= N && self.since_hop >= (N >> 1)):
        self.since_hop = 0
        self._ensure_window()
        self.fft.clear()
        for i in 0..N:
          idx = _wrap_add(self.write, i, N)
          self.fft.set_bin(i, self.input[idx] * self.window[i], 0.0)
        self.fft.forward()
        half = N >> 1
        real_count = half + 1
        imag_bins = half - 1
        for i in 0..N:
          self.packed[i] = 0.0
        for i in 0..real_count:
          self.packed[i] = self.fft.real(i)
        for i in 0..imag_bins:
          self.packed[half + 1 + i] = self.fft.imag(i + 1)
        self.ready = true
      if (self.ready):
        return true
      return false

    def is_ready(self):
      return self.ready

    def packed_value(self, i: i32):
      return self.packed[i]

  struct RealIFFT<T>:
    fft: FFT<T>
    output: T[N]
    norm: T[N]
    window: T[N]
    frame: i32
    pending: i32
    window_ready: bool

    def size(self):
      return N

    def hop_size(self):
      return N >> 1

    def _set_single_point_window(self, value: T):
      self.window[0] = value
      self.window_ready = true

    def _window_denominator(self):
      if (N <= 1):
        return T(1.0)
      return T(N - 1)

    def _ensure_window(self):
      if (!self.window_ready):
        self.set_hann()

    def set_rectangular(self):
      for i in 0..N:
        self.window[i] = 1.0
      self.window_ready = true

    def set_hann(self):
      if (N <= 1):
        self._set_single_point_window(T(1.0))
      else:
        denom: T = self._window_denominator()
        for i in 0..N:
          phase: T = TWO_PI * T(i) / denom
          self.window[i] = 0.5 - 0.5 * cos(phase)
        self.window_ready = true

    def clear(self):
      self.fft.clear()
      self.frame = 0
      self.pending = 0
      for i in 0..N:
        self.output[i] = 0.0
        self.norm[i] = 0.0

    def load_packed(self, input: T[]):
      self.fft.clear()
      half = N >> 1
      count = _min_i(input.len(), N)

      if (count > 0):
        self.fft.set_bin(0, input[0], 0.0)

      if (count > half):
        self.fft.set_bin(half, input[half], 0.0)

      imag_count = _min_i(count - (half + 1), half - 1)
      if (imag_count < 0):
        imag_count = 0

      real_count = _min_i(count, half)
      for i in 1..real_count:
        self.fft.set_bin(i, input[i], 0.0)
        self.fft.set_bin(N - i, input[i], 0.0)

      for i in 0..imag_count:
        imag_v = input[half + 1 + i]
        bin = i + 1
        self.fft.set_bin(bin, self.fft.real(bin), imag_v)
        self.fft.set_bin(N - bin, self.fft.real(N - bin), -imag_v)

      self.fft.inverse()
      self._accumulate_ifft_frame()

    def load_complex(self, real: T[], imag: T[]):
      self.fft.load_complex(real, imag)
      self.fft.inverse()
      self._accumulate_ifft_frame()

    def _accumulate_ifft_frame(self):
      self._ensure_window()
      for i in 0..N:
        idx = _wrap_add(self.frame, i, N)
        w = self.window[i]
        self.output[idx] = self.output[idx] + self.fft.real(i) * w
        self.norm[idx] = self.norm[idx] + w * w
      self.pending = N

    def tick(self):
      if (self.pending <= 0):
        return T(0.0)

      y = self.output[self.frame]
      denom = self.norm[self.frame]
      if (denom > 0.0):
        y = y / denom

      self.output[self.frame] = 0.0
      self.norm[self.frame] = 0.0
      self.frame = self.frame + 1
      if (self.frame >= N):
        self.frame = 0
      self.pending = self.pending - 1
      return y

    def is_active(self):
      return self.pending > 0
