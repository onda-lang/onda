import std/math
import std/complex

namespace std::fft<N = 256>:
  assert(N > 1 && (N & (N - 1)) == 0)

  const def _hann_window() -> f64[N]:
    values: f64[N]
    if (N <= 1):
      values[0] = 1.0
    else:
      denom = f64(N - 1)
      for i in 0..N:
        phase = TWO_PI * f64(i) / denom
        values[i] = 0.5 - 0.5 * cos(phase)
    return values
  
  const def _rectangular_window() -> f64[N]:
    values: f64[N]
    for i in 0..N:
      values[i] = 1.0
    return values

  const def _hamming_window() -> f64[N]:
    values: f64[N]
    if (N <= 1):
      values[0] = 1.0
    else:
      denom = f64(N - 1)
      for i in 0..N:
        phase = TWO_PI * f64(i) / denom
        values[i] = 0.54 - 0.46 * cos(phase)
    return values

  const def _blackman_window() -> f64[N]:
    values: f64[N]
    if (N <= 1):
      values[0] = 1.0
    else:
      denom = f64(N - 1)
      for i in 0..N:
        phase = TWO_PI * f64(i) / denom
        values[i] = 0.42 - 0.5 * cos(phase) + 0.08 * cos(2.0 * phase)
    return values

  const Hann: f64[N] = _hann_window()
  const Rectangular: f64[N] = _rectangular_window()
  const Hamming: f64[N] = _hamming_window()
  const Blackman: f64[N] = _blackman_window()

  const _WindowHann = 1
  const _WindowRectangular = 2
  const _WindowHamming = 3
  const _WindowBlackman = 4
  
  def _min_i(a: i32, b: i32):
    if (a < b):
      return a
    return b

  def _read_unchecked(values: [], index: i32):
    return values.read_unsafe(index)

  def _write_unchecked(values: [], index: i32, value):
    values.write_unsafe(index, value)

  const def _bit_reverse_table() -> i32[N]:
    values: i32[N]
    values[0] = 0
    for i in 1..N:
      values[i] = (values[i >> 1] >> 1) | ((i & 1) * (N >> 1))
    return values

  const def _twiddle_real() -> f64[N / 2]:
    values: f64[N / 2]
    for i in 0..(N / 2):
      values[i] = cos(TWO_PI * f64(i) / f64(N))
    return values

  const def _twiddle_imag() -> f64[N / 2]:
    values: f64[N / 2]
    for i in 0..(N / 2):
      values[i] = sin(TWO_PI * f64(i) / f64(N))
    return values

  const _BitReverse: i32[N] = _bit_reverse_table()
  const _TwiddleReal: f64[N / 2] = _twiddle_real()
  const _TwiddleImag: f64[N / 2] = _twiddle_imag()

  def _wrap_add(base: i32, offset: i32, n: i32):
    idx = base + offset
    if idx >= n:
      idx -= n
    return idx


  struct FFT<T>:
    bin_real: T[N]
    bin_imag: T[N]

    def size(self):
      return N

    def real_bin_count(self):
      return (N >> 1) + 1

    def clear(self):
      self.bin_real[:] = 0.0
      self.bin_imag[:] = 0.0

    def set_bin(self, i: i32, re, im):
      self.bin_real[i] = re
      self.bin_imag[i] = im

    # The radix loop and real-transform reconstruction establish these bounds.
    # Isolating unchecked access here retains safe, clamped public accessors.
    def _real_at(self, i: i32):
      return _read_unchecked(self.bin_real, i)

    def _imag_at(self, i: i32):
      return _read_unchecked(self.bin_imag, i)

    def _set_bin_at(self, i: i32, re, im):
      _write_unchecked(self.bin_real, i, re)
      _write_unchecked(self.bin_imag, i, im)

    def load_real(self, input: T[]):
      count = _min_i(input.len(), N)
      for i in 0..count:
        self.set_bin(i, input[i], 0.0)
      for i in count..N:
        self.set_bin(i, 0.0, 0.0)

    def load_complex(self, real: T[], imag: T[]):
      count = _min_i(real.len(), imag.len())
      count = _min_i(count, N)
      for i in 0..count:
        self.set_bin(i, real[i], imag[i])
      for i in count..N:
        self.set_bin(i, 0.0, 0.0)

    def load_complex(self, input: std::complex::Complex<T>[]):
      count = _min_i(input.len(), N)
      for i in 0..count:
        value = input[i]
        self.bin_real[i] = value.re
        self.bin_imag[i] = value.im
      for i in count..N:
        self.bin_real[i] = 0.0
        self.bin_imag[i] = 0.0

    def store_real(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.real(i)

    def store_imag(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.imag(i)

    def store_complex(self, output: std::complex::Complex<T>[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i].set(self.real(i), self.imag(i))

    def store_magnitude(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.magnitude(i)

    def store_power(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.power(i)

    def store_phase(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.phase(i)

    def store_real_packed(self, output: T[]):
      half = N >> 1
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = 0.0
      real_count = _min_i(count, half + 1)
      for i in 0..real_count:
        output[i] = self.real(i)
      imag_count = _min_i(count - (half + 1), half - 1)
      for i in 0..imag_count:
        output[half + 1 + i] = self.imag(i + 1)

    def load_real_packed(self, input: T[]):
      self.clear()
      half = N >> 1
      count = _min_i(input.len(), N)

      if count > 0:
        self.set_bin(0, input[0], 0.0)

      if count > half:
        self.set_bin(half, input[half], 0.0)

      imag_count = _min_i(count - (half + 1), half - 1)
      if imag_count < 0:
        imag_count = 0

      real_count = _min_i(count, half)
      for i in 1..real_count:
        self.set_bin(i, input[i], 0.0)
        self.set_bin(N - i, input[i], 0.0)

      for i in 0..imag_count:
        imag_v = input[half + 1 + i]
        bin = i + 1
        self.set_bin(bin, self.real(bin), imag_v)
        self.set_bin(N - bin, self.real(N - bin), -imag_v)

    def store_real_spectrum_magnitude(self, output: T[]):
      count = _min_i(output.len(), self.real_bin_count())
      for i in 0..count:
        output[i] = self.magnitude(i)

    def store_real_spectrum_power(self, output: T[]):
      count = _min_i(output.len(), self.real_bin_count())
      for i in 0..count:
        output[i] = self.power(i)

    def store_real_spectrum_phase(self, output: T[]):
      count = _min_i(output.len(), self.real_bin_count())
      for i in 0..count:
        output[i] = self.phase(i)

    def real(self, i: i32):
      return self.bin_real[i]

    def imag(self, i: i32):
      return self.bin_imag[i]

    def power(self, i: i32):
      re = self.real(i)
      im = self.imag(i)
      return re * re + im * im

    def magnitude(self, i: i32):
      return sqrt(self.power(i))

    def phase(self, i: i32):
      return atan2(self.imag(i), self.real(i))

    def forward_real(self, input: T[]):
      self.load_real(input)
      self.forward()

    def forward_real_packed(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_packed(output)

    def forward_complex(self, real: T[], imag: T[]):
      self.load_complex(real, imag)
      self.forward()

    def forward_complex(self, input: std::complex::Complex<T>[]):
      self.load_complex(input)
      self.forward()

    def forward_real_magnitude(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_magnitude(output)

    def forward_real_power(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_power(output)

    def forward_real_phase(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_phase(output)

    def forward(self):
      self._transform(false)

    def inverse(self):
      self._transform(true)

    def inverse_real_packed(self, input: T[], output: T[]):
      self.load_real_packed(input)
      self.inverse()
      self.store_real(output)

    def _transform(self, inverse: bool):
      self._transform_prefix(N, 0, inverse)

    def _transform_prefix(self, n: i32, bit_shift: i32, inverse: bool):
      for i in 0..n:
        j = _BitReverse.read_unsafe(i) >> bit_shift
        if j > i:
          temp_r = self._real_at(i)
          temp_i = self._imag_at(i)
          other_r = self._real_at(j)
          other_i = self._imag_at(j)
          self._set_bin_at(i, other_r, other_i)
          self._set_bin_at(j, temp_r, temp_i)

      stage = 2
      while stage <= n:
        half = stage >> 1
        tw_stride = N / stage

        start = 0
        while start < n:
          k = 0
          while k < half:
            tw_idx = k * tw_stride
            wr = T(_TwiddleReal.read_unsafe(tw_idx))
            wi = T(_TwiddleImag.read_unsafe(tw_idx))
            if !inverse:
              wi = -wi

            even_i = start + k
            odd_i = even_i + half

            odd_r = self._real_at(odd_i)
            odd_i_v = self._imag_at(odd_i)

            tw_r = wr * odd_r - wi * odd_i_v
            tw_i = wr * odd_i_v + wi * odd_r

            even_r = self._real_at(even_i)
            even_i_v = self._imag_at(even_i)

            self._set_bin_at(even_i, even_r + tw_r, even_i_v + tw_i)
            self._set_bin_at(odd_i, even_r - tw_r, even_i_v - tw_i)

            k += 1
          start += stage
        stage <<= 1

      if inverse:
        inverse_scale = T(1.0) / T(n)
        for i in 0..n:
          self._set_bin_at(
            i,
            self._real_at(i) * inverse_scale,
            self._imag_at(i) * inverse_scale
          )

    # Complete an N-point real transform after bins 0..N/2 have been loaded
    # with the even samples as real parts and odd samples as imaginary parts.
    def _forward_loaded_real(self):
      half = N >> 1
      self._transform_prefix(half, 1, false)

      z0_re = self._real_at(0)
      z0_im = self._imag_at(0)
      self._set_bin_at(0, z0_re + z0_im, 0.0)
      self._set_bin_at(half, z0_re - z0_im, 0.0)

      quarter = half >> 1
      for k in 1..quarter:
        mirror = half - k
        a_re = self._real_at(k)
        a_im = self._imag_at(k)
        mirror_re = self._real_at(mirror)
        mirror_im = self._imag_at(mirror)

        even_re = (a_re + mirror_re) * 0.5
        even_im = (a_im - mirror_im) * 0.5
        odd_re = (a_im + mirror_im) * 0.5
        odd_im = (mirror_re - a_re) * 0.5
        tw_re = T(_TwiddleReal.read_unsafe(k))
        tw_im = T(_TwiddleImag.read_unsafe(k))
        rotated_re = tw_re * odd_re + tw_im * odd_im
        rotated_im = tw_re * odd_im - tw_im * odd_re

        self._set_bin_at(k, even_re + rotated_re, even_im + rotated_im)
        self._set_bin_at(mirror, even_re - rotated_re, -even_im + rotated_im)

      if quarter > 0:
        quarter_re = self._real_at(quarter)
        quarter_im = self._imag_at(quarter)
        self._set_bin_at(quarter, quarter_re, -quarter_im)

    # Prepare and execute the inverse of the positive real spectrum currently
    # stored in bins 0..N/2. The result is interleaved across the first N/2
    # complex bins: even samples in real parts and odd samples in imaginary parts.
    def _inverse_loaded_real(self):
      half = N >> 1
      dc = self._real_at(0)
      nyquist = self._real_at(half)
      self._set_bin_at(0, (dc + nyquist) * 0.5, (dc - nyquist) * 0.5)

      quarter = half >> 1
      for k in 1..quarter:
        mirror = half - k
        x_re = self._real_at(k)
        x_im = self._imag_at(k)
        mirror_re = self._real_at(mirror)
        mirror_im = self._imag_at(mirror)

        even_re = (x_re + mirror_re) * 0.5
        even_im = (x_im - mirror_im) * 0.5
        rotated_re = (x_re - mirror_re) * 0.5
        rotated_im = (x_im + mirror_im) * 0.5
        tw_re = T(_TwiddleReal.read_unsafe(k))
        tw_im = T(_TwiddleImag.read_unsafe(k))
        odd_re = tw_re * rotated_re - tw_im * rotated_im
        odd_im = tw_im * rotated_re + tw_re * rotated_im

        self._set_bin_at(k, even_re - odd_im, even_im + odd_re)
        self._set_bin_at(mirror, even_re + odd_im, odd_re - even_im)

      if quarter > 0:
        quarter_re = self._real_at(quarter)
        quarter_im = self._imag_at(quarter)
        self._set_bin_at(quarter, quarter_re, -quarter_im)

      self._transform_prefix(half, 1, true)

  # Reusable, non-windowed real transform workspace. It exposes only the
  # non-redundant spectrum and uses one N/2 complex transform in each direction.
  struct RealTransform<T>:
    fft: FFT<T>

    def size(self):
      return N

    def real_bin_count(self):
      return (N >> 1) + 1

    def clear(self):
      self.fft.clear()

    def real(self, i: i32):
      return self.fft.real(i)

    def imag(self, i: i32):
      return self.fft.imag(i)

    def forward(self, input: T[]):
      count = _min_i(input.len(), N)
      half = N >> 1
      for i in 0..half:
        even = i << 1
        odd = even + 1
        even_value: T = 0.0
        odd_value: T = 0.0
        if even < count:
          even_value = input.read_unsafe(even)
        if odd < count:
          odd_value = input.read_unsafe(odd)
        self.fft._set_bin_at(i, even_value, odd_value)
      self.fft._forward_loaded_real()

    def inverse(self, real: T[], imag: T[], output: T[]):
      half = N >> 1
      count = _min_i(_min_i(real.len(), imag.len()), half + 1)
      for i in 0..(half + 1):
        re: T = 0.0
        im: T = 0.0
        if i < count:
          re = real.read_unsafe(i)
          im = imag.read_unsafe(i)
        self.fft._set_bin_at(i, re, im)

      self.fft._inverse_loaded_real()

      output_count = _min_i(output.len(), N)
      for i in 0..half:
        even = i << 1
        odd = even + 1
        if even < output_count:
          output.write_unsafe(even, self.fft._real_at(i))
        if odd < output_count:
          output.write_unsafe(odd, self.fft._imag_at(i))

  struct STFT<T>:
    fft: FFT<T>
    window_kind = _WindowHann

    def size(self):
      return N

    def real_bin_count(self):
      return (N >> 1) + 1

    def _window_value(self, i: i32) -> T:
      if (self.window_kind == _WindowHann):
        return T(Hann[i])
      elif (self.window_kind == _WindowRectangular):
        return T(Rectangular[i])
      elif (self.window_kind == _WindowHamming):
        return T(Hamming[i])
      elif (self.window_kind == _WindowBlackman):
        return T(Blackman[i])
      return T(Hann[i])

    def set_hann(self):
      self.window_kind = _WindowHann

    def set_rectangular(self):
      self.window_kind = _WindowRectangular

    def set_hamming(self):
      self.window_kind = _WindowHamming

    def set_blackman(self):
      self.window_kind = _WindowBlackman

    def window_value(self, i: i32):
      return self._window_value(i)

    def store_window(self, output: T[]):
      count = _min_i(output.len(), N)
      kind = self.window_kind
      if (kind == _WindowHann):
        for i in 0..count:
          output[i] = T(Hann[i])
      elif (kind == _WindowRectangular):
        for i in 0..count:
          output[i] = T(Rectangular[i])
      elif (kind == _WindowHamming):
        for i in 0..count:
          output[i] = T(Hamming[i])
      elif (kind == _WindowBlackman):
        for i in 0..count:
          output[i] = T(Blackman[i])
      else:
        for i in 0..count:
          output[i] = T(Hann[i])

    def clear(self):
      self.fft.clear()

    def real(self, i: i32):
      return self.fft.real(i)

    def imag(self, i: i32):
      return self.fft.imag(i)

    def power(self, i: i32):
      return self.fft.power(i)

    def magnitude(self, i: i32):
      return self.fft.magnitude(i)

    def phase(self, i: i32):
      return self.fft.phase(i)

    def store_real_packed(self, output: T[]):
      self.fft.store_real_packed(output)

    def store_real_spectrum_magnitude(self, output: T[]):
      self.fft.store_real_spectrum_magnitude(output)

    def store_real_spectrum_power(self, output: T[]):
      self.fft.store_real_spectrum_power(output)

    def store_real_spectrum_phase(self, output: T[]):
      self.fft.store_real_spectrum_phase(output)

    def _load_windowed_real(self, input: T[]):
      count = _min_i(input.len(), N)
      kind = self.window_kind
      if (kind == _WindowHann):
        for i in 0..count:
          self.fft.set_bin(i, input[i] * T(Hann[i]), 0.0)
      elif (kind == _WindowRectangular):
        for i in 0..count:
          self.fft.set_bin(i, input[i] * T(Rectangular[i]), 0.0)
      elif (kind == _WindowHamming):
        for i in 0..count:
          self.fft.set_bin(i, input[i] * T(Hamming[i]), 0.0)
      elif (kind == _WindowBlackman):
        for i in 0..count:
          self.fft.set_bin(i, input[i] * T(Blackman[i]), 0.0)
      else:
        for i in 0..count:
          self.fft.set_bin(i, input[i] * T(Hann[i]), 0.0)
      for i in count..N:
        self.fft.set_bin(i, 0.0, 0.0)

    def forward_real(self, input: T[]):
      self._load_windowed_real(input)
      self.fft.forward()

    def forward_real_packed(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_packed(output)

    def forward_real_magnitude(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_magnitude(output)

    def forward_real_power(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_power(output)

    def forward_real_phase(self, input: T[], output: T[]):
      self.forward_real(input)
      self.store_real_spectrum_phase(output)

  struct RealFFT<T>:
    fft: FFT<T>
    input: T[N]
    window_kind = _WindowHann
    write = 0 {N, wrap}
    filled = 0
    since_hop = 0
    ready = false

    def size(self):
      return N

    def real_bin_count(self):
      return (N >> 1) + 1

    def hop_size(self):
      return N >> 1

    def _window_value(self, i: i32) -> T:
      if (self.window_kind == _WindowHann):
        return T(Hann[i])
      return T(Rectangular[i])

    def set_rectangular(self):
      self.window_kind = _WindowRectangular

    def set_hann(self):
      self.window_kind = _WindowHann

    def clear(self):
      self.fft.clear()
      self.write = 0
      self.filled = 0
      self.since_hop = 0
      self.ready = false
      for i in 0..N:
        self.input[i] = 0.0

    def push(self, x: T):
      self.input[self.write] = x
      self.ready = false

      self.write += 1

      if self.filled < N:
        self.filled += 1

      self.since_hop += 1
      if self.filled >= N && self.since_hop >= (N >> 1):
        self.since_hop = 0
        kind = self.window_kind
        half = N >> 1
        if kind == _WindowHann:
          for i in 0..half:
            even = i << 1
            odd = even + 1
            even_idx = _wrap_add(self.write, even, N)
            odd_idx = _wrap_add(self.write, odd, N)
            self.fft.set_bin(
              i,
              self.input[even_idx] * T(Hann[even]),
              self.input[odd_idx] * T(Hann[odd])
            )
        else:
          for i in 0..half:
            even = i << 1
            odd = even + 1
            even_idx = _wrap_add(self.write, even, N)
            odd_idx = _wrap_add(self.write, odd, N)
            self.fft.set_bin(
              i,
              self.input[even_idx] * T(Rectangular[even]),
              self.input[odd_idx] * T(Rectangular[odd])
            )

        # A real N-point transform is reconstructed from one complex N/2-point
        # transform. Only the non-redundant positive spectrum is materialized.
        self.fft._forward_loaded_real()
        self.ready = true
      if self.ready:
        return true
      return false

    def is_ready(self):
      return self.ready

    def real(self, i: i32):
      return self.fft.real(i)

    def imag(self, i: i32):
      return self.fft.imag(i)

    def power(self, i: i32):
      re = self.real(i)
      im = self.imag(i)
      return re * re + im * im

    def magnitude(self, i: i32):
      return sqrt(self.power(i))

    def phase(self, i: i32):
      return atan2(self.imag(i), self.real(i))

    def packed_value(self, i: i32):
      half = N >> 1
      if i <= half:
        return self.real(i)
      return self.imag(i - half)

    def store_real_packed(self, output: T[]):
      count = _min_i(output.len(), N)
      for i in 0..count:
        output[i] = self.packed_value(i)

  struct RealIFFT<T>:
    fft: FFT<T>
    output: T[N]
    norm: T[N]
    window_kind = _WindowHann
    frame = 0 {N, wrap}
    pending = 0
    overlap_frames = 0

    def size(self):
      return N

    def hop_size(self):
      return N >> 1

    def _window_value(self, i: i32) -> T:
      if (self.window_kind == _WindowHann):
        return T(Hann[i])
      return T(Rectangular[i])

    def set_hann(self):
      self.window_kind = _WindowHann

    def set_rectangular(self):
      self.window_kind = _WindowRectangular

    def clear(self):
      self.fft.clear()
      self.frame = 0
      self.pending = 0
      self.overlap_frames = 0
      for i in 0..N:
        self.output[i] = 0.0
        self.norm[i] = 0.0

    def load_packed(self, input: T[]):
      half = N >> 1
      count = _min_i(input.len(), N)
      for k in 0..(half + 1):
        re: T = 0.0
        im: T = 0.0
        if k < count:
          re = input[k]
        if k > 0 && k < half && half + k < count:
          im = input[half + k]
        self.fft.set_bin(k, re, im)
      self._inverse_loaded_real_spectrum()

    def load_complex(self, real: T[], imag: T[]):
      count = _min_i(real.len(), imag.len())
      count = _min_i(count, N)
      half = N >> 1
      for k in 0..(half + 1):
        re: T = 0.0
        im: T = 0.0
        if k < count:
          re = real[k]
          im = imag[k]
        self.fft.set_bin(k, re, im)
      self._inverse_loaded_real_spectrum()

    def _inverse_loaded_real_spectrum(self):
      self.fft._inverse_loaded_real()
      self._accumulate_real_ifft_frame()

    def _accumulate_real_ifft_frame(self):
      half = N >> 1
      kind = self.window_kind
      if kind == _WindowHann:
        for i in 0..half:
          even = i << 1
          odd = even + 1
          even_idx = _wrap_add(self.frame, even, N)
          odd_idx = _wrap_add(self.frame, odd, N)
          even_w = T(Hann[even])
          odd_w = T(Hann[odd])
          self.output[even_idx] = self.output[even_idx] + self.fft.real(i) * even_w
          self.output[odd_idx] = self.output[odd_idx] + self.fft.imag(i) * odd_w
          self.norm[even_idx] = self.norm[even_idx] + even_w * even_w
          self.norm[odd_idx] = self.norm[odd_idx] + odd_w * odd_w
      else:
        for i in 0..half:
          even = i << 1
          odd = even + 1
          even_idx = _wrap_add(self.frame, even, N)
          odd_idx = _wrap_add(self.frame, odd, N)
          even_w = T(Rectangular[even])
          odd_w = T(Rectangular[odd])
          self.output[even_idx] = self.output[even_idx] + self.fft.real(i) * even_w
          self.output[odd_idx] = self.output[odd_idx] + self.fft.imag(i) * odd_w
          self.norm[even_idx] = self.norm[even_idx] + even_w * even_w
          self.norm[odd_idx] = self.norm[odd_idx] + odd_w * odd_w
      if kind == _WindowHann && self.overlap_frames < 2:
        self.overlap_frames += 1
      else:
        self.overlap_frames = 2
      self.pending = N

    def tick(self):
      if self.pending <= 0:
        return T(0.0)

      y = self.output[self.frame]
      denom = self.norm[self.frame]
      if self.overlap_frames < 2:
        y = 0.0
      elif denom > 0.0:
        y = y / denom

      self.output[self.frame] = 0.0
      self.norm[self.frame] = 0.0
      self.frame += 1
      self.pending -= 1
      if self.pending <= 0:
        self.overlap_frames = 0
      return y

    def is_active(self):
      return self.pending > 0
