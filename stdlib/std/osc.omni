namespace std::osc:
  proc Phasor<T>:
    outs<T> 1

    params<T>:
      freq = 1.0

    init<T>:
      phase = 0.0

    block:
      incr: T = freq / T(SR)
      sample:
        phase = phase + incr
        if (phase >= T(1.0)):
          phase = phase - T(1.0)
        out1 = phase
        
  proc Sine<T>:
    outs<T> 1

    params<T>:
      freq = 440.0

    init:
      phasor = Phasor(freq = freq)

    block:
      phasor.freq = freq
      sample:
        out1 = sin(phasor() * T(TWO_PI))
  
  def poly_blep(t, dt):
    zero = dt - dt
    if dt <= zero:
      return zero
    one = dt / dt
    if t < dt:
      x = t / dt
      return x + x - x * x - one
    elif t > one - dt:
      x = (t - one) / dt
      return x * x + x + x + one
    return zero

  proc Saw<T>:
    outs<T> 1

    params<T>:
      freq = 440.0

    init:
      phasor = Phasor(freq = freq)

    block:
      phasor.freq = freq
      dt: T = freq / T(SR)
      sample:
        phase = phasor()
        base = phase + phase - T(1.0)
        out1 = base - std::osc::poly_blep(phase, dt)
