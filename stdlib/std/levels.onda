namespace std::levels:
  const HALF_PI: f64 = PI / 2.0
  const DB_PER_NAT: f64 = 8.685889638065037
  const MIN_FLOAT: f64 = 0.00000000000000000001

  def db_to_gain<T>(x: T):
    # ln(10) / 20; contextual typing also promotes integer inputs to floats.
    return exp(x * 0.11512925464970229)

  def gain_to_db<T>(x: T):
    safe = max(x, T(MIN_FLOAT))
    return log(safe) * T(DB_PER_NAT)

  def _pan_position(x):
    return clamp((x + 1.0) * 0.5, 0.0, 1.0)

  def pan_linear<T>(x: T):
    t = _pan_position(x)
    return (1.0 - t, t)

  def pan_3db<T>(x: T):
    t = _pan_position(x)
    angle = t * (PI / 2.0)
    return (cos(angle), sin(angle))

  # Equal-power mono-to-stereo panning. Positions use pan_3db's clamp to
  # [-1, 1]; gains are recomputed only when the position changes.
  proc Pan3db<T>:
    ins<T> 1
    outs<T> 2

    params<T>:
      pan = 0.0 => update_pan

    init:
      gain_l: T = 0.0
      gain_r: T = 0.0
      coefficient_pan: T = 0.0
      coefficient_valid = false

    def update_pan():
      if !coefficient_valid || pan != coefficient_pan:
        gain_l, gain_r = std::levels::pan_3db(pan)
        coefficient_pan = pan
        coefficient_valid = true

    sample:
      out1 = in1 * gain_l
      out2 = in1 * gain_r
