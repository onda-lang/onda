# Tools for smoothing changing signals and controlling how values move over time.
# Lag covers about 63.2% of a step in lag_s. Slew limits the rate of change per second.
# A ramp reaches its target after ceil(duration_s * SR) samples and captures its
# shape at each target change. For Exponential, a negative curve moves early,
# a positive curve moves late, and zero is linear.

namespace std::smoothing:
  enum RampShape:
    Linear
    SCurve { label = "S-curve" }
    Exponential

  # A lag covers 1 - exp(-1), approximately 63.2%, of a step in lag_s.
  def lag_coefficient<T>(lag_s: T) -> f64:
    if lag_s <= 0.0 || lag_s - lag_s != 0.0:
      return 0.0
    return exp((-1.0 / SR) / f64(lag_s))

  # The closest representable pole below unity still decays.
  def _decay_pole(pole: f32) -> f32:
    return min(pole, 1.0 - 1.0 / 16777216.0)

  def _decay_pole(pole: f64) -> f64:
    return min(pole, 1.0 - 1.0 / 9007199254740992.0)

  def _decay_60db_coefficient<T>(duration_s: T, span_samples: f64) -> T:
    if duration_s > 0.0 && duration_s - duration_s == 0.0:
      pole = exp(log(f64(0.001)) * span_samples / (f64(duration_s) * SR))
      return _decay_pole(T(pole))
    return 0.0

  def _lag_weights<T>(lag_s: T) -> (T, T):
    retained = T(lag_coefficient(lag_s))
    return (retained, 1.0 - retained)

  def _lag_update<T>(previous: T, target: T, retained: T, incoming: T) -> T:
    # Weight the endpoints independently so their difference cannot overflow.
    return previous * retained + target * incoming

  # Finite transitions share sample rounding and exact endpoint handling.
  def _duration_samples<T>(duration_s: T) -> i64:
    if duration_s > 0.0 && duration_s - duration_s == 0.0:
      return max(i64(ceil(duration_s * SR)), 1)
    return 0

  # exp(x) - 1 without cancellation for small per-sample increments.
  def _expm1(x: f64):
    if abs(x) < 0.00001:
      return x * (1.0 + x * 0.5)
    return exp(x) - 1.0

  def _blend_at<T>(origin: T, target: T, toward: T) -> T:
    if toward <= 0.0:
      return origin
    if toward >= 1.0:
      return target
    return _interpolate(origin, target, toward)

  # Interpolate from the nearer endpoint. Opposite signs use a weighted
  # sum so the distance between two finite endpoints cannot overflow.
  def _interpolate<T>(a: T, b: T, toward: T) -> T:
    if (a < 0.0) != (b < 0.0):
      return a * (1.0 - toward) + b * toward
    if toward <= 0.5:
      return a + (b - a) * toward
    return b + (a - b) * (1.0 - toward)

  enum _TransitionCurve:
    Linear
    LinearSlope
    SCurve
    Exponential

  # Prepared from controls and copied into the transition when a target changes.
  struct _TransitionPlan<T>:
    samples: i64 = 0
    inverse: T = 0.0
    mode: _TransitionCurve = _TransitionCurve::Linear
    curve_step: T = 0.0
    curve_bias: T = 0.0

    def configure(self, samples: i64, shape: RampShape = RampShape::Linear, bend: f64 = 0.0):
      self.samples = samples
      self.inverse = 1.0 / T(max(samples, 1))
      self.mode = _TransitionCurve::Linear
      if shape == RampShape::SCurve:
        self.mode = _TransitionCurve::SCurve
      elif shape == RampShape::Exponential && samples > 0 && abs(bend) > 0.00000001:
        self.mode = _TransitionCurve::Exponential
        self.curve_step = T(_expm1(bend / f64(samples)))
        self.curve_bias = T(1.0 / _expm1(bend))

  enum _TransitionPolicy:
    LinearOnly
    Shaped
    ShapedWithSlope

  namespace _Transition<Policy = i32(_TransitionPolicy::Shaped)>:
    const _UseCurves = Policy != i32(_TransitionPolicy::LinearOnly)
    const _UseSlope = Policy == i32(_TransitionPolicy::ShapedWithSlope)

    # A fixed-duration move. Callers decide when to start the next move.
    struct State<T>:
      value: T = 0.0
      target: T = 0.0
      origin: T = 0.0
      samples: i64 = 0
      remaining: i64 = 0
      inverse: T = 0.0
      mode: _TransitionCurve = _TransitionCurve::Linear
      # Normalized progress for the exponential curve.
      progress: T = 0.0
      curve_step: T = 0.0
      curve_bias: T = 0.0

      def reset(self, value: T):
        self.value = value
        self.target = value
        self.remaining = 0

      # Commit the new value on the next advance, keeping the current sample intact.
      def set_next(self, value: T):
        self.target = value
        self.remaining = 1

      def begin(self, target: T, samples: i64, shape: RampShape, bend: f64):
        plan: _TransitionPlan<T>
        plan.configure(samples, shape, bend)
        self.start(target, plan)

      def start(self, target: T, plan: _TransitionPlan<T>):
        if plan.samples == 0 || target - target != 0.0 || self.value - self.value != 0.0:
          self.reset(target)
          return
        self.origin = self.value
        self.target = target
        self.samples = plan.samples
        self.remaining = plan.samples
        self.inverse = plan.inverse
        if _UseCurves:
          self.mode = plan.mode
          if plan.mode == _TransitionCurve::Exponential:
            self.progress = 0.0
            self.curve_step = plan.curve_step
            self.curve_bias = plan.curve_bias
          elif _UseSlope && plan.mode == _TransitionCurve::Linear:
            # Use the slope only when it can recover the endpoint in this precision.
            step = (target - self.origin) * plan.inverse
            if self.origin + step * T(plan.samples) == target:
              self.mode = _TransitionCurve::LinearSlope
              self.curve_step = step

      def complete(self):
        return self.remaining == 0

      # True on the sample that reaches the endpoint.
      def advance(self) -> bool:
        if self.remaining <= 0:
          return false
        self.remaining -= 1
        if self.remaining == 0:
          self.value = self.target
          return true

        if _UseSlope && self.mode == _TransitionCurve::LinearSlope:
          self.value = self.origin + T(self.samples - self.remaining) * self.curve_step
          return false

        phase = T(self.samples - self.remaining) * self.inverse
        if _UseCurves:
          if self.mode == _TransitionCurve::SCurve:
            if phase <= 0.5:
              phase = phase * phase * (3.0 - 2.0 * phase)
            else:
              tail = T(self.remaining) * self.inverse
              phase = 1.0 - tail * tail * (3.0 - 2.0 * tail)
          elif self.mode == _TransitionCurve::Exponential:
            # The normalized exponential advances by expm1(bend / samples)
            # times its value plus a constant.
            self.progress += self.curve_step * (self.progress + self.curve_bias)
            phase = min(self.progress, 1.0)
        self.value = _interpolate(self.origin, self.target, phase)
        return false

  namespace _LinearTransition = _Transition<i32(_TransitionPolicy::LinearOnly)>
  namespace _ShapedTransition = _Transition<i32(_TransitionPolicy::Shaped)>
  namespace _EnvelopeTransition = _Transition<i32(_TransitionPolicy::ShapedWithSlope)>

  proc Lag<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      lag_s = 0.05 => update_lag

    init:
      y: T = 0.0
      retained: T = 0.0
      incoming: T = 1.0

    def update_lag():
      retained, incoming = _lag_weights(lag_s)

    event reset(value: T = 0.0):
      y = value

    sample:
      y = _lag_update(y, in1, retained, incoming)
      out1 = y

  proc LagUD<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      rise_lag_s = 0.01 => update_rise
      fall_lag_s = 0.1 => update_fall

    init:
      y: T = 0.0
      rise_retained: T = 0.0
      rise_incoming: T = 1.0
      fall_retained: T = 0.0
      fall_incoming: T = 1.0

    def update_rise():
      rise_retained, rise_incoming = _lag_weights(rise_lag_s)

    def update_fall():
      fall_retained, fall_incoming = _lag_weights(fall_lag_s)

    event reset(value: T = 0.0):
      y = value

    sample:
      if (in1 > y):
        y = _lag_update(y, in1, rise_retained, rise_incoming)
      else:
        y = _lag_update(y, in1, fall_retained, fall_incoming)
      out1 = y

  proc Slew<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      rise_per_s = 1.0 => update_rise
      fall_per_s = 1.0 => update_fall

    init<T>:
      y = 0.0
      rise_step = 0.0
      fall_step = 0.0

    def update_rise():
      rise_step = max(rise_per_s, 0.0) / SR

    def update_fall():
      fall_step = max(fall_per_s, 0.0) / SR

    event reset(value: T = 0.0):
      y = value

    sample:
      delta = in1 - y
      if delta > rise_step:
        y += rise_step
      elif delta < -fall_step:
        y -= fall_step
      else:
        y = in1
      out1 = y

  # Duration, shape, and curve are captured on each new target.
  proc Ramp<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      duration_s = 0.05 => update_plan
      shape: RampShape = RampShape::Linear => update_plan
      curve = -4.0 {-60.0, 60.0} => update_plan

    init:
      transition: _ShapedTransition::State<T>
      plan: _TransitionPlan<T>
      planned_duration: T = 0.0
      planned_shape = RampShape::Linear
      planned_curve: T = 0.0

    def update_plan():
      if duration_s != planned_duration || shape != planned_shape || curve != planned_curve:
        plan.configure(_duration_samples(duration_s), shape, curve)
        planned_duration = duration_s
        planned_shape = shape
        planned_curve = curve

    event reset(value: T = 0.0):
      transition.reset(value)

    sample:
      if in1 != transition.target:
        transition.start(in1, plan)
      transition.advance()
      out1 = transition.value

  # Input attributes fix both the shape and duration at construction.
  proc _LinearRamp<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      private duration_s = 0.05

    init:
      transition: _LinearTransition::State<T>
      plan: _TransitionPlan<T>
      plan.configure(_duration_samples(duration_s))

    event reset(value: T = 0.0):
      transition.reset(value)

    sample:
      if in1 != transition.target:
        transition.start(in1, plan)
      transition.advance()
      out1 = transition.value
