# This module can be used for common math operations when targeting platforms that do not have LLVM-native support for them, like WebAssembly.

import std/math

namespace std::export_math:
  const HALF_PI: f64 = PI / 2.0
  const QUARTER_PI: f64 = PI / 4.0
  const LN2: f64 = 0.69314718055994530942
  const INV_LN2: f64 = 1.44269504088896340736
  const EPS: f64 = 0.000001
  const ATAN_A: f64 = 0.2447
  const ATAN_B: f64 = 0.0663

  def _wrap_pm_pi<T>(x: T):
    return std::math::wrap(x + T(PI), T(0), T(TWO_PI)) - T(PI)

  def _pow2i<T>(n: i32):
    result = T(1)
    i: i32 = 0
    if (n >= 0):
      while (i < n):
        result = result + result
        i = i + 1
      return result

    while (i < -n):
      result = result * 0.5
      i = i + 1
    return result

  def _nearest_i32<T>(x: T):
    value: i32 = 0
    if (x >= 0):
      value = i32(floor(x + 0.5))
    else:
      value = i32(-floor(-x + 0.5))
    return value

  def sin<T>(x: T):
    y = _wrap_pm_pi(x)
    base = 1.2732395447351627 * y + (-0.4052847345693511) * y * abs(y)
    return 0.225 * (base * abs(base) - base) + base

  def cos<T>(x: T):
    return sin(x + T(HALF_PI))

  def tan<T>(x: T):
    s = sin(x)
    c = cos(x)
    eps = T(EPS) * 64

    if (abs(c) <= eps):
      huge = T(1) / eps
      if (s >= 0):
        return huge
      return -huge

    return s / c

  def tanh<T>(x: T):
    if (x > 3):
      return T(1)
    elif (x < -3):
      return T(-1)

    x2 = x * x
    return x * (27 + x2) / (27 + 9 * x2)

  def atan<T>(x: T):
    ax = abs(x)

    if (ax > 1):
      t = T(1) / ax
      base = T(QUARTER_PI) * t - t * (abs(t) - 1) * (T(ATAN_A) + T(ATAN_B) * abs(t))
      if (x >= 0):
        return T(HALF_PI) - base
      return base - T(HALF_PI)

    return T(QUARTER_PI) * x - x * (ax - 1) * (T(ATAN_A) + T(ATAN_B) * ax)

  def atan2<T>(y: T, x: T):
    if (x > 0):
      return atan(y / x)
    elif (x < 0):
      if (y >= 0):
        return atan(y / x) + T(PI)
      return atan(y / x) - T(PI)
    elif (y > 0):
      return T(HALF_PI)
    elif (y < 0):
      return T(-HALF_PI)
    return T(0)

  def exp<T>(x: T):
    clamped = x

    if (clamped > 88):
      clamped = T(88)
    elif (clamped < -88):
      return T(0)

    k: i32 = _nearest_i32(clamped * T(INV_LN2))
    r = clamped - T(k) * T(LN2)
    poly = 1 + r * (1 + r * (0.5 + r * (0.16666666666666666 + r * (0.041666666666666664 + r * (0.008333333333333333 + r * 0.001388888888888889)))))
    return poly * _pow2i<T>(k)

  def log<T>(x: T):
    if (x <= 0):
      return T(0)

    m = x
    k: i32 = 0
    while (m > 1.5):
      m = m * 0.5
      k = k + 1
    while (m < 0.75):
      m = m + m
      k = k - 1

    z = (m - 1) / (m + 1)
    z2 = z * z
    series = z * (2 + z2 * (0.6666666666666666 + z2 * (0.4 + z2 * (0.2857142857142857 + z2 * 0.2222222222222222))))
    return T(k) * T(LN2) + series

  def pow<T>(x: T, y: T):
    if (y == 0):
      return T(1)
    elif (x == 0):
      if (y > 0):
        return T(0)
      return T(1)
    elif (x > 0):
      return exp(y * log(x))

    yi: i32 = _nearest_i32(y)
    if (abs(y - T(yi)) > T(EPS)):
      return T(0)

    mag = exp(T(yi) * log(-x))
    if ((yi % 2) == 0):
      return mag
    return -mag
