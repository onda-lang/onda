import std/complex
import std/fft

namespace std::convolution<FFTSize = 256, MaxImpulseLen = 16384>:
  assert(FFTSize > 0 && (FFTSize & (FFTSize - 1)) == 0)
  assert((FFTSize & 1) == 0)
  assert(MaxImpulseLen > 0)

  const HopSize = FFTSize / 2
  const MaxPartitions = (MaxImpulseLen + HopSize - 1) / HopSize
  const FFTStorageSize = MaxPartitions * FFTSize
  const TailStart = HopSize

  proc TimeDomainConvolver<T>:
    ins<T> 1
    outs<T> 1

    init:
      impulse: T[MaxImpulseLen]
      delay: T[MaxImpulseLen]
      active_taps: i32 = 0
      write: i32 = 0

    def clear_state():
      delay[:] = 0.0
      write = 0

    events:
      set_impulse(values: T[]):
        values_len = values.len()
        active_taps = values_len
        if (active_taps < 0):
          active_taps = 0
        if (active_taps > MaxImpulseLen):
          active_taps = MaxImpulseLen

        impulse[:] = 0.0
        impulse[:] = values[:MaxImpulseLen]

        clear_state()

      reset():
        clear_state()
        active_taps = 0

    sample:
      if (active_taps <= 0):
        out1 = 0.0
      else:
        delay[write] = in1

        y: T = 0.0
        read = write
        for i in 0..active_taps:
          y = y + delay[read] * impulse[i]
          read = read - 1
          if (read < 0):
            read = active_taps - 1

        write = write + 1
        if (write >= active_taps):
          write = 0

        out1 = y

  proc BlockConvolver<T>:
    ins<T> 1
    outs<T> 1

    init:
      fwd = std::fft<FFTSize>::FFT<T>()
      inv = std::fft<FFTSize>::FFT<T>()

      pending: T[HopSize]
      output: T[HopSize]
      overlap: T[HopSize]
      block_time: T[FFTSize]
      time_domain: T[FFTSize]

      spectrum: std::complex::Complex<T>[FFTSize]
      impulse_fft: std::complex::Complex<T>[FFTStorageSize]
      input_fft: std::complex::Complex<T>[FFTStorageSize]

      active_taps = 0
      active_partitions = 0
      pending_count = 0
      output_idx = HopSize
      current_partition = 0

    def clear_buffers():
      pending[:] = 0.0
      output[:] = 0.0
      overlap[:] = 0.0

      block_time[:] = 0.0
      time_domain[:] = 0.0
      for i in 0..FFTSize:
        spectrum[i].clear()
      for i in 0..FFTStorageSize:
        impulse_fft[i].clear()
        input_fft[i].clear()

    def reset_counters():
      pending_count = 0
      output_idx = HopSize
      current_partition = 0
  
    def ceil_div_i(n: i32, d: i32):
      if (n <= 0):
        return 0
      return (n + d - 1) / d
  
    def wrap_sub_i(base: i32, offset: i32, n: i32):
      idx = base - offset
      if (idx < 0):
        idx = idx + n
      return idx
  
    def partition_slot(part: i32, bin: i32):
      return part * FFTSize + bin

    events:
      set_impulse(values: T[]):
        active_taps = values.len()
        if (active_taps < 0):
          active_taps = 0
        if (active_taps > MaxImpulseLen):
          active_taps = MaxImpulseLen
        active_partitions = ceil_div_i(active_taps, HopSize)

        clear_buffers()
        reset_counters()

        for part in 0..active_partitions:
          start = part * HopSize
          block_time[:HopSize] = 0.0
          block_time[:HopSize] = values[start:start + HopSize]

          fwd.forward_real(block_time)

          for i in 0..FFTSize:
            slot = partition_slot(part, i)
            impulse_fft[slot].set(fwd.real(i), fwd.imag(i))

      reset():
        active_taps = 0
        active_partitions = 0
        clear_buffers()
        reset_counters()

    sample:
      y: T = 0.0
      if (output_idx < HopSize):
        y = output[output_idx]
        output_idx = output_idx + 1
      out1 = y

      pending[pending_count] = in1
      pending_count = pending_count + 1

      if (pending_count >= HopSize):
        # The upper half stays zero between blocks; only refresh the live input half.
        for i in 0..HopSize:
          block_time[i] = pending[i]

        fwd.forward_real(block_time)

        for i in 0..FFTSize:
          slot = partition_slot(current_partition, i)
          input_fft[slot].set(fwd.real(i), fwd.imag(i))
          spectrum[i].clear()

        for part in 0..active_partitions:
          data_part = wrap_sub_i(current_partition, part, MaxPartitions)
          for i in 0..FFTSize:
            data_slot = partition_slot(data_part, i)
            impulse_slot = partition_slot(part, i)
            xr = input_fft[data_slot].real()
            xi = input_fft[data_slot].imag()
            hr = impulse_fft[impulse_slot].real()
            hi = impulse_fft[impulse_slot].imag()
            spectrum[i].add_parts(xr * hr - xi * hi, xr * hi + xi * hr)

        for i in 0..FFTSize:
          inv.set_bin(i, spectrum[i].real(), spectrum[i].imag())
        inv.inverse()
        inv.store_real(time_domain)

        for i in 0..HopSize:
          output[i] = time_domain[i] + overlap[i]
          overlap[i] = time_domain[HopSize + i]
          pending[i] = 0.0

        pending_count = 0
        output_idx = 0
        current_partition = current_partition + 1
        if (current_partition >= MaxPartitions):
          current_partition = 0

  proc ZeroLatencyConvolver<T>:
    ins<T> 1
    outs<T> 1

    init:
      td = TimeDomainConvolver<T>()
      tail = BlockConvolver<T>()

    events:
      set_impulse(values: T[]):
        td.set_impulse(values[:HopSize])
        tail.set_impulse(values[TailStart:])

      reset():
        td.reset()
        tail.reset()

    sample:
      early = td(in1)
      late = tail(in1)
      out1 = early + late
