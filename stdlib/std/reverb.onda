namespace std::reverb:
  namespace Schroeder<CombCapacity = 8192, AllpassCapacity = 4096>:
    assert(CombCapacity > 1)
    assert(AllpassCapacity > 1)

    const CombLines = 8
    const AllpassLines = 4
    const ReferenceRate = 48000
    const CombTuning: i32[CombLines] = [1116, 1188, 1277, 1356, 1139, 1211, 1300, 1379]
    const AllpassTuning: i32[AllpassLines] = [556, 441, 579, 464]

    proc Reverb<T>:
      ins<T> 2
      outs<T> 2

      params<T>:
        room_size = 0.82 {0.0, 1.0}
        damping = 0.34 {0.0, 0.98}
        width = 0.92 {0.0, 1.0}
        mix = 1.0 {0.0, 1.0}

      init:
        comb_buffer: T[CombLines * CombCapacity]
        comb_length: i32[CombLines]
        comb_index: i32[CombLines]
        comb_lowpass: T[CombLines]

        for i in 0..CombLines:
          comb_length[i] = min(max(i32(T(CombTuning[i]) * SR / T(ReferenceRate)), 1), CombCapacity - 1)

        allpass_buffer: T[AllpassLines * AllpassCapacity]
        allpass_length: i32[AllpassLines]
        allpass_index: i32[AllpassLines]

        for i in 0..AllpassLines:
          allpass_length[i] = min(max(i32(T(AllpassTuning[i]) * SR / T(ReferenceRate)), 1), AllpassCapacity - 1)

      block:
        feedback = T(0.70) + room_size * T(0.28)

        sample:
          excitation = (in1 + in2) * T(0.015)
          comb_l: T = 0.0
          comb_r: T = 0.0

          for i in 0..CombLines:
            base = i * CombCapacity
            read_index = comb_index[i] - comb_length[i]
            if read_index < 0:
              read_index += CombCapacity

            delayed = comb_buffer[base + read_index]
            comb_lowpass[i] = delayed * (T(1.0) - damping) + comb_lowpass[i] * damping
            comb_buffer[base + comb_index[i]] = excitation + comb_lowpass[i] * feedback
            next_index = comb_index[i] + 1
            if next_index >= CombCapacity:
              next_index = 0
            comb_index[i] = next_index

            if i < CombLines / 2:
              comb_l += delayed
            else:
              comb_r += delayed

          comb_norm = T(2.0) / T(CombLines)
          diffuse_l = comb_l * comb_norm
          diffuse_r = comb_r * comb_norm
          for i in 0..AllpassLines:
            base = i * AllpassCapacity
            read_index = allpass_index[i] - allpass_length[i]
            if read_index < 0:
              read_index += AllpassCapacity

            delayed = allpass_buffer[base + read_index]
            if i < AllpassLines / 2:
              allpass_buffer[base + allpass_index[i]] = diffuse_l + delayed * T(0.5)
              diffuse_l = delayed - diffuse_l * T(0.5)
            else:
              allpass_buffer[base + allpass_index[i]] = diffuse_r + delayed * T(0.5)
              diffuse_r = delayed - diffuse_r * T(0.5)
            next_index = allpass_index[i] + 1
            if next_index >= AllpassCapacity:
              next_index = 0
            allpass_index[i] = next_index

          width_main = T(0.5) + width * T(0.5)
          width_cross = T(0.5) - width * T(0.5)
          wet_l = diffuse_l * width_main + diffuse_r * width_cross
          wet_r = diffuse_r * width_main + diffuse_l * width_cross
          out1 = in1 * (T(1.0) - mix) + wet_l * mix
          out2 = in2 * (T(1.0) - mix) + wet_r * mix
