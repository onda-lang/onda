namespace std::reverb:
  namespace Schroeder<CombCapacity = 8192, AllpassCapacity = 4096>:
    assert(CombCapacity > 1)
    assert(AllpassCapacity > 1)

    const CombLines = 8
    const AllpassLines = 4
    const ReferenceRate = 48000
    const CombTuning: i32[CombLines] = [1116, 1188, 1277, 1356, 1139, 1211, 1300, 1379]
    const AllpassTuning: i32[AllpassLines] = [556, 441, 579, 464]

    struct CombLine<T>:
      buffer: T[CombCapacity]
      length: i32
      index: i32 {CombCapacity, wrap}
      lowpass: T

    struct AllpassLine<T>:
      buffer: T[AllpassCapacity]
      length: i32
      index: i32 {AllpassCapacity, wrap}

      def process(self, input: T):
        read_index = self.index - self.length
        if read_index < 0:
          read_index += AllpassCapacity
        delayed = self.buffer[read_index]
        stored = input + delayed * T(0.5)
        self.buffer[self.index] = stored
        self.index += 1
        return delayed - stored * T(0.5)

    proc Reverb<T>:
      ins<T> 2
      outs<T> 2

      params<T>:
        room_size = 0.82 {0.0, 1.0}
        damping = 0.34 {0.0, 0.98}
        width = 0.92 {0.0, 1.0}
        mix = 1.0 {0.0, 1.0}

      init:
        comb: CombLine<T>[CombLines]
        for i in 0..CombLines:
          line = comb[i]
          line.length = min(max(i32(T(CombTuning[i]) * SR / T(ReferenceRate)), 1), CombCapacity - 1)

        allpass: AllpassLine<T>[AllpassLines]
        for i in 0..AllpassLines:
          line = allpass[i]
          line.length = min(max(i32(T(AllpassTuning[i]) * SR / T(ReferenceRate)), 1), AllpassCapacity - 1)

      block:
        feedback = T(0.70) + room_size * T(0.28)
        # Normalize the energy of parallel, undamped combs, including feedback.
        # Damping still removes high-frequency energy from the tail.
        comb_norm = sqrt((T(1.0) - feedback * feedback) * T(2.0) / T(CombLines))

        sample:
          excitation = (in1 + in2) * T(0.5)
          comb_l: T = 0.0
          comb_r: T = 0.0

          for i in 0..CombLines:
            line = comb[i]
            read_index = line.index - line.length
            if read_index < 0:
              read_index += CombCapacity

            delayed = line.buffer[read_index]
            line.lowpass = delayed * (T(1.0) - damping) + line.lowpass * damping
            line.buffer[line.index] = excitation + line.lowpass * feedback
            line.index += 1

            if i < CombLines / 2:
              comb_l += delayed
            else:
              comb_r += delayed

          diffuse_l = comb_l * comb_norm
          diffuse_r = comb_r * comb_norm
          for i in 0..AllpassLines:
            line = allpass[i]
            if i < AllpassLines / 2:
              diffuse_l = line.process(diffuse_l)
            else:
              diffuse_r = line.process(diffuse_r)

          width_main = T(0.5) + width * T(0.5)
          width_cross = T(0.5) - width * T(0.5)
          wet_l = diffuse_l * width_main + diffuse_r * width_cross
          wet_r = diffuse_r * width_main + diffuse_l * width_cross
          out1 = in1 * (T(1.0) - mix) + wet_l * mix
          out2 = in2 * (T(1.0) - mix) + wet_r * mix
