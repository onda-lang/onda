# Artificial reverberation for adding space and a decaying tail to audio.
# Combines delayed reflections and diffusion with controls for decay and stereo character.

import std/delay

namespace std::reverb:
  namespace Schroeder<CombCapacity = 8192, AllpassCapacity = 4096>:
    assert(CombCapacity > 1)
    assert(AllpassCapacity > 1)

    const _CombLines = 8
    const _AllpassLines = 4
    const _ReferenceRate = 48000
    const _CombTuning: i32[_CombLines] = [1116, 1188, 1277, 1356, 1139, 1211, 1300, 1379]
    const _AllpassTuning: i32[_AllpassLines] = [556, 441, 579, 464]

    namespace _Diffusion = std::delay<AllpassCapacity>
    namespace _CombDelay = std::delay<CombCapacity>

    struct _CombLine<T>:
      delay: _CombDelay::Line<T>
      length: i32
      lowpass: T
      feedback: T
      normalization: T

    proc Reverb<T>:
      ins<T> 2
      outs<T> 2

      params<T>:
        decay_60db_s = 2.5 {0.0, 60.0, unit = "s"} => update_decay
        damping = 0.34 {0.0, 0.98}
        width = 0.92 {0.0, 1.0}
        mix = 1.0 {0.0, 1.0}

      init:
        comb: _CombLine<T>[_CombLines]
        for i in 0.._CombLines:
          line = comb[i]
          line.length = min(max(i32(T(_CombTuning[i]) * SR / _ReferenceRate), 1), CombCapacity - 1)

        allpass: _Diffusion::Allpass<T>[_AllpassLines] = _Diffusion::Allpass<T>()
        for i in 0.._AllpassLines:
          allpass[i].delay_samples = i32(T(_AllpassTuning[i]) * SR / _ReferenceRate)

        coefficient_decay_s: T = 0.0
        compute_decay()

      def update_decay():
        if decay_60db_s != coefficient_decay_s:
          compute_decay()

      def compute_decay():
        # Each undamped comb loses 60 dB over the requested time, regardless of length.
        # Damping shortens the high-frequency tail; this is the nominal low-frequency decay.
        for i in 0.._CombLines:
          line = comb[i]
          line.feedback = 0.0
          if decay_60db_s > 0.0 && decay_60db_s - decay_60db_s == 0.0:
            line.feedback = exp(log(T(0.001)) * line.length / (decay_60db_s * SR))
          line.normalization = sqrt((1.0 - line.feedback * line.feedback) * 2.0 / _CombLines)
        coefficient_decay_s = decay_60db_s

      sample:
        excitation = (in1 + in2) * 0.5
        comb_l: T = 0.0
        comb_r: T = 0.0

        for i in 0.._CombLines:
          line = comb[i]
          delayed = line.delay.read(line.length)
          line.lowpass = delayed * (1.0 - damping) + line.lowpass * damping
          line.delay.write(excitation + line.lowpass * line.feedback)
          line.delay.advance()

          if i < _CombLines / 2:
            comb_l += delayed * line.normalization
          else:
            comb_r += delayed * line.normalization

        diffuse_l = comb_l
        diffuse_r = comb_r
        for i in 0.._AllpassLines:
          line = allpass[i]
          if i < _AllpassLines / 2:
            diffuse_l = line(diffuse_l)
          else:
            diffuse_r = line(diffuse_r)

        width_main = 0.5 + width * 0.5
        width_cross = 0.5 - width * 0.5
        wet_l = diffuse_l * width_main + diffuse_r * width_cross
        wet_r = diffuse_r * width_main + diffuse_l * width_cross
        out1 = in1 * (1.0 - mix) + wet_l * mix
        out2 = in2 * (1.0 - mix) + wet_r * mix
