namespace std::math:
  def clamp(x, lo, hi):
    if (x < lo):
      return lo
    if (x > hi):
      return hi
    return x

  def lerp(a, b, t):
    return a + (b - a) * t

  def inverse_lerp(a, b, x):
    if (a == b):
      return 0.0
    return (x - a) / (b - a)

  def map(in_lo, in_hi, out_lo, out_hi, x):
    t = inverse_lerp(in_lo, in_hi, x)
    return lerp(out_lo, out_hi, t)

  def sign(x):
    if (x > 0):
      return x / abs(x)
    if (x < 0):
      return x / abs(x)
    return x - x

  def fract(x):
    return x - floor(x)

  def wrap(x, lo, hi):
    span = hi - lo
    if (span == 0):
      return lo
    return x - span * floor((x - lo) / span)

  def cubic_interp(y0, y1, y2, y3, t):
    a0 = -0.5 * y0 + 1.5 * y1 - 1.5 * y2 + 0.5 * y3
    a1 = y0 - 2.5 * y1 + 2.0 * y2 - 0.5 * y3
    a2 = -0.5 * y0 + 0.5 * y2
    a3 = y1
    return ((a0 * t + a1) * t + a2) * t + a3

  def smoothstep(edge0, edge1, x):
    if (edge0 == edge1):
      return 0.0
    t = clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)

def clamp(x, lo, hi):
  return std::math::clamp(x, lo, hi)

def lerp(a, b, t):
  return std::math::lerp(a, b, t)

def inverse_lerp(a, b, x):
  return std::math::inverse_lerp(a, b, x)

def map(in_lo, in_hi, out_lo, out_hi, x):
  return std::math::map(in_lo, in_hi, out_lo, out_hi, x)

def sign(x):
  return std::math::sign(x)

def fract(x):
  return std::math::fract(x)

def wrap(x, lo, hi):
  return std::math::wrap(x, lo, hi)

def cubic_interp(y0, y1, y2, y3, t):
  return std::math::cubic_interp(y0, y1, y2, y3, t)

def smoothstep(edge0, edge1, x):
  return std::math::smoothstep(edge0, edge1, x)
