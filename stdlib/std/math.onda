namespace std::math:
  def clamp<T>(x: T, lo: T, hi: T) -> T:
    if (x < lo):
      return lo
    if (x > hi):
      return hi
    return x

  def lerp<T>(a: T, b: T, t: T) -> T:
    return a + (b - a) * t

  def inverse_lerp(a, b, x):
    if (a == b):
      return 0.0
    return (x - a) / (b - a)

  def map(in_lo, in_hi, out_lo, out_hi, x):
    t = inverse_lerp(in_lo, in_hi, x)
    return lerp(out_lo, out_hi, t)

  def sign(x):
    if (x > 0):
      return x / abs(x)
    if (x < 0):
      return x / abs(x)
    return x - x

  def fract(x):
    return x - floor(x)

  def wrap(x, lo, hi):
    span = hi - lo
    if (span == 0):
      return lo
    return x - span * floor((x - lo) / span)

  def cubic_interp(y0, y1, y2, y3, t):
    a0 = -0.5 * y0 + 1.5 * y1 - 1.5 * y2 + 0.5 * y3
    a1 = y0 - 2.5 * y1 + 2.0 * y2 - 0.5 * y3
    a2 = -0.5 * y0 + 0.5 * y2
    a3 = y1
    return ((a0 * t + a1) * t + a2) * t + a3

  def smoothstep(edge0, edge1, x):
    if (edge0 == edge1):
      return 0.0
    t = clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)

  def linlin(x, in_lo, in_hi, out_lo, out_hi):
    return map(in_lo, in_hi, out_lo, out_hi, x)

  def linexp(x, in_lo, in_hi, out_lo, out_hi):
    if (in_lo == in_hi):
      return out_lo
    return out_lo * pow(out_hi / out_lo, (x - in_lo) / (in_hi - in_lo))

  def explin(x, in_lo, in_hi, out_lo, out_hi):
    if (in_lo == in_hi):
      return out_lo
    return out_lo + (out_hi - out_lo) * log(x / in_lo) / log(in_hi / in_lo)

  def expexp(x, in_lo, in_hi, out_lo, out_hi):
    if (in_lo == in_hi):
      return out_lo
    return out_lo * pow(out_hi / out_lo, log(x / in_lo) / log(in_hi / in_lo))

  def dbamp(db):
    return pow(10.0, db * 0.05)

  def ampdb(amp):
    return log(max(abs(amp), 0.000000000001)) / log(10.0) * 20.0

  def midicps(note):
    return 440.0 * pow(2.0, (note - 69.0) / 12.0)

  def cpsmidi(freq):
    return log(freq / 440.0) / log(2.0) * 12.0 + 69.0

  def midiratio(semitones):
    return pow(2.0, semitones / 12.0)

  def ratiomidi(ratio):
    return log(ratio) / log(2.0) * 12.0

  def octcps(oct):
    return 440.0 * pow(2.0, oct - 4.75)

  def cpsoct(freq):
    return log(freq / 440.0) / log(2.0) + 4.75

def clamp<T>(x: T, lo: T, hi: T) -> T:
  return std::math::clamp<T>(x, lo, hi)

def lerp<T>(a: T, b: T, t: T) -> T:
  return std::math::lerp<T>(a, b, t)

def inverse_lerp(a, b, x):
  return std::math::inverse_lerp(a, b, x)

def map(in_lo, in_hi, out_lo, out_hi, x):
  return std::math::map(in_lo, in_hi, out_lo, out_hi, x)

def sign(x):
  return std::math::sign(x)

