# Indexed reads and writes for arrays and audio buffers.
# Includes interpolated and wrapping reads for sample playback and wavetable lookup.

import std/math

namespace std::lookup:
  def read(buf, i: i32):
    return buf[i]

  def read(buf, ch: i32, i: i32):
    return buf[ch, i]

  def write(buf, i: i32, value):
    buf[i] = value

  def write(buf, ch: i32, i: i32, value):
    buf[ch, i] = value

  def _split_position(pos):
    pos_floor = floor(pos)
    idx = i32(pos_floor)
    t = pos - pos_floor
    return (idx, t)

  def _wrap_index(i: i32, n: i32):
    wrapped = i % n
    if wrapped < 0:
      wrapped += n
    return wrapped

  def readL(buf, pos):
    i0, t = _split_position(pos)
    a = read(buf, i0)
    c = read(buf, i0 + 1)
    return a + (c - a) * t

  def readL(buf, ch: i32, pos):
    i0, t = _split_position(pos)
    a = read(buf, ch, i0)
    c = read(buf, ch, i0 + 1)
    return a + (c - a) * t

  def readLW(buf, pos):
    i0, t = _split_position(pos)
    channel = buf[:]
    n = channel.len()
    i0 = _wrap_index(i0, n)
    i1 = _wrap_index(i0 + 1, n)
    a = read(channel, i0)
    c = read(channel, i1)
    return a + (c - a) * t

  def readLW(buf, ch: i32, pos):
    channel = buf[ch,:]
    return readLW(channel, pos)

  def _cubic_indices(index: i32, n: i32, looping: bool) -> (i32, i32, i32, i32):
    if !looping:
      # Clamp toward each boundary before applying offsets in i32.
      return (max(index, 1) - 1, index, min(index, n - 2) + 1, min(index, n - 3) + 2)
    i1 = _wrap_index(index, n)
    i0 = i1 - 1
    if i0 < 0:
      i0 = n - 1
    i2 = i1 + 1
    if i2 == n:
      i2 = 0
    i3 = i2 + 1
    if i3 == n:
      i3 = 0
    return (i0, i1, i2, i3)

  def _read_cubic(channel, pos, looping: bool):
    index, t = _split_position(pos)
    i0, i1, i2, i3 = _cubic_indices(index, channel.len(), looping)
    y0 = read(channel, i0)
    y1 = read(channel, i1)
    y2 = read(channel, i2)
    y3 = read(channel, i3)
    return std::math::cubic_interp(y0, y1, y2, y3, t)

  def readC(buf, pos):
    return _read_cubic(buf[:], pos, false)

  def readC(buf, ch: i32, pos):
    return _read_cubic(buf[ch,:], pos, false)

  def readCW(buf, pos):
    return _read_cubic(buf[:], pos, true)

  def readCW(buf, ch: i32, pos):
    return _read_cubic(buf[ch,:], pos, true)

def read(buf, i: i32):
  return std::lookup::read(buf, i)

def read(buf, ch: i32, i: i32):
  return std::lookup::read(buf, ch, i)

def write(buf, i: i32, value):
  return std::lookup::write(buf, i, value)

def write(buf, ch: i32, i: i32, value):
  return std::lookup::write(buf, ch, i, value)

def readL(buf, pos):
  return std::lookup::readL(buf, pos)

def readL(buf, ch: i32, pos):
  return std::lookup::readL(buf, ch, pos)

def readLW(buf, pos):
  return std::lookup::readLW(buf, pos)

def readLW(buf, ch: i32, pos):
  return std::lookup::readLW(buf, ch, pos)

def readC(buf, pos):
  return std::lookup::readC(buf, pos)

def readC(buf, ch: i32, pos):
  return std::lookup::readC(buf, ch, pos)

def readCW(buf, pos):
  return std::lookup::readCW(buf, pos)

def readCW(buf, ch: i32, pos):
  return std::lookup::readCW(buf, ch, pos)
