# Conversions between musical notes, frequencies, semitone intervals, and pitch ratios.
# Supports reference tuning when translating between note numbers and frequencies.

namespace std::pitch:
  const A4_HZ: f64 = 440.0
  const MIDI_A4 = 69.0
  const MIN_FLOAT = 0.00000000000000000001

  def ratio_from_semitones<T>(semitones: T):
    # ln(2) / 12, evaluated in the input's arithmetic precision.
    return exp(semitones * 0.05776226504666211)

  def semitones_from_ratio<T>(ratio: T):
    return log(ratio * 1.0) * 17.31234049066756

  def note_to_hz<T>(note: T):
    return note_to_hz(note, T(A4_HZ))

  def note_to_hz<T>(note: T, a4_hz: T):
    ref = max(a4_hz * 1.0, MIN_FLOAT)
    return ref * ratio_from_semitones(note * 1.0 - MIDI_A4)

  def hz_to_note<T>(hz: T):
    return hz_to_note(hz, T(A4_HZ))

  def hz_to_note<T>(hz: T, a4_hz: T):
    safe_hz = max(hz * 1.0, MIN_FLOAT)
    ref = max(a4_hz * 1.0, MIN_FLOAT)
    return semitones_from_ratio(safe_hz / ref) + MIDI_A4

  def ratio_between<T>(source_note: T, target_note: T):
    return ratio_from_semitones(_note_interval(source_note, target_note))

  def _note_interval<T>(source_note: T, target_note: T):
    return target_note - source_note

  def _note_interval(source_note: i32, target_note: i32) -> f32:
    return f32(i64(target_note) - i64(source_note))

  def _note_interval(source_note: i64, target_note: i64) -> f64:
    if (target_note < 0) != (source_note < 0):
      # Opposite signs can overflow i64. Subtracting them as f64 avoids cancellation.
      return f64(target_note) - f64(source_note)
    return f64(target_note - source_note)
