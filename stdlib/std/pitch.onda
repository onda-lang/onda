namespace std::pitch:
  const A4_HZ: f64 = 440.0
  const MIDI_A4: f64 = 69.0
  const MIN_FLOAT: f64 = 0.00000000000000000001

  def ratio_from_semitones<T>(semitones: T):
    # ln(2) / 12, evaluated in the input's arithmetic precision.
    return exp(semitones * 0.05776226504666211)

  def semitones_from_ratio<T>(ratio: T):
    return log(ratio) * 17.31234049066756

  def note_to_hz<T>(note: T):
    return note_to_hz(note, T(A4_HZ))

  def note_to_hz<T>(note: T, a4_hz: T):
    ref = max(a4_hz, T(MIN_FLOAT))
    return ref * ratio_from_semitones(note - T(MIDI_A4))

  def hz_to_note<T>(hz: T):
    return hz_to_note(hz, T(A4_HZ))

  def hz_to_note<T>(hz: T, a4_hz: T):
    safe_hz = max(hz, T(MIN_FLOAT))
    ref = max(a4_hz, T(MIN_FLOAT))
    return semitones_from_ratio(safe_hz / ref) + T(MIDI_A4)

  def ratio_between<T>(source_note: T, target_note: T):
    return ratio_from_semitones(target_note - source_note)
