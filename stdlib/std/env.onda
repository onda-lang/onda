namespace std::env:
  proc DecayEnv<T>:
    outs<T> 1

    params<T>:
      decay_s = 0.2
      trigger = 0.0

    init<T>:
      env = 0.0
      prev_trig = 0.0

    block:
      coef: T = exp(T(-1.0) / max(decay_s * SR, T(1.0)))
      sample:
        if (trigger > 0.0 && prev_trig <= 0.0):
          env = 1.0
        env = env * coef
        prev_trig = trigger
        out1 = env
