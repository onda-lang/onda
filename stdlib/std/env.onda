# Triggered and gated envelopes for shaping amplitude and other control signals over time.
# Finite envelopes reach their endpoint after each stage's duration in seconds and
# emit finished() at the end. Each ramp captures its settings when it starts.

import std/smoothing

namespace std::env:
  enum _Stage:
    Idle
    Attack
    Decay
    Sustain
    Release

  # One envelope can finish several times between samples. After storing the
  # output, take the count before calling finished() so callbacks can retrigger it.
  struct _Completions:
    pending: i32 = 0

    def take(self):
      pending = self.pending
      self.pending = 0
      return pending

  # Impulse-driven exponential tails; time changes preserve the accumulated state.
  # Nonpositive or nonfinite times disable the tail. reset() clears it immediately.
  proc Decay<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      decay_60db_s = 0.2 => update_decay

    init:
      value: T = 0.0
      coefficient: T = 0.0

    def update_decay():
      coefficient = std::smoothing::_decay_60db_coefficient(decay_60db_s, 1.0)

    event reset():
      value = 0.0

    sample:
      if coefficient == 0.0:
        value = in1
      else:
        value = in1 + value * coefficient
      out1 = value

  proc DecayEnv<T>:
    outs<T> 1

    delegate finished()

    params<T>:
      decay_s = 0.2
      shape: std::smoothing::RampShape = std::smoothing::RampShape::Exponential
      curve = -4.0 {-60.0, 60.0}
      trigger = 0.0 {0.0, 1.0} => update_trigger

    init:
      transition: std::smoothing::_EnvelopeTransition::State<T>
      completions: _Completions
      prev_trig: T = 0.0

    def update_trigger():
      if trigger > 0.0 && prev_trig <= 0.0:
        begin(1.0)
      prev_trig = trigger

    def begin(level: T):
      transition.reset(max(level, 0.0))
      transition.begin(0.0, std::smoothing::_duration_samples(decay_s), shape, curve)
      if transition.complete():
        completions.pending += 1

    events:
      start(level: T = 1.0):
        begin(level)

      reset():
        transition.reset(0.0)
        completions.take()

    sample:
      if transition.advance():
        completions.pending += 1
      out1 = transition.value
      if completions.pending > 0:
        for i in 0..completions.take():
          finished()

  proc AR<T>:
    outs<T> 1

    delegate finished()

    params<T>:
      attack_s = 0.01
      release_s = 0.1
      attack_shape: std::smoothing::RampShape = std::smoothing::RampShape::Linear
      attack_curve = -4.0 {-60.0, 60.0}
      release_shape: std::smoothing::RampShape = std::smoothing::RampShape::Linear
      release_curve = -4.0 {-60.0, 60.0}
      trigger = 0.0 {0.0, 1.0} => update_trigger

    init:
      transition: std::smoothing::_EnvelopeTransition::State<T>
      completions: _Completions
      prev_trig: T = 0.0
      stage: _Stage = _Stage::Idle

    def update_trigger():
      if trigger > 0.0 && prev_trig <= 0.0:
        begin()
      prev_trig = trigger

    def begin():
      transition.begin(1.0, std::smoothing::_duration_samples(attack_s), attack_shape, attack_curve)
      stage = _Stage::Attack
      settle()

    def settle():
      if stage == _Stage::Attack && transition.complete():
        transition.begin(
          0.0,
          std::smoothing::_duration_samples(release_s),
          release_shape,
          release_curve
        )
        stage = _Stage::Release
      if stage == _Stage::Release && transition.complete():
        stage = _Stage::Idle
        completions.pending += 1

    events:
      start():
        begin()

      reset():
        transition.reset(0.0)
        stage = _Stage::Idle
        completions.take()

    sample:
      if transition.advance():
        settle()
      out1 = transition.value
      if completions.pending > 0:
        for i in 0..completions.take():
          finished()

  struct _GatedEnvelope<T>:
    transition: std::smoothing::_EnvelopeTransition::State<T>
    stage: _Stage = _Stage::Idle
    completions: _Completions

    def begin_stage(
      self,
      stage: _Stage,
      target: T,
      duration_s: T,
      shape: std::smoothing::RampShape,
      curve: T
    ):
      self.transition.begin(target, std::smoothing::_duration_samples(duration_s), shape, curve)
      self.stage = stage

    def update_sustain(self, sustain: T):
      if self.stage == _Stage::Sustain && self.transition.target != sustain:
        self.transition.set_next(sustain)

    def enter_sustain(self, sustain: T):
      self.stage = _Stage::Sustain
      self.update_sustain(sustain)

    # The processor starts its own attack if the gate reopens.
    def update_gate(
      self,
      gate: T,
      release_s: T,
      release_shape: std::smoothing::RampShape,
      release_curve: T
    ) -> bool:
      if gate <= 0.0:
        if self.stage != _Stage::Idle && self.stage != _Stage::Release:
          self.begin_stage(_Stage::Release, 0.0, release_s, release_shape, release_curve)
          if self.transition.complete():
            self.finish_release()
        return false
      return self.stage == _Stage::Idle || self.stage == _Stage::Release

    def finish_release(self):
      if self.stage == _Stage::Release:
        self.stage = _Stage::Idle
        self.completions.pending += 1

    def reset(self):
      self.stage = _Stage::Idle
      self.transition.reset(0.0)
      self.completions.take()

  proc ASR<T>:
    outs<T> 1

    delegate finished()

    params<T>:
      attack_s = 0.01
      sustain = 1.0 {0.0, 1.0} => update_sustain
      release_s = 0.1
      attack_shape: std::smoothing::RampShape = std::smoothing::RampShape::Linear
      attack_curve = -4.0 {-60.0, 60.0}
      release_shape: std::smoothing::RampShape = std::smoothing::RampShape::Linear
      release_curve = -4.0 {-60.0, 60.0}
      gate = 0.0 {0.0, 1.0} => update_gate

    init:
      envelope: _GatedEnvelope<T>

    def update_sustain():
      envelope.update_sustain(sustain)

    def update_gate():
      if envelope.update_gate(gate, release_s, release_shape, release_curve):
        begin()

    def begin():
      envelope.begin_stage(_Stage::Attack, sustain, attack_s, attack_shape, attack_curve)
      if envelope.transition.complete():
        envelope.enter_sustain(sustain)

    events:
      start():
        begin()
        gate = 1.0

      release():
        gate = 0.0

      reset():
        envelope.reset()
        gate = 0.0

    sample:
      if envelope.transition.advance():
        if envelope.stage == _Stage::Attack:
          envelope.enter_sustain(sustain)
        else:
          envelope.finish_release()
      out1 = envelope.transition.value
      if envelope.completions.pending > 0:
        for i in 0..envelope.completions.take():
          finished()

  proc ADSR<T>:
    outs<T> 1

    delegate finished()

    params<T>:
      attack_s = 0.01
      decay_s = 0.1
      sustain = 0.7 {0.0, 1.0} => update_sustain
      release_s = 0.2
      attack_shape: std::smoothing::RampShape = std::smoothing::RampShape::Linear
      attack_curve = -4.0 {-60.0, 60.0}
      decay_shape: std::smoothing::RampShape = std::smoothing::RampShape::Linear
      decay_curve = -4.0 {-60.0, 60.0}
      release_shape: std::smoothing::RampShape = std::smoothing::RampShape::Linear
      release_curve = -4.0 {-60.0, 60.0}
      gate = 0.0 {0.0, 1.0} => update_gate

    init:
      envelope: _GatedEnvelope<T>

    def update_sustain():
      envelope.update_sustain(sustain)

    def update_gate():
      if envelope.update_gate(gate, release_s, release_shape, release_curve):
        begin()

    def begin():
      envelope.begin_stage(_Stage::Attack, 1.0, attack_s, attack_shape, attack_curve)
      settle()

    # A zero-length decay can settle on the same sample as the attack.
    def settle():
      if envelope.stage == _Stage::Attack && envelope.transition.complete():
        envelope.begin_stage(_Stage::Decay, sustain, decay_s, decay_shape, decay_curve)
      if envelope.transition.complete():
        if envelope.stage == _Stage::Decay:
          envelope.enter_sustain(sustain)
        else:
          envelope.finish_release()

    events:
      start():
        begin()
        gate = 1.0

      release():
        gate = 0.0

      reset():
        envelope.reset()
        gate = 0.0

    sample:
      if envelope.transition.advance():
        settle()
      out1 = envelope.transition.value
      if envelope.completions.pending > 0:
        for i in 0..envelope.completions.take():
          finished()
