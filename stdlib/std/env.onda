namespace std::env:
  def decay_coefficient<T>(time_s: T):
    return exp(T(-1.0) / max(time_s * SR, T(1.0)))

  proc DecayEnv<T>:
    outs<T> 1

    params<T>:
      decay_s = 0.2 => update_decay
      trigger = 0.0

    init<T>:
      env = 0.0
      prev_trig = 0.0
      coef = 0.0

    def update_decay():
      coef = std::env::decay_coefficient<T>(decay_s)

    event start(level: T = 1.0):
      env = max(level, T(0.0))
      prev_trig = trigger

    sample:
      if (trigger > 0.0 && prev_trig <= 0.0):
        env = 1.0
      env = env * coef
      prev_trig = trigger
      out1 = env

  proc AR<T>:
    outs<T> 1

    params<T>:
      attack_s = 0.01 => update_steps
      release_s = 0.1 => update_steps
      trigger = 0.0

    init<T>:
      env = 0.0
      prev_trig = 0.0
      stage: i32 = 0
      attack_step = 0.0
      release_step = 0.0

    def update_steps():
      attack_step = 1.0 / max(attack_s * SR, T(1.0))
      release_step = 1.0 / max(release_s * SR, T(1.0))

    sample:
      if (trigger > 0.0 && prev_trig <= 0.0):
        stage = 1

      if (stage == 1):
        env = min(env + attack_step, T(1.0))
        if (env >= 1.0):
          env = 1.0
          stage = 2
      elif (stage == 2):
        env = max(env - release_step, T(0.0))
        if (env <= 0.0):
          env = 0.0
          stage = 0

      prev_trig = trigger
      out1 = env

  proc ASR<T>:
    outs<T> 1

    params<T>:
      attack_s = 0.01 => update_shape
      sustain = 1.0 => update_shape
      release_s = 0.1 => update_shape
      gate = 0.0

    init<T>:
      env = 0.0
      sustain_v = 1.0
      attack_step = 0.0
      release_step = 0.0

    def update_shape():
      sustain_v = clamp(sustain, T(0.0), T(1.0))
      attack_step = sustain_v / max(attack_s * SR, T(1.0))
      release_step = sustain_v / max(release_s * SR, T(1.0))

    sample:
      if (gate > 0.0):
        if (env < sustain_v):
          env = min(env + attack_step, sustain_v)
        elif (env > sustain_v):
          env = sustain_v
      else:
        env = max(env - release_step, T(0.0))

      out1 = env
  
  namespace stage:
    const IDLE = 0
    const ATTACK = 1
    const DECAY = 2
    const SUSTAIN = 3
    const RELEASE = 4

  proc ADSR<T>:
    outs<T> 1

    params<T>:
      attack_s = 0.01 => update_shape
      decay_s = 0.1 => update_shape
      sustain = 0.7 => update_shape
      release_s = 0.2 => update_shape
      gate = 0.0

    init<T>:
      env = 0.0
      prev_gate = 0.0
      stage: i32 = stage::IDLE
      sustain_v = 0.7
      attack_step = 0.0
      decay_step = 0.0
      release_step = 0.0

    def update_shape():
      sustain_v = clamp(sustain, T(0.0), T(1.0))
      attack_step = 1.0 / max(attack_s * SR, T(1.0))
      decay_step = (1.0 - sustain_v) / max(decay_s * SR, T(1.0))
      release_step = 1.0 / max(release_s * SR, T(1.0))

    sample:
      if (gate > 0.0 && prev_gate <= 0.0):
        stage = stage::ATTACK
      elif (gate <= 0.0 && prev_gate > 0.0 && stage != stage::IDLE):
        stage = stage::RELEASE

      if (stage == stage::ATTACK):
        env = min(env + attack_step, T(1.0))
        if (env >= 1.0):
          env = 1.0
          if (gate > 0.0):
            stage = stage::DECAY
          else:
            stage = stage::RELEASE
      elif (stage == stage::DECAY):
        if (env > sustain_v):
          env = max(env - decay_step, sustain_v)
        else:
          env = sustain_v

        if (env <= sustain_v):
          if (gate > 0.0):
            stage = stage::SUSTAIN
          else:
            stage = stage::RELEASE
      elif (stage == stage::SUSTAIN):
        env = sustain_v
        if (gate <= 0.0):
          stage = stage::RELEASE
      elif (stage == stage::RELEASE):
        env = max(env - release_step, T(0.0))
        if (env <= 0.0):
          env = 0.0
          stage = stage::IDLE

      prev_gate = gate
      out1 = env
