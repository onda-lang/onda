# Triggered and gated envelopes for shaping amplitude and other control signals over time.
# Finite envelopes reach their endpoint after each stage's duration in seconds and
# emit finished() at the end. Parameter hooks apply edits to an active stage.
# Time edits scale the time left; shape and curve edits reshape that remainder.
# Sustain edits apply immediately; releases retain their note-off level.

import std/smoothing

namespace std::env:
  enum _Stage:
    Idle
    Attack
    Decay
    Sustain
    Release

  # Impulse-driven exponential tails; time changes preserve the accumulated state.
  # Nonpositive or nonfinite times disable the tail. reset() clears it immediately.
  proc Decay<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      decay_60db_s = 0.2 => update_decay

    init<T>:
      value: f64 = 0.0
      coefficient: f64 = 0.0

    def update_decay():
      coefficient = 0.0
      if decay_60db_s > 0.0 && decay_60db_s - decay_60db_s == 0.0:
        coefficient = exp(log(f64(0.001)) / (f64(decay_60db_s) * SR))

    event reset():
      value = 0.0

    sample:
      value = in1 + value * coefficient
      out1 = T(value)

  # Completion is sample-counted; parameter edits reshape the remaining transition.
  proc DecayEnv<T>:
    outs<T> 1

    delegate finished()

    params<T>:
      decay_s = 0.2 => update_decay
      shape: std::smoothing::RampShape = std::smoothing::RampShape::Exponential => update_decay
      curve = -4.0 {-60.0, 60.0} => update_decay
      trigger = 0.0 {0.0, 1.0} => update_trigger

    init:
      segment: std::smoothing::_Segment<T>
      prev_trig: T = 0.0
      active = false

    def update_decay():
      if active:
        segment.update(0.0, std::smoothing::_duration(decay_s), shape, curve)

    def update_trigger():
      if trigger > 0.0 && prev_trig <= 0.0:
        begin(1.0)
      prev_trig = trigger

    def begin(level: T):
      segment.reset(max(level, 0.0))
      segment.begin(0.0, std::smoothing::_duration(decay_s), shape, curve)
      active = true

    events:
      start(level: T = 1.0):
        begin(level)
        prev_trig = trigger

      reset():
        segment.reset(0.0)
        active = false
        prev_trig = trigger

    sample:
      completed = false
      if active:
        segment.advance()
        if segment.complete():
          active = false
          completed = true
      out1 = segment.value
      if completed:
        finished()

  proc AR<T>:
    outs<T> 1

    delegate finished()

    params<T>:
      attack_s = 0.01 => update_shape
      release_s = 0.1 => update_shape
      attack_shape: std::smoothing::RampShape = std::smoothing::RampShape::Linear => update_shape
      attack_curve = -4.0 {-60.0, 60.0} => update_shape
      release_shape: std::smoothing::RampShape = std::smoothing::RampShape::Linear => update_shape
      release_curve = -4.0 {-60.0, 60.0} => update_shape
      trigger = 0.0 {0.0, 1.0} => update_trigger

    init:
      segment: std::smoothing::_Segment<T>
      prev_trig: T = 0.0
      stage: _Stage = _Stage::Idle

    def update_shape():
      if stage == _Stage::Attack:
        segment.update(1.0, std::smoothing::_duration(attack_s), attack_shape, attack_curve)
      elif stage == _Stage::Release:
        segment.update(0.0, std::smoothing::_duration(release_s), release_shape, release_curve)

    def update_trigger():
      if trigger > 0.0 && prev_trig <= 0.0:
        begin()
      prev_trig = trigger

    def begin():
      segment.begin(1.0, std::smoothing::_duration(attack_s), attack_shape, attack_curve)
      stage = _Stage::Attack

    # Cross completed and zero-length stages without consuming another sample.
    def settle():
      while segment.complete():
        if stage == _Stage::Attack:
          segment.begin(0.0, std::smoothing::_duration(release_s), release_shape, release_curve)
          stage = _Stage::Release
        else:
          stage = _Stage::Idle
          return true
      return false

    events:
      start():
        begin()
        prev_trig = trigger

      reset():
        segment.reset(0.0)
        stage = _Stage::Idle
        prev_trig = trigger

    sample:
      completed = false
      if stage != _Stage::Idle:
        completed = settle()
        if stage != _Stage::Idle:
          segment.advance()
          completed = settle()
      out1 = segment.value
      if completed:
        finished()

  proc ASR<T>:
    outs<T> 1

    delegate finished()

    params<T>:
      attack_s = 0.01 => update_shape
      sustain = 1.0 {0.0, 1.0} => update_sustain
      release_s = 0.1 => update_shape
      attack_shape: std::smoothing::RampShape = std::smoothing::RampShape::Linear => update_shape
      attack_curve = -4.0 {-60.0, 60.0} => update_shape
      release_shape: std::smoothing::RampShape = std::smoothing::RampShape::Linear => update_shape
      release_curve = -4.0 {-60.0, 60.0} => update_shape
      gate = 0.0 {0.0, 1.0} => update_gate

    init:
      segment: std::smoothing::_Segment<T>
      prev_gate = false
      stage: _Stage = _Stage::Idle

    def update_shape():
      if stage == _Stage::Attack:
        segment.update(sustain, std::smoothing::_duration(attack_s), attack_shape, attack_curve)
      elif stage == _Stage::Release:
        segment.update(0.0, std::smoothing::_duration(release_s), release_shape, release_curve)

    def update_sustain():
      if stage == _Stage::Attack:
        segment.value = min(segment.value, sustain)
        update_shape()
      elif stage == _Stage::Sustain:
        segment.reset(sustain)

    def update_gate():
      high = gate > 0.0
      if high != prev_gate:
        if high:
          begin()
        else:
          begin_release()
        prev_gate = high

    def begin():
      segment.begin(sustain, std::smoothing::_duration(attack_s), attack_shape, attack_curve)
      stage = _Stage::Attack

    def begin_release():
      if stage != _Stage::Idle && stage != _Stage::Release:
        segment.begin(0.0, std::smoothing::_duration(release_s), release_shape, release_curve)
        stage = _Stage::Release

    # Cross completed and zero-length stages without consuming another sample.
    def settle():
      while segment.complete():
        if stage == _Stage::Attack:
          stage = _Stage::Sustain
          segment.value = sustain
          return false
        stage = _Stage::Idle
        return true
      return false

    events:
      start():
        prev_gate = true
        gate = 1.0
        begin()

      release():
        prev_gate = false
        gate = 0.0
        begin_release()

      reset():
        prev_gate = false
        gate = 0.0
        segment.reset(0.0)
        stage = _Stage::Idle

    sample:
      completed = false
      if stage != _Stage::Idle && stage != _Stage::Sustain:
        completed = settle()
        if stage != _Stage::Idle && stage != _Stage::Sustain:
          segment.advance()
          completed = settle()
      out1 = segment.value
      if completed:
        finished()

  proc ADSR<T>:
    outs<T> 1

    delegate finished()

    params<T>:
      attack_s = 0.01 => update_shape
      decay_s = 0.1 => update_shape
      sustain = 0.7 {0.0, 1.0} => update_sustain
      release_s = 0.2 => update_shape
      attack_shape: std::smoothing::RampShape = std::smoothing::RampShape::Linear => update_shape
      attack_curve = -4.0 {-60.0, 60.0} => update_shape
      decay_shape: std::smoothing::RampShape = std::smoothing::RampShape::Linear => update_shape
      decay_curve = -4.0 {-60.0, 60.0} => update_shape
      release_shape: std::smoothing::RampShape = std::smoothing::RampShape::Linear => update_shape
      release_curve = -4.0 {-60.0, 60.0} => update_shape
      gate = 0.0 {0.0, 1.0} => update_gate

    init:
      segment: std::smoothing::_Segment<T>
      prev_gate = false
      stage: _Stage = _Stage::Idle

    def update_shape():
      if stage == _Stage::Attack:
        segment.update(1.0, std::smoothing::_duration(attack_s), attack_shape, attack_curve)
      elif stage == _Stage::Decay:
        segment.update(sustain, std::smoothing::_duration(decay_s), decay_shape, decay_curve)
      elif stage == _Stage::Release:
        segment.update(0.0, std::smoothing::_duration(release_s), release_shape, release_curve)

    def update_sustain():
      if stage == _Stage::Decay:
        segment.value = max(segment.value, sustain)
        update_shape()
      elif stage == _Stage::Sustain:
        segment.reset(sustain)

    def update_gate():
      high = gate > 0.0
      if high != prev_gate:
        if high:
          begin()
        else:
          begin_release()
        prev_gate = high

    def begin():
      segment.begin(1.0, std::smoothing::_duration(attack_s), attack_shape, attack_curve)
      stage = _Stage::Attack

    def begin_release():
      if stage != _Stage::Idle && stage != _Stage::Release:
        segment.begin(0.0, std::smoothing::_duration(release_s), release_shape, release_curve)
        stage = _Stage::Release

    # Cross completed and zero-length stages without consuming another sample.
    def settle():
      while segment.complete():
        if stage == _Stage::Attack:
          segment.begin(sustain, std::smoothing::_duration(decay_s), decay_shape, decay_curve)
          stage = _Stage::Decay
        elif stage == _Stage::Decay:
          stage = _Stage::Sustain
          segment.value = sustain
          return false
        else:
          stage = _Stage::Idle
          return true
      return false

    events:
      start():
        prev_gate = true
        gate = 1.0
        begin()

      release():
        prev_gate = false
        gate = 0.0
        begin_release()

      reset():
        prev_gate = false
        gate = 0.0
        segment.reset(0.0)
        stage = _Stage::Idle

    sample:
      completed = false
      if stage != _Stage::Idle && stage != _Stage::Sustain:
        completed = settle()
        if stage != _Stage::Idle && stage != _Stage::Sustain:
          segment.advance()
          completed = settle()
      out1 = segment.value
      if completed:
        finished()
