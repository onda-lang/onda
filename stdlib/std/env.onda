import std/smoothing

namespace std::env:
  def decay_coefficient<T>(time_s: T):
    return std::smoothing::time_coefficient<T>(time_s)

  proc DecayEnv<T>:
    outs<T> 1
    
    delegate finished()

    params<T>:
      decay_s = 0.2 => update_decay
      end_level = 0.00001 {0.000000001, 1.0}
      trigger = 0.0 {0.0, 1.0}

    init<T>:
      env = 0.0
      prev_trig = 0.0
      coef = 0.0
      active: bool = false

    def update_decay():
      coef = std::env::decay_coefficient<T>(decay_s)

    def begin(level: T):
      env = max(level, T(0.0))
      active = env > end_level

    events:
      start(level: T = 1.0):
        begin(level)
        prev_trig = trigger

      reset():
        env = 0.0
        active = false
        prev_trig = trigger

    sample:
      if trigger > 0.0 && prev_trig <= 0.0:
        begin(T(1.0))

      if active:
        env *= coef
        if env <= end_level:
          env = 0.0
          active = false
          finished()

      prev_trig = trigger
      out1 = env

  proc AR<T>:
    outs<T> 1

    delegate finished()

    params<T>:
      attack_s = 0.01 => update_steps
      release_s = 0.1 => update_steps
      trigger = 0.0 {0.0, 1.0}

    init<T>:
      env = 0.0
      prev_trig = 0.0
      stage = 0
      attack_step = 0.0
      release_step = 0.0

    def update_steps():
      attack_step = 1.0 / max(attack_s * SR, T(1.0))
      release_step = 1.0 / max(release_s * SR, T(1.0))

    def begin():
      stage = 1

    events:
      start():
        begin()
        prev_trig = trigger

      reset():
        env = 0.0
        stage = 0
        prev_trig = trigger

    sample:
      if trigger > 0.0 && prev_trig <= 0.0:
        begin()

      if stage == 1:
        env = min(env + attack_step, T(1.0))
        if env >= 1.0:
          env = 1.0
          stage = 2
      elif stage == 2:
        env = max(env - release_step, T(0.0))
        if env <= 0.0:
          env = 0.0
          stage = 0
          finished()

      prev_trig = trigger
      out1 = env

  proc ASR<T>:
    outs<T> 1
    
    delegate finished()

    params<T>:
      attack_s = 0.01 => update_shape
      sustain = 1.0 {0.0, 1.0} => update_shape
      release_s = 0.1 => update_shape
      gate = 0.0 {0.0, 1.0}

    init<T>:
      env = 0.0
      sustain_v = 1.0
      attack_step = 0.0
      release_step = 0.0
      active: bool = false

    def update_shape():
      sustain_v = sustain
      attack_step = sustain_v / max(attack_s * SR, T(1.0))
      release_step = sustain_v / max(release_s * SR, T(1.0))

    events:
      start():
        gate = 1.0
        active = true

      release():
        gate = 0.0

      reset():
        gate = 0.0
        env = 0.0
        active = false

    sample:
      if gate > 0.0:
        active = true
        if env < sustain_v:
          env = min(env + attack_step, sustain_v)
        elif env > sustain_v:
          env = sustain_v
      else:
        env = max(env - release_step, T(0.0))
        if active && env <= 0.0:
          env = 0.0
          active = false
          finished()

      out1 = env

  namespace stage:
    const IDLE = 0
    const ATTACK = 1
    const DECAY = 2
    const SUSTAIN = 3
    const RELEASE = 4

  proc ADSR<T>:
    outs<T> 1
    
    delegate finished()

    params<T>:
      attack_s = 0.01 => update_shape
      decay_s = 0.1 => update_shape
      sustain = 0.7 {0.0, 1.0} => update_shape
      release_s = 0.2 => update_shape
      gate = 0.0 {0.0, 1.0}

    init<T>:
      env = 0.0
      prev_gate = 0.0
      stage = stage::IDLE
      sustain_v = 0.7
      attack_step = 0.0
      decay_step = 0.0
      release_step = 0.0

    def update_shape():
      sustain_v = sustain
      attack_step = 1.0 / max(attack_s * SR, T(1.0))
      decay_step = (1.0 - sustain_v) / max(decay_s * SR, T(1.0))
      release_step = 1.0 / max(release_s * SR, T(1.0))

    def begin():
      stage = stage::ATTACK

    events:
      start():
        gate = 1.0
        begin()
        prev_gate = gate

      release():
        gate = 0.0
        if stage != stage::IDLE:
          stage = stage::RELEASE
        prev_gate = gate

      reset():
        gate = 0.0
        env = 0.0
        stage = stage::IDLE
        prev_gate = gate

    sample:
      if gate > 0.0 && prev_gate <= 0.0:
        begin()
      elif gate <= 0.0 && prev_gate > 0.0 && stage != stage::IDLE:
        stage = stage::RELEASE

      if stage == stage::ATTACK:
        env = min(env + attack_step, T(1.0))
        if env >= 1.0:
          env = 1.0
          if gate > 0.0:
            stage = stage::DECAY
          else:
            stage = stage::RELEASE
      elif stage == stage::DECAY:
        if env > sustain_v:
          env = max(env - decay_step, sustain_v)
        else:
          env = sustain_v

        if env <= sustain_v:
          if gate > 0.0:
            stage = stage::SUSTAIN
          else:
            stage = stage::RELEASE
      elif stage == stage::SUSTAIN:
        env = sustain_v
        if gate <= 0.0:
          stage = stage::RELEASE
      elif stage == stage::RELEASE:
        env = max(env - release_step, T(0.0))
        if env <= 0.0:
          env = 0.0
          stage = stage::IDLE
          finished()

      prev_gate = gate
      out1 = env
