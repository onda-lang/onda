import std/math
import std/lookup

namespace std::sample<Channels = 2>:
  assert(Channels > 0)

  def _normalize_position(position: f64, samples: i32, looping: bool):
    if samples <= 1:
      return f64(0.0)
    if looping:
      return wrap(position, f64(0.0), f64(samples))
    return clamp(position, f64(0.0), f64(samples - 1))

  proc Player<T>:
    outs<T> Channels

    buffers:
      clip: T[]

    params:
      speed: T = 1.0
      looping = false

    delegate finished()
    delegate looped()

    init:
      playhead: f64 = 0.0
      playing = false

    events:
      play(start_sample: f64 = 0.0):
        playhead = _normalize_position(start_sample, clip.samples(), looping)
        playing = true

      stop():
        playing = false

      seek(position: f64):
        playhead = _normalize_position(position, clip.samples(), looping)

      reset():
        playhead = 0.0
        playing = false

    block:
      clip_bound = clip.bound()
      clip_samples = clip.samples()
      clip_channels = clip.chans()
      step = f64(speed) * (clip.samplerate() / SR)

      sample:
        for channel in 0..Channels:
            outs[channel] = T(0.0)

        if playing:
          if !clip_bound:
            playing = false
            finished()
          else:
            for channel in 0..Channels:
              source_channel = min(channel, clip_channels - 1)
              if looping:
                outs[channel] = T(std::lookup::readCW(clip, source_channel, playhead))
              else:
                outs[channel] = T(std::lookup::readC(clip, source_channel, playhead))

            next_playhead = playhead + step
            if next_playhead >= f64(clip_samples) || next_playhead < 0.0:
              if looping:
                playhead = wrap(next_playhead, f64(0.0), f64(clip_samples))
                looped()
              else:
                playing = false
                finished()
            else:
              playhead = next_playhead
