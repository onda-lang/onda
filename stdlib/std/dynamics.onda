import std/levels
import std/smoothing

namespace std::dynamics:
  def _soft_knee_reduction_db<T>(over_db: T, slope: T, half_knee: T, knee_divisor: T):
    if over_db >= half_knee:
      return over_db * slope
    if over_db > -half_knee && half_knee > 0.0:
      knee_pos = over_db + half_knee
      return slope * knee_pos * knee_pos / knee_divisor
    return T(0.0)

  def soft_knee_reduction_db<T>(level_db: T, threshold_db: T, ratio: T, knee_db: T):
    slope = T(1.0) - T(1.0) / max(ratio, T(1.0))
    half_knee = max(knee_db, T(0.0)) * T(0.5)
    return _soft_knee_reduction_db(level_db - threshold_db, slope, half_knee, T(4.0) * half_knee)

  proc PeakFollower<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      attack_s = 0.01 => update_attack
      release_s = 0.1 => update_release

    init<T>:
      envelope = 0.0
      attack_coef = 0.0
      release_coef = 0.0

    def update_attack():
      attack_coef = std::smoothing::time_coefficient<T>(attack_s)

    def update_release():
      release_coef = std::smoothing::time_coefficient<T>(release_s)

    event reset():
      envelope = 0.0

    sample:
      level = abs(in1)
      if level > envelope:
        envelope = level + (envelope - level) * attack_coef
      else:
        envelope = level + (envelope - level) * release_coef
      out1 = envelope

  proc RmsFollower<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      attack_s = 0.01 => update_attack
      release_s = 0.1 => update_release

    init<T>:
      mean_square = 0.0
      attack_coef = 0.0
      release_coef = 0.0

    def update_attack():
      attack_coef = std::smoothing::time_coefficient<T>(attack_s)

    def update_release():
      release_coef = std::smoothing::time_coefficient<T>(release_s)

    event reset():
      mean_square = 0.0

    sample:
      square = in1 * in1
      if square > mean_square:
        mean_square = square + (mean_square - square) * attack_coef
      else:
        mean_square = square + (mean_square - square) * release_coef
      out1 = sqrt(max(mean_square, T(0.0)))

  proc Compressor<T>:
    ins<T> 2
    outs<T> 2

    params<T>:
      threshold_db = -18.0 => update_threshold
      ratio = 4.0 => update_ratio
      attack_s = 0.01 => update_attack
      release_s = 0.1 => update_release
      knee_db = 6.0 => update_knee
      makeup_db = 0.0 => update_makeup

    init<T>:
      detector = 0.0
      attack_coef = 0.0
      release_coef = 0.0
      slope = 0.0
      half_knee = 0.0
      knee_divisor = 0.0
      lower_knee = 0.0
      makeup_gain = 1.0

    def update_ratio():
      slope = T(1.0) - T(1.0) / max(ratio, T(1.0))

    def update_knee():
      half_knee = max(knee_db, T(0.0)) * T(0.5)
      knee_divisor = T(4.0) * half_knee
      update_threshold()

    def update_threshold():
      lower_knee = std::levels::db_to_gain<T>(threshold_db - half_knee)

    def update_makeup():
      makeup_gain = std::levels::db_to_gain<T>(makeup_db)

    def update_attack():
      attack_coef = std::smoothing::time_coefficient<T>(attack_s)

    def update_release():
      release_coef = std::smoothing::time_coefficient<T>(release_s)

    event reset():
      detector = 0.0

    sample:
      peak = max(abs(in1), abs(in2))
      if peak > detector:
        detector = peak + (detector - peak) * attack_coef
      else:
        detector = peak + (detector - peak) * release_coef

      gain = makeup_gain
      # Keep the detector running while the curve needs no gain reduction.
      if slope != 0.0 && max(detector, T(std::levels::MIN_FLOAT)) > lower_knee:
        level_db = std::levels::gain_to_db<T>(detector)
        reduction_db = std::dynamics::_soft_knee_reduction_db<T>(
          level_db - threshold_db, slope, half_knee, knee_divisor
        )
        gain = std::levels::db_to_gain<T>(makeup_db - reduction_db)
      out1 = in1 * gain
      out2 = in2 * gain

  proc Limiter<T>:
    ins<T> 2
    outs<T> 2

    params<T>:
      ceiling_db = -0.3 => update_ceiling
      release_s = 0.05 => update_release

    init<T>:
      gain = 1.0
      ceiling = 1.0
      release_coef = 0.0

    def update_ceiling():
      ceiling = std::levels::db_to_gain<T>(ceiling_db)

    def update_release():
      release_coef = std::smoothing::time_coefficient<T>(release_s)

    event reset():
      gain = 1.0

    sample:
      peak = max(abs(in1), abs(in2))
      if peak > ceiling:
        target_gain = ceiling / peak
      else:
        target_gain = T(1.0)

      if target_gain < gain:
        gain = target_gain
      else:
        gain = target_gain + (gain - target_gain) * release_coef

      out1 = in1 * gain
      out2 = in2 * gain

  proc Gate<T>:
    ins<T> 2
    outs<T> 2

    params<T>:
      threshold_db = -48.0 => update_threshold
      attack_s = 0.002 => update_attack
      release_s = 0.08 => update_release

    init<T>:
      threshold = 0.0
      gain = 0.0
      attack_coef = 0.0
      release_coef = 0.0

    def update_threshold():
      threshold = std::levels::db_to_gain<T>(threshold_db)

    def update_attack():
      attack_coef = std::smoothing::time_coefficient<T>(attack_s)

    def update_release():
      release_coef = std::smoothing::time_coefficient<T>(release_s)

    event reset():
      gain = 0.0

    sample:
      if max(abs(in1), abs(in2)) >= threshold:
        target_gain = T(1.0)
        coef = attack_coef
      else:
        target_gain = T(0.0)
        coef = release_coef
      gain = target_gain + (gain - target_gain) * coef
      out1 = in1 * gain
      out2 = in2 * gain
