# Amplitude tracking and dynamic-range processing for audio signals.
# Provides envelope followers, compression, limiting, and gating.
# RmsFollower applies attack_lag_s and release_lag_s to squared amplitude.
# After one attack time constant, a unit step from silence reaches about 0.632
# in mean square, giving an RMS output of about 0.795.

import std/levels
import std/smoothing

namespace std::dynamics:
  def _soft_knee_reduction_db<T>(over_db: T, slope: T, half_knee: T, knee_divisor: T):
    if over_db >= half_knee:
      return over_db * slope
    if over_db > -half_knee && half_knee > 0.0:
      knee_pos = over_db + half_knee
      return slope * knee_pos * knee_pos / knee_divisor
    return T(0.0)

  def soft_knee_reduction_db<T>(level_db: T, threshold_db: T, ratio: T, knee_db: T):
    slope = T(1.0) - T(1.0) / max(ratio, T(1.0))
    half_knee = max(knee_db, T(0.0)) * T(0.5)
    return _soft_knee_reduction_db(level_db - threshold_db, slope, half_knee, T(4.0) * half_knee)

  proc PeakFollower<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      attack_lag_s = 0.01 => update_attack
      release_lag_s = 0.1 => update_release

    init:
      follower = std::smoothing::LagUD<T>()

    def update_attack():
      follower.rise_lag_s = attack_lag_s

    def update_release():
      follower.fall_lag_s = release_lag_s

    event reset():
      follower.reset()

    sample:
      out1 = follower(abs(in1))

  proc RmsFollower<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      attack_lag_s = 0.01 => update_attack
      release_lag_s = 0.1 => update_release

    init:
      follower = std::smoothing::LagUD<T>()

    def update_attack():
      follower.rise_lag_s = attack_lag_s

    def update_release():
      follower.fall_lag_s = release_lag_s

    event reset():
      follower.reset()

    sample:
      mean_square = follower(in1 * in1)
      out1 = sqrt(max(mean_square, 0.0))

  proc Compressor<T>:
    ins<T> 2
    outs<T> 2

    params<T>:
      threshold_db = -18.0 => update_threshold
      ratio = 4.0 => update_ratio
      attack_lag_s = 0.01 => update_attack
      release_lag_s = 0.1 => update_release
      knee_db = 6.0 => update_knee
      makeup_db = 0.0 => update_makeup

    init<T>:
      follower = PeakFollower<T>()
      slope = 0.0
      half_knee = 0.0
      knee_divisor = 0.0
      lower_knee = 0.0
      makeup_gain = 1.0

    def update_ratio():
      slope = 1.0 - 1.0 / max(ratio, 1.0)

    def update_knee():
      half_knee = max(knee_db, 0.0) * 0.5
      knee_divisor = 4.0 * half_knee
      update_threshold()

    def update_threshold():
      lower_knee = std::levels::db_to_gain<T>(threshold_db - half_knee)

    def update_makeup():
      makeup_gain = std::levels::db_to_gain<T>(makeup_db)

    def update_attack():
      follower.attack_lag_s = attack_lag_s

    def update_release():
      follower.release_lag_s = release_lag_s

    event reset():
      follower.reset()

    sample:
      detector = follower(max(abs(in1), abs(in2)))
      gain = makeup_gain
      # Keep the detector running while the curve needs no gain reduction.
      if slope != 0.0 && max(detector, T(std::levels::MIN_FLOAT)) > lower_knee:
        level_db = std::levels::gain_to_db<T>(detector)
        reduction_db = std::dynamics::_soft_knee_reduction_db<T>(
          level_db - threshold_db,
          slope,
          half_knee,
          knee_divisor
        )
        gain = std::levels::db_to_gain<T>(makeup_db - reduction_db)
      out1 = in1 * gain
      out2 = in2 * gain

  proc Limiter<T>:
    ins<T> 2
    outs<T> 2

    params<T>:
      ceiling_db = -0.3 => update_ceiling
      release_lag_s = 0.05 => update_release

    init<T>:
      smooth = std::smoothing::LagUD<T>(fall_lag_s = 0.0)
      smooth.reset(1.0)
      ceiling = 1.0

    def update_ceiling():
      ceiling = std::levels::db_to_gain<T>(ceiling_db)

    def update_release():
      smooth.rise_lag_s = release_lag_s

    event reset():
      smooth.reset(1.0)

    sample:
      peak = max(abs(in1), abs(in2))
      if peak > ceiling:
        target_gain = ceiling / peak
      else:
        target_gain = T(1.0)

      gain = smooth(target_gain)
      out1 = in1 * gain
      out2 = in2 * gain

  proc Gate<T>:
    ins<T> 2
    outs<T> 2

    params<T>:
      threshold_db = -48.0 => update_threshold
      attack_lag_s = 0.002 => update_attack
      release_lag_s = 0.08 => update_release

    init<T>:
      threshold = 0.0
      smooth = std::smoothing::LagUD<T>()

    def update_threshold():
      threshold = std::levels::db_to_gain<T>(threshold_db)

    def update_attack():
      smooth.rise_lag_s = attack_lag_s

    def update_release():
      smooth.fall_lag_s = release_lag_s

    event reset():
      smooth.reset()

    sample:
      gain = smooth(T(max(abs(in1), abs(in2)) >= threshold))
      out1 = in1 * gain
      out2 = in2 * gain
