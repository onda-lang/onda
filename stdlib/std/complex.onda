namespace std::complex:
  struct Complex<T>:
    re: T = 0.0
    im: T = 0.0

    def real(self):
      return self.re

    def imag(self):
      return self.im

    def set(self, re, im):
      self.re = re
      self.im = im

    def clear(self):
      self.re = 0.0
      self.im = 0.0

    def copy(self, other: Complex):
      self.re = other.re
      self.im = other.im

    def set_polar(self, magnitude, phase):
      self.re = magnitude * cos(phase)
      self.im = magnitude * sin(phase)

    def add_assign(self, other: Complex):
      self.re += other.re
      self.im += other.im

    def added(self, other: Complex) -> Complex<T>:
      result: Complex<T> = self
      result.add_assign(other)
      return result

    def add_parts(self, re, im):
      self.re += re
      self.im += im

    def sub_assign(self, other: Complex):
      self.re -= other.re
      self.im -= other.im

    def subtracted(self, other: Complex) -> Complex<T>:
      result: Complex<T> = self
      result.sub_assign(other)
      return result

    def sub_parts(self, re, im):
      self.re -= re
      self.im -= im

    def mul_assign(self, other: Complex):
      self.mul_parts(other.re, other.im)

    def multiplied(self, other: Complex) -> Complex<T>:
      result: Complex<T> = self
      result.mul_assign(other)
      return result

    def mul_parts(self, re, im):
      old_re = self.re
      old_im = self.im
      self.re = old_re * re - old_im * im
      self.im = old_re * im + old_im * re

    def scale_assign(self, gain):
      self.re *= gain
      self.im *= gain

    def scaled(self, gain) -> Complex<T>:
      result: Complex<T> = self
      result.scale_assign(gain)
      return result

    def conjugate(self):
      self.im = -self.im

    def conjugated(self) -> Complex<T>:
      result: Complex<T> = self
      result.conjugate()
      return result

    def power(self):
      return self.re * self.re + self.im * self.im

    def magnitude(self):
      return sqrt(self.power())

    def phase(self):
      return atan2(self.im, self.re)

  def polar<T>(magnitude: T, phase: T) -> Complex<T>:
    result = Complex<T>()
    result.set_polar(magnitude, phase)
    return result
