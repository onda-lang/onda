# Fixed-size, multichannel sample storage for building stateful audio algorithms.
# Provides indexed writes, wrapped reads, and interpolation between stored samples.

import std/lookup

namespace std::data<S = SR, C = 1>:
  assert(S > 0)
  assert(C > 0)

  struct Data<T>:
    storage: T[S * C]

    def len(self):
      return self.storage.len()

    def samples(self):
      return i32(S)

    def chans(self):
      return i32(C)

    def _index(self, sample_index: i32, ch_i: i32 = 0):
      index = sample_index {S, wrap}
      channel = ch_i {C, wrap}
      return channel * S + index

    def read(self, sample_index: i32, ch_i: i32 = 0):
      return self.storage[self._index(sample_index, ch_i)]

    def write(self, sample_index: i32, value: T, ch_i: i32 = 0):
      self.storage[self._index(sample_index, ch_i)] = value

    def readL(self, pos, ch_i: i32 = 0):
      pos_floor = floor(pos)
      i0 = i32(pos_floor)
      t = pos - pos_floor
      a = self.read(i0, ch_i)
      b = self.read(i0 + 1, ch_i)
      return a + (b - a) * t

    def readC(self, pos, ch_i: i32 = 0):
      channel = ch_i {C, wrap}
      start = channel * S
      return std::lookup::readCW(self.storage[start:start + S], pos)
