namespace std::noise:
  proc White<T>:
    outs<T> 1

    params<T>:
      amp = 1.0

    init<T>:
      rng = std::random::Rng<T>()

    events:
      seed(value: i64):
        rng.seed(value)

    sample:
      out1 = rng.bipolar() * amp

  proc Pink<T>:
    outs<T> 1

    params<T>:
      amp = 1.0

    init<T>:
      rng = std::random::Rng<T>()
      b0 = 0.0
      b1 = 0.0
      b2 = 0.0

    events:
      seed(value: i64):
        rng.seed(value)
        b0 = 0.0
        b1 = 0.0
        b2 = 0.0

    sample:
      white = rng.bipolar()
      b0 = T(0.99765) * b0 + T(0.0990460) * white
      b1 = T(0.96300) * b1 + T(0.2965164) * white
      b2 = T(0.57000) * b2 + T(1.0526913) * white

      pink = (b0 + b1 + b2 + T(0.1848) * white) * T(0.15)
      out1 = clamp(pink, T(-1.0), T(1.0)) * amp

  proc Brown<T>:
    outs<T> 1

    params<T>:
      amp = 1.0

    init<T>:
      rng = std::random::Rng<T>()
      state = 0.0

    events:
      seed(value: i64):
        rng.seed(value)
        state = 0.0

    sample:
      state = clamp(state + rng.bipolar() * T(0.02), T(-1.0), T(1.0))
      out1 = state * amp
