namespace std::osc:
  # Sine and KSine share an 8,192-point f32 wavetable with linear interpolation.
  # Both use a wrapping 32-bit phase and f32 parameters and outputs.
  # Generic variants require generic const defs and arrays.
  const _SineTableSize = 8192
  const _SineTableBits = 13
  const _SinePhaseBits = 32
  const _SineFractionBits = _SinePhaseBits - _SineTableBits
  const _SineFractionScale = 1 << _SineFractionBits
  const _SineFractionMask = _SineFractionScale - 1
  const _SinePhaseScale = 1 << _SinePhaseBits

  const def _sine_wavetable() -> f32[_SineTableSize * 2]:
    table: f32[_SineTableSize * 2]
    for i in 0.._SineTableSize:
      value = f32(sin(TWO_PI * f64(i) / _SineTableSize))
      next = f32(sin(TWO_PI * f64((i + 1) % _SineTableSize) / _SineTableSize))
      table[i << 1] = value
      table[(i << 1) + 1] = next - value
    return table

  const _SineWavetable = _sine_wavetable()

  def _sine_phase(cycles) -> i32:
    # Float-to-i32 casts saturate; convert through i64, then keep the low 32 bits
    # so phases beyond half a cycle wrap correctly.
    return i32(i64(cycles * _SinePhaseScale))

  def _sine_radians(radians):
    return _sine_phase(radians / TWO_PI)

  def _sine_lookup(phase: i32):
    index = (phase >> _SineFractionBits) & (_SineTableSize - 1)
    fraction = f32(phase & _SineFractionMask) / _SineFractionScale
    pair = index << 1
    value = _SineWavetable.read_unsafe(pair)
    delta = _SineWavetable.read_unsafe(pair + 1)
    return value + delta * fraction

  proc Sine:
    params:
      freq = 440.0 => update_freq
      phase_offset = 0.0 => update_phase_offset

    init:
      phase = 0
      incr = 0
      offset = 0

    def update_freq():
      incr = _sine_phase(freq / SR)

    def update_phase_offset():
      offset = _sine_radians(phase_offset)

    event reset(phase_cycles = 0.0):
      phase = _sine_phase(phase_cycles)

    sample:
      out1 = _sine_lookup(phase + offset)
      phase += incr

  proc KSine:
    params:
      freq = 1.0 => update_freq
      phase_offset = 0.0 => update_phase_offset

    init:
      phase = 0
      incr = 0
      offset = 0

    def update_freq():
      incr = _sine_phase(freq * BS / SR)

    def update_phase_offset():
      offset = _sine_radians(phase_offset)

    event reset(phase_cycles = 0.0):
      phase = _sine_phase(phase_cycles)

    block:
      kout1 = _sine_lookup(phase + offset)
      phase += incr

  proc Phasor<T>:
    outs<T> 1

    params<T>:
      freq = 1.0 => update_freq

    init<T>:
      phase = 0.0
      incr = 0.0

    def update_freq():
      incr = freq / SR

    event reset(phase_cycles: T = 0.0):
      phase = wrap(phase_cycles, T(0.0), T(1.0))

    sample:
      out1 = phase
      phase += incr
      if phase >= 1.0 || phase < 0.0:
        phase = wrap(phase, T(0.0), T(1.0))


  def poly_blep<T>(t: T, dt: T) -> T:
    zero = dt - dt
    if dt <= zero:
      return zero
    one = dt / dt
    if t < dt:
      x = t / dt
      return x + x - x * x - one
    elif t > one - dt:
      x = (t - one) / dt
      return x * x + x + x + one
    return zero

  proc Saw<T>:
    outs<T> 1

    params<T>:
      freq = 440.0 => update_freq

    init<T>:
      phasor = Phasor(freq = freq)
      dt = 0.0

    def update_freq():
      dt = freq / SR
      phasor.freq = freq

    event reset(phase_cycles: T = 0.0):
      phasor.reset(phase_cycles)

    sample:
      phase = phasor()
      base = phase + phase - 1.0
      out1 = (base - poly_blep<T>(phase, dt))

  proc SawDown<T>:
    outs<T> 1

    params<T>:
      freq = 440.0 => update_freq

    init<T>:
      phasor = Phasor(freq = freq)
      dt = 0.0

    def update_freq():
      dt = freq / SR
      phasor.freq = freq

    event reset(phase_cycles: T = 0.0):
      phasor.reset(phase_cycles)

    sample:
      phase = phasor()
      base = 1.0 - phase - phase
      out1 = (base + poly_blep<T>(phase, dt))

  proc Pulse<T>:
    outs<T> 1

    params<T>:
      freq = 440.0 => update_freq
      width = 0.5 {0.001, 0.999} => update_width

    init<T>:
      phasor = Phasor(freq = freq)
      width_v = 0.5
      dt = 0.0

    def update_freq():
      dt = freq / SR
      phasor.freq = freq

    def update_width():
      width_v = width

    event reset(phase_cycles: T = 0.0):
      phasor.reset(phase_cycles)

    sample:
      phase = phasor()
      if phase < width_v:
        wave = T(1.0)
      else:
        wave = T(-1.0)

      phase2 = phase - width_v
      if phase2 < 0.0:
        phase2 += 1.0

      wave += poly_blep<T>(phase, dt)
      wave -= poly_blep<T>(phase2, dt)
      out1 = wave

  proc Square<T>:
    outs<T> 1

    params<T>:
      freq = 440.0 => update_freq

    init:
      pulse = Pulse(freq = freq, width = 0.5)

    def update_freq():
      pulse.freq = freq

    event reset(phase_cycles: T = 0.0):
      pulse.reset(phase_cycles)

    sample:
      out1 = pulse()

  proc Triangle<T>:
    outs<T> 1

    params<T>:
      freq = 440.0 => update_freq

    init<T>:
      pulse = Pulse(freq = freq, width = 0.5)
      tri = -1.0
      dt = 0.0

    def update_freq():
      dt = freq / SR
      pulse.freq = freq

    event reset(phase_cycles: T = 0.0):
      pulse.reset(phase_cycles)
      tri = T(-1.0) + wrap(phase_cycles, T(0.0), T(1.0)) * T(4.0)
      if tri > 1.0:
        tri = T(2.0) - tri

    sample:
      out1 = tri
      tri = clamp(tri + pulse() * dt * T(4.0), T(-1.0), T(1.0))
