namespace std::osc:
  proc Phasor<T>:
    outs<T> 1

    params<T>:
      freq = 1.0 => update_freq

    init<T>:
      phase = 0.0
      incr = 0.0

    def update_freq():
      incr = freq / SR

    event reset(phase_cycles: T = 0.0):
      phase = wrap(phase_cycles, T(0.0), T(1.0))

    sample:
      phase = phase + incr
      if (phase >= 1.0):
        phase = phase - 1.0
      out1 = phase
        
  proc Sine<T>:
    outs<T> 1

    params<T>:
      freq = 440.0
      amp = 1.0
      phase_offset = 0.0

    init:
      phasor = Phasor(freq = freq)

    event reset(phase_cycles: T = 0.0):
      phasor.reset(phase_cycles)

    sample:
      out1 = sin(phasor(freq = freq) * TWO_PI + phase_offset) * amp
  
  def poly_blep<T>(t: T, dt: T) -> T:
    zero = dt - dt
    if dt <= zero:
      return zero
    one = dt / dt
    if t < dt:
      x = t / dt
      return x + x - x * x - one
    elif t > one - dt:
      x = (t - one) / dt
      return x * x + x + x + one
    return zero

  proc Saw<T>:
    outs<T> 1

    params<T>:
      freq = 440.0 => update_freq
      amp = 1.0

    init<T>:
      phasor = Phasor(freq = freq)
      dt = 0.0

    def update_freq():
      dt = freq / SR

    event reset(phase_cycles: T = 0.0):
      phasor.reset(phase_cycles)

    sample:
      phase = phasor(freq = freq)
      base = phase + phase - 1.0
      out1 = (base - std::osc::poly_blep<T>(phase, dt)) * amp

  proc SawDown<T>:
    outs<T> 1

    params<T>:
      freq = 440.0 => update_freq
      amp = 1.0

    init<T>:
      phasor = Phasor(freq = freq)
      dt = 0.0

    def update_freq():
      dt = freq / SR

    event reset(phase_cycles: T = 0.0):
      phasor.reset(phase_cycles)

    sample:
      phase = phasor(freq = freq)
      base = 1.0 - phase - phase
      out1 = (base + std::osc::poly_blep<T>(phase, dt)) * amp

  proc Pulse<T>:
    outs<T> 1

    params<T>:
      freq = 440.0 => update_shape
      width = 0.5 => update_shape
      amp = 1.0

    init<T>:
      phasor = Phasor(freq = freq)
      width_v = 0.5
      dt = 0.0

    def update_shape():
      width_v = clamp(width, T(0.001), T(0.999))
      dt = freq / SR

    event reset(phase_cycles: T = 0.0):
      phasor.reset(phase_cycles)

    sample:
      phase = phasor(freq = freq)
      if (phase < width_v):
        wave = T(1.0)
      else:
        wave = T(-1.0)

      phase2: T = phase - width_v
      if (phase2 < 0.0):
        phase2 = phase2 + 1.0

      wave = wave + std::osc::poly_blep<T>(phase, dt)
      wave = wave - std::osc::poly_blep<T>(phase2, dt)
      out1 = wave * amp

  proc Square<T>:
    outs<T> 1

    params<T>:
      freq = 440.0
      amp = 1.0

    init:
      pulse = Pulse(freq = freq, width = 0.5, amp = amp)

    event reset(phase_cycles: T = 0.0):
      pulse.reset(phase_cycles)

    sample:
      out1 = pulse(freq = freq, amp = amp)

  proc Triangle<T>:
    outs<T> 1

    params<T>:
      freq = 440.0 => update_freq
      amp = 1.0

    init<T>:
      pulse = Pulse(freq = freq, width = 0.5, amp = 1.0)
      tri = -1.0
      dt = 0.0

    def update_freq():
      dt = freq / SR

    event reset(phase_cycles: T = 0.0):
      pulse.reset(phase_cycles)
      tri = T(-1.0) + wrap(phase_cycles, T(0.0), T(1.0)) * T(4.0)
      if tri > 1.0:
        tri = T(2.0) - tri

    sample:
      tri = clamp(tri + pulse(freq = freq) * dt * T(4.0), T(-1.0), T(1.0))
      out1 = tri * amp
