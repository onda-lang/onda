namespace std::env:
  proc DecayEnv<T>:
    outs[T] 1

    params[T]:
      decay_s = 0.2
      trigger = 0.0

    init:
      env: T = 0.0
      prev_trig: T = 0.0

    block:
      coef = exp(-1.0 / max(decay_s * SR, 1.0))
      sample:
        if (trigger > 0.0 && prev_trig <= 0.0):
          env = 1.0
        env = env * coef
        prev_trig = trigger
        out1 = env
