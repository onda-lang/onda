import std/math

namespace std::export_math:
  # Keep these coefficients local for now. Ordinary float literals are currently
  # f32-typed, while builtin PI/TWO_PI are f64, so mixing them in generic helpers
  # is awkward until literal typing/precision is fixed.
  const PI_Q = 3.14159265358979323846
  const HALF_PI_Q = 1.57079632679489661923
  const QUARTER_PI_Q = 0.78539816339744830962
  const TWO_PI_Q = 6.28318530717958647692
  const LN2_Q = 0.69314718055994530942
  const INV_LN2_Q = 1.44269504088896340736
  const ATAN_A_Q = 0.2447
  const ATAN_B_Q = 0.0663

  def _zero(x):
    return x - x

  def _one(x):
    return _zero(x) + 1.0

  def _pi(x):
    return _one(x) * PI_Q

  def _half_pi(x):
    return _one(x) * HALF_PI_Q

  def _quarter_pi(x):
    return _one(x) * QUARTER_PI_Q

  def _two_pi(x):
    return _one(x) * TWO_PI_Q

  def _ln2(x):
    return _one(x) * LN2_Q

  def _inv_ln2(x):
    return _one(x) * INV_LN2_Q

  def _eps(x):
    return _one(x) * 0.000001

  def _wrap_pm_pi(x):
    pi_v = _pi(x)
    return std::math::wrap(x + pi_v, _zero(x), _two_pi(x)) - pi_v

  def _pow2i(n: i32, like):
    result = _one(like)
    i: i32 = 0
    if (n >= 0):
      while (i < n):
        result = result + result
        i = i + 1
      return result

    while (i < -n):
      result = result * 0.5
      i = i + 1
    return result

  def _nearest_i32(x):
    half = _one(x) * 0.5
    value: i32 = 0
    if (x >= _zero(x)):
      value = i32(floor(x + half))
    else:
      value = -i32(floor(-x + half))
    return value

  def sin(x):
    one = _one(x)
    y = _wrap_pm_pi(x)
    b = one * 1.2732395447351627
    c = one * -0.4052847345693511
    p = one * 0.225
    base = b * y + c * y * abs(y)
    return p * (base * abs(base) - base) + base

  def cos(x):
    return std::export_math::sin(x + _half_pi(x))

  def tan(x):
    s = std::export_math::sin(x)
    c = std::export_math::cos(x)
    eps = _eps(x) * 64.0

    if (abs(c) <= eps):
      huge = _one(x) / eps
      if (s >= _zero(x)):
        return huge
      return -huge

    return s / c

  def tanh(x):
    one = _one(x)
    limit = one * 3.0

    if (x > limit):
      return one
    elif (x < -limit):
      return -one

    x2 = x * x
    return x * (27.0 + x2) / (27.0 + 9.0 * x2)

  def atan(x):
    zero = _zero(x)
    one = _one(x)
    half_pi_v = _half_pi(x)
    quarter_pi_v = _quarter_pi(x)
    ax = abs(x)
    a = one * ATAN_A_Q
    b = one * ATAN_B_Q

    if (ax > one):
      t = one / ax
      base = quarter_pi_v * t - t * (abs(t) - one) * (a + b * abs(t))
      if (x >= zero):
        return half_pi_v - base
      return base - half_pi_v

    return quarter_pi_v * x - x * (ax - one) * (a + b * ax)

  def atan2(y, x):
    zero = _zero(y)
    pi_v = _pi(y)
    half_pi_v = _half_pi(y)

    if (x > zero):
      return std::export_math::atan(y / x)
    elif (x < zero):
      if (y >= zero):
        return std::export_math::atan(y / x) + pi_v
      return std::export_math::atan(y / x) - pi_v
    elif (y > zero):
      return half_pi_v
    elif (y < zero):
      return -half_pi_v
    return zero

  def exp(x):
    zero = _zero(x)
    one = _one(x)
    max_x = one * 88.0
    min_x = -max_x
    clamped = x

    if (clamped > max_x):
      clamped = max_x
    elif (clamped < min_x):
      return zero

    k: i32 = std::export_math::_nearest_i32(clamped * _inv_ln2(clamped))
    r = clamped - k * _ln2(clamped)
    c2 = one * 0.5
    c3 = one * 0.16666666666666666
    c4 = one * 0.041666666666666664
    c5 = one * 0.008333333333333333
    c6 = one * 0.001388888888888889
    poly = one + r * (one + r * (c2 + r * (c3 + r * (c4 + r * (c5 + r * c6)))))
    return poly * _pow2i(k, clamped)

  def log(x):
    zero = _zero(x)
    one = _one(x)
    half = one * 0.5
    lower = one * 0.75
    upper = one * 1.5

    if (x <= zero):
      return zero

    m = x
    k: i32 = 0
    while (m > upper):
      m = m * half
      k = k + 1
    while (m < lower):
      m = m + m
      k = k - 1

    z = (m - one) / (m + one)
    z2 = z * z
    c1 = one * 2.0
    c3 = one * 0.6666666666666666
    c5 = one * 0.4
    c7 = one * 0.2857142857142857
    c9 = one * 0.2222222222222222
    series = z * (c1 + z2 * (c3 + z2 * (c5 + z2 * (c7 + z2 * c9))))
    return k * _ln2(x) + series

  def pow(x, y):
    zero = _zero(x)
    one = _one(x)

    if (y == zero):
      return one
    elif (x == zero):
      if (y > zero):
        return zero
      return one
    elif (x > zero):
      return std::export_math::exp(y * std::export_math::log(x))

    yi: i32 = std::export_math::_nearest_i32(y)
    if (abs(y - yi) > _eps(x)):
      return zero

    mag = std::export_math::exp(yi * std::export_math::log(-x))
    if ((yi % 2) == 0):
      return mag
    return -mag
