import std/math

namespace std::export_math:
  const HALF_PI: f64 = PI / 2.0
  const QUARTER_PI: f64 = PI / 4.0
  const LN2: f64 = 0.69314718055994530942
  const INV_LN2: f64 = 1.44269504088896340736
  const EPS: f64 = 0.000001
  const ATAN_A: f64 = 0.2447
  const ATAN_B: f64 = 0.0663

  def _wrap_pm_pi<T>(x: T):
    pi_v = T(PI)
    return std::math::wrap(x + pi_v, T(0), T(TWO_PI)) - pi_v

  def _pow2i<T>(n: i32, like: T):
    result = T(1)
    i: i32 = 0
    if (n >= 0):
      while (i < n):
        result = result + result
        i = i + 1
      return result

    while (i < -n):
      result = result * T(0.5)
      i = i + 1
    return result

  def _nearest_i32<T>(x: T):
    half = T(0.5)
    value: i32 = 0
    if (x >= T(0)):
      value = i32(floor(x + half))
    else:
      value = i32(-floor(-x + half))
    return value

  def sin<T>(x: T):
    y = _wrap_pm_pi(x)
    b = T(1.2732395447351627)
    c = T(-0.4052847345693511)
    p = T(0.225)
    base = b * y + c * y * abs(y)
    return p * (base * abs(base) - base) + base

  def cos<T>(x: T):
    return sin(x + T(HALF_PI))

  def tan<T>(x: T):
    s = sin(x)
    c = cos(x)
    eps = T(EPS) * T(64)

    if (abs(c) <= eps):
      huge = T(1) / eps
      if (s >= T(0)):
        return huge
      return -huge

    return s / c

  def tanh<T>(x: T):
    limit = T(3)

    if (x > limit):
      return T(1)
    elif (x < -limit):
      return T(-1)

    x2 = x * x
    return x * (T(27) + x2) / (T(27) + T(9) * x2)

  def atan<T>(x: T):
    ax = abs(x)
    a = T(ATAN_A)
    b = T(ATAN_B)

    if (ax > T(1)):
      t = T(1) / ax
      base = T(QUARTER_PI) * t - t * (abs(t) - T(1)) * (a + b * abs(t))
      if (x >= T(0)):
        return T(HALF_PI) - base
      return base - T(HALF_PI)

    return T(QUARTER_PI) * x - x * (ax - T(1)) * (a + b * ax)

  def atan2<T>(y: T, x: T):
    if (x > T(0)):
      return atan(y / x)
    elif (x < T(0)):
      if (y >= T(0)):
        return atan(y / x) + T(PI)
      return atan(y / x) - T(PI)
    elif (y > T(0)):
      return T(HALF_PI)
    elif (y < T(0)):
      return T(-HALF_PI)
    return T(0)

  def exp<T>(x: T):
    max_x = T(88)
    min_x = -max_x
    clamped = x

    if (clamped > max_x):
      clamped = max_x
    elif (clamped < min_x):
      return T(0)

    k: i32 = _nearest_i32(clamped * T(INV_LN2))
    r = clamped - T(k) * T(LN2)
    c2 = T(0.5)
    c3 = T(0.16666666666666666)
    c4 = T(0.041666666666666664)
    c5 = T(0.008333333333333333)
    c6 = T(0.001388888888888889)
    poly = T(1) + r * (T(1) + r * (c2 + r * (c3 + r * (c4 + r * (c5 + r * c6)))))
    return poly * _pow2i(k, clamped)

  def log<T>(x: T):
    half = T(0.5)
    lower = T(0.75)
    upper = T(1.5)

    if (x <= T(0)):
      return T(0)

    m = x
    k: i32 = 0
    while (m > upper):
      m = m * half
      k = k + 1
    while (m < lower):
      m = m + m
      k = k - 1

    z = (m - T(1)) / (m + T(1))
    z2 = z * z
    c1 = T(2)
    c3 = T(0.6666666666666666)
    c5 = T(0.4)
    c7 = T(0.2857142857142857)
    c9 = T(0.2222222222222222)
    series = z * (c1 + z2 * (c3 + z2 * (c5 + z2 * (c7 + z2 * c9))))
    return T(k) * T(LN2) + series

  def pow<T>(x: T, y: T):
    if (y == T(0)):
      return T(1)
    elif (x == T(0)):
      if (y > T(0)):
        return T(0)
      return T(1)
    elif (x > T(0)):
      return exp(y * log(x))

    yi: i32 = _nearest_i32(y)
    if (abs(y - T(yi)) > T(EPS)):
      return T(0)

    mag = exp(T(yi) * log(-x))
    if ((yi % 2) == 0):
      return mag
    return -mag
