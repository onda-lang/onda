# Delay lines and echo processors for shifting audio in time and building feedback effects.
# Supports interpolated reads, diffusion, and smooth transitions between delay positions.

import std/data
import std/smoothing

namespace std::delay<Capacity = SR * 2>:
  assert(Capacity > 1)

  struct Line<T>:
    data: std::data<Capacity>::Data<T>
    write_index = 0 {Capacity, wrap}

    def read(self, delay_samples: i32):
      return self.data.read(self.write_index - delay_samples)

    def readL(self, delay_samples: T):
      return self.data.readL(self.write_index - delay_samples)

    def readC(self, delay_samples: T):
      return self.data.readC(self.write_index - delay_samples)

    def write(self, value: T):
      self.data.storage[self.write_index] = value

    def advance(self):
      self.write_index += 1

    def clear(self):
      self.data.storage[:] = 0.0
      self.write_index = 0

  proc Allpass<T>:
    ins<T> 1
    outs<T> 1

    params:
      delay_samples = 1 {1, Capacity - 1, unit = "samples"}
      feedback: T = 0.5 {-0.999, 0.999}

    init:
      line = Line<T>()

    event reset():
      line.clear()

    sample:
      delayed = line.read(delay_samples)
      stored = in1 + delayed * feedback
      line.write(stored)
      line.advance()
      out1 = delayed - stored * feedback

  proc Integer<T>:
    ins<T> 1
    outs<T> 1

    params:
      delay_samples = 1 {0, Capacity - 1, unit = "samples"}

    init:
      line = Line<T>()

    event reset():
      line.clear()

    sample:
      line.write(in1)
      out1 = line.read(delay_samples)
      line.advance()

  proc Linear<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      delay_samples = 1.0 {0.0, Capacity - 2, unit = "samples"}

    init:
      line = Line<T>()

    event reset():
      line.clear()

    sample:
      line.write(in1)
      out1 = line.readL(delay_samples)
      line.advance()

  proc Cubic<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      delay_samples = 1.0 {1.0, Capacity - 3, unit = "samples"}

    init:
      line = Line<T>()

    event reset():
      line.clear()

    sample:
      line.write(in1)
      out1 = line.readC(delay_samples)
      line.advance()

  proc Smooth<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      delay_samples = 1.0 {0.0, Capacity - 2, unit = "samples"}
      lag_s = 0.02 => update_lag

    init<T>:
      line = Line<T>()
      current_delay: f64 = delay_samples
      lag_coefficient: f64 = 0.0

    def update_lag():
      lag_coefficient = std::smoothing::lag_coefficient<T>(lag_s)

    event reset():
      line.clear()
      current_delay = delay_samples

    sample:
      current_delay = delay_samples + (current_delay - delay_samples) * lag_coefficient
      line.write(in1)
      out1 = line.readL(T(current_delay))
      line.advance()

  # Finish each fade before accepting the latest requested tap position.
  struct _CrossfadeTap<T>:
    old_delay: T = 0.0
    target_delay: T = 0.0
    fade_samples: i64 = 0
    elapsed: i64 = 0
    inverse_samples: f64 = 0.0

    def reset(self, delay_samples: T):
      self.old_delay = delay_samples
      self.target_delay = delay_samples
      self.fade_samples = 0
      self.elapsed = 0

    def read(self, line: Line<T>, delay_samples: T, fade_s: T):
      if self.elapsed >= self.fade_samples && delay_samples != self.target_delay:
        self.old_delay = self.target_delay
        self.target_delay = delay_samples
        self.fade_samples = std::smoothing::_duration_samples(fade_s)
        self.elapsed = 0
        self.inverse_samples = 1.0 / max(self.fade_samples, 1)
      if self.elapsed < self.fade_samples:
        self.elapsed += 1
      if self.elapsed >= self.fade_samples:
        return line.readL(self.target_delay)
      weight = T(clamp(self.elapsed * self.inverse_samples, 0.0, 1.0))
      return lerp(line.readL(self.old_delay), line.readL(self.target_delay), weight)

  proc Crossfade<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      delay_samples = 1.0 {0.0, Capacity - 2, unit = "samples"}
      fade_s = 0.02

    init:
      line = Line<T>()
      tap: _CrossfadeTap<T>
      tap.reset(delay_samples)

    event reset():
      line.clear()
      tap.reset(delay_samples)

    sample:
      line.write(in1)
      out1 = tap.read(line, delay_samples, fade_s)
      line.advance()

  proc Delay<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      delay_s = 0.1 {T(1.0) / SR, T(Capacity - 2) / SR, unit = "s"}
      feedback = 0.0 {-0.999, 0.999}
      mix = 1.0 {0.0, 1.0}
      lag_s = 0.02 => update_lag

    init<T>:
      line = Line<T>()
      current_delay: f64 = f64(delay_s) * SR
      lag_coefficient: f64 = 0.0

    def update_lag():
      lag_coefficient = std::smoothing::lag_coefficient<T>(lag_s)

    event reset():
      line.clear()
      current_delay = delay_s * SR

    sample:
      requested_delay = delay_s * SR
      current_delay = requested_delay + (current_delay - requested_delay) * lag_coefficient
      delayed = line.readL(T(current_delay))
      line.write(in1 + delayed * feedback)
      line.advance()
      out1 = lerp(in1, delayed, mix)

  proc CrossfadeDelay<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      delay_s = 0.1 {T(1.0) / SR, T(Capacity - 2) / SR, unit = "s"}
      feedback = 0.0 {-0.999, 0.999}
      mix = 1.0 {0.0, 1.0}
      fade_s = 0.02

    init:
      line = Line<T>()
      tap: _CrossfadeTap<T>
      tap.reset(delay_s * SR)

    event reset():
      line.clear()
      tap.reset(delay_s * SR)

    sample:
      delayed = tap.read(line, delay_s * SR, fade_s)
      line.write(in1 + delayed * feedback)
      line.advance()
      out1 = lerp(in1, delayed, mix)
