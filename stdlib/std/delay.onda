namespace std::delay:
  proc Delay<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      delay_s = 0.1
      feedback = 0.0
      mix = 1.0

    init:
      buf: T[SR * 2]
      write_idx: i32 = 0
      len_i: i32 = buf.len()
      max_d: i32 = len_i - 2

    block:
      delay_samples: T = delay_s * SR
      d: T = clamp(delay_samples, 0.0, T(max_d))
      di0 = i32(d)
      frac: T = d - T(di0)
      sample:
        idx_a: i32 = (write_idx - di0 + len_i) % len_i
        idx_b: i32 = (idx_a - 1 + len_i) % len_i
        a = buf[idx_a]
        b = buf[idx_b]
        delayed = lerp(a, b, frac)
        buf[write_idx] = in1 + delayed * feedback
        write_idx = (write_idx + 1) % len_i
        out1 = in1 * (1.0 - mix) + delayed * mix
