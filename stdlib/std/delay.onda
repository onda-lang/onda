import std/data
import std/smoothing

namespace std::delay<Capacity = SR * 2>:
  assert(Capacity > 3)

  proc Integer<T>:
    ins<T> 1
    outs<T> 1

    params:
      delay_samples = 1 {0, Capacity - 1}

    init:
      data = std::data<Capacity>::Data<T>()
      write_index = 0 {Capacity, wrap}

    event reset():
      data.storage[:] = 0.0
      write_index = 0

    sample:
      data.storage[write_index] = in1
      out1 = data.read(write_index - delay_samples)
      write_index += 1

  proc Linear<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      delay_samples = 1.0 {0.0, Capacity - 2}

    init:
      data = std::data<Capacity>::Data<T>()
      write_index = 0 {Capacity, wrap}

    event reset():
      data.storage[:] = 0.0
      write_index = 0

    sample:
      data.storage[write_index] = in1
      out1 = data.readL(T(write_index) - delay_samples)
      write_index += 1

  proc Cubic<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      delay_samples = 1.0 {1.0, Capacity - 3}

    init:
      data = std::data<Capacity>::Data<T>()
      write_index = 0 {Capacity, wrap}

    event reset():
      data.storage[:] = 0.0
      write_index = 0

    sample:
      data.storage[write_index] = in1
      out1 = data.readC(T(write_index) - delay_samples)
      write_index += 1

  proc Smooth<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      delay_samples = 1.0 {0.0, Capacity - 2}
      transition_s = 0.02 {0.0, 1.0} => update_transition

    init<T>:
      data = std::data<Capacity>::Data<T>()
      write_index = 0 {Capacity, wrap}
      current_delay = delay_samples
      transition_coefficient = 0.0

    def update_transition():
      transition_coefficient = std::smoothing::time_coefficient<T>(transition_s)

    event reset():
      data.storage[:] = 0.0
      write_index = 0
      current_delay = delay_samples

    sample:
      current_delay = delay_samples + (current_delay - delay_samples) * transition_coefficient
      data.storage[write_index] = in1
      out1 = data.readL(T(write_index) - current_delay)

      write_index += 1

  proc Crossfade<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      delay_samples = 1.0 {0.0, Capacity - 2}
      transition_s = 0.02 {0.0, 1.0} => update_transition

    init<T>:
      data = std::data<Capacity>::Data<T>()
      write_index = 0 {Capacity, wrap}
      old_delay = delay_samples
      target_delay = old_delay
      fade = 1.0
      transition_step = 1.0

    def update_transition():
      transition_step = 1.0 / max(transition_s * SR, T(1.0))

    event reset():
      data.storage[:] = 0.0
      write_index = 0
      old_delay = delay_samples
      target_delay = old_delay
      fade = 1.0

    sample:
      requested = delay_samples
      if fade >= 1.0 && requested != target_delay:
        if transition_step >= 1.0:
          old_delay = requested
          target_delay = requested
        else:
          old_delay = target_delay
          target_delay = requested
          fade = 0.0

      data.storage[write_index] = in1
      if fade < 1.0:
        a = data.readL(T(write_index) - old_delay)
        b = data.readL(T(write_index) - target_delay)
        out1 = lerp(a, b, fade)
        fade = min(fade + transition_step, T(1.0))
        if fade >= 1.0:
          old_delay = target_delay
      else:
        out1 = data.readL(T(write_index) - target_delay)

      write_index += 1

  proc Delay<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      delay_s = 0.1 {T(1.0) / SR, T(Capacity - 2) / SR}
      feedback = 0.0 {-0.999, 0.999}
      mix = 1.0 {0.0, 1.0}
      transition_s = 0.02 {0.0, 1.0} => update_transition

    init<T>:
      data = std::data<Capacity>::Data<T>()
      write_index = 0 {Capacity, wrap}
      current_delay = delay_s * SR
      transition_coefficient = 0.0

    def update_transition():
      transition_coefficient = std::smoothing::time_coefficient<T>(transition_s)

    event reset():
      data.storage[:] = 0.0
      write_index = 0
      current_delay = delay_s * SR

    sample:
      requested_delay = delay_s * SR
      current_delay = requested_delay + (current_delay - requested_delay) * transition_coefficient
      delayed = data.readL(T(write_index) - current_delay)
      data.storage[write_index] = in1 + delayed * feedback
      write_index += 1
      out1 = lerp(in1, delayed, mix)

  proc CrossfadeDelay<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      delay_s = 0.1 {T(1.0) / SR, T(Capacity - 2) / SR}
      feedback = 0.0 {-0.999, 0.999}
      mix = 1.0 {0.0, 1.0}
      transition_s = 0.02 {0.0, 1.0} => update_transition

    init<T>:
      data = std::data<Capacity>::Data<T>()
      write_index = 0 {Capacity, wrap}
      old_delay = delay_s * SR
      target_delay = old_delay
      fade = 1.0
      transition_step = 1.0

    def update_transition():
      transition_step = 1.0 / max(transition_s * SR, T(1.0))

    event reset():
      data.storage[:] = 0.0
      write_index = 0
      old_delay = delay_s * SR
      target_delay = old_delay
      fade = 1.0

    sample:
      requested_delay = delay_s * SR
      if fade >= 1.0 && requested_delay != target_delay:
        if transition_step >= 1.0:
          old_delay = requested_delay
          target_delay = requested_delay
        else:
          old_delay = target_delay
          target_delay = requested_delay
          fade = 0.0

      if fade < 1.0:
        a = data.readL(T(write_index) - old_delay)
        b = data.readL(T(write_index) - target_delay)
        delayed = lerp(a, b, fade)
        fade = min(fade + transition_step, T(1.0))
        if fade >= 1.0:
          old_delay = target_delay
      else:
        delayed = data.readL(T(write_index) - target_delay)

      data.storage[write_index] = in1 + delayed * feedback
      write_index += 1
      out1 = lerp(in1, delayed, mix)
