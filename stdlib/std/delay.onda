# Delay lines and echo processors for shifting audio in time and building feedback effects.
# Supports interpolated reads, diffusion, and smooth transitions between delay positions.
# Capacity is at least two. Cubic uses a fixed one-sample tap with up to four slots.
# Delay and CrossfadeDelay use a fixed one-sample tap with up to three slots.
# With two slots, Linear, Smooth, and Crossfade pass the current sample through.
# The upper tap bounds in samples are Capacity - 2 for linear reads,
# max(Capacity - 3, 1) for Cubic, and max(Capacity - 2, 1) for feedback delays.

import std/data
import std/smoothing

namespace std::delay<Capacity = SR * 2>:
  assert(Capacity > 1)

  const _MaxLinearTap = Capacity - 2
  const _MaxCubicTap = max(Capacity - 3, 1)
  const _MaxFeedbackTap = max(_MaxLinearTap, 1)

  struct Line<T>:
    data: std::data<Capacity>::Data<T>
    write_index = 0 {Capacity, wrap}

    def read(self, delay_samples: i32):
      return self.data.read(self.write_index - delay_samples)

    def readL(self, delay_samples: T):
      return self.data.readL(self.write_index - delay_samples)

    def readC(self, delay_samples: T):
      return self.data.readC(self.write_index - delay_samples)

    def write(self, value: T):
      self.data.storage[self.write_index] = value

    def advance(self):
      self.write_index += 1

    def clear(self):
      self.data.storage[:] = 0.0
      self.write_index = 0

  proc Allpass<T>:
    ins<T> 1
    outs<T> 1

    params:
      delay_samples = 1 {1, Capacity - 1, unit = "samples"}
      feedback: T = 0.5 {-0.999, 0.999}

    init:
      line = Line<T>()

    event reset():
      line.clear()

    sample:
      delayed = line.read(delay_samples)
      stored = in1 + delayed * feedback
      line.write(stored)
      line.advance()
      out1 = delayed - stored * feedback

  proc Integer<T>:
    ins<T> 1
    outs<T> 1

    params:
      delay_samples = 1 {0, Capacity - 1, unit = "samples"}

    init:
      line = Line<T>()

    event reset():
      line.clear()

    sample:
      line.write(in1)
      out1 = line.read(delay_samples)
      line.advance()

  proc Linear<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      delay_samples = 1.0 {0.0, _MaxLinearTap, unit = "samples"}

    init:
      line = Line<T>()

    event reset():
      line.clear()

    sample:
      if _MaxLinearTap == 0:
        out1 = in1
      else:
        line.write(in1)
        out1 = line.readL(delay_samples)
        line.advance()

  proc Cubic<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      delay_samples = 1.0 {1.0, _MaxCubicTap, unit = "samples"}

    init:
      line = Line<T>()

    event reset():
      line.clear()

    sample:
      line.write(in1)
      if _MaxCubicTap == 1:
        out1 = line.read(1)
      else:
        out1 = line.readC(delay_samples)
      line.advance()

  proc Smooth<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      delay_samples = 1.0 {0.0, _MaxLinearTap, unit = "samples"}
      lag_s = 0.02 => update_lag

    init:
      line = Line<T>()
      tap = std::smoothing::Lag<T>()
      tap.reset(delay_samples)

    def update_lag():
      tap.lag_s = lag_s

    event reset():
      line.clear()
      tap.reset(delay_samples)

    sample:
      if _MaxLinearTap == 0:
        out1 = in1
      else:
        line.write(in1)
        out1 = line.readL(tap(delay_samples))
        line.advance()

  # Finish each fade before accepting the latest requested tap position.
  struct _CrossfadeTap<T>:
    old_delay: T = 0.0
    target_delay: T = 0.0
    remaining: i64 = 0
    phase_step: T = 0.0

    def reset(self, delay_samples: T):
      self.old_delay = delay_samples
      self.target_delay = delay_samples
      self.remaining = 0

    def read(self, line: Line<T>, delay_samples: T, fade_s: T):
      if self.remaining == 0 && delay_samples != self.target_delay:
        self.old_delay = self.target_delay
        self.target_delay = delay_samples
        self.remaining = std::smoothing::_duration_samples(fade_s)
        self.phase_step = 1.0 / T(max(self.remaining, 1))

      target = line.readL(self.target_delay)
      if self.remaining > 1:
        self.remaining -= 1
        return std::smoothing::_blend_at(
          target,
          line.readL(self.old_delay),
          T(self.remaining) * self.phase_step
        )
      self.remaining = 0
      return target

  proc Crossfade<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      delay_samples = 1.0 {0.0, _MaxLinearTap, unit = "samples"}
      fade_s = 0.02

    init:
      line = Line<T>()
      tap: _CrossfadeTap<T>
      tap.reset(delay_samples)

    event reset():
      line.clear()
      tap.reset(delay_samples)

    sample:
      if _MaxLinearTap == 0:
        out1 = in1
      else:
        line.write(in1)
        out1 = tap.read(line, delay_samples, fade_s)
        line.advance()

  proc Delay<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      delay_s = 0.1 {T(1.0) / SR, T(_MaxFeedbackTap) / SR, unit = "s"}
      feedback = 0.0 {-0.999, 0.999}
      mix = 1.0 {0.0, 1.0}
      lag_s = 0.02 => update_lag

    init:
      line = Line<T>()
      tap = std::smoothing::Lag<T>()
      tap.reset(delay_s * SR)

    def update_lag():
      tap.lag_s = lag_s

    event reset():
      line.clear()
      tap.reset(delay_s * SR)

    sample:
      delayed: T = 0.0
      if _MaxFeedbackTap == 1:
        delayed = line.read(1)
      else:
        delayed = line.readL(tap(delay_s * SR))
      line.write(in1 + delayed * feedback)
      line.advance()
      out1 = std::smoothing::_blend_at(in1, delayed, mix)

  proc CrossfadeDelay<T>:
    ins<T> 1
    outs<T> 1

    params<T>:
      delay_s = 0.1 {T(1.0) / SR, T(_MaxFeedbackTap) / SR, unit = "s"}
      feedback = 0.0 {-0.999, 0.999}
      mix = 1.0 {0.0, 1.0}
      fade_s = 0.02

    init:
      line = Line<T>()
      tap: _CrossfadeTap<T>
      tap.reset(delay_s * SR)

    event reset():
      line.clear()
      tap.reset(delay_s * SR)

    sample:
      delayed: T = 0.0
      if _MaxFeedbackTap == 1:
        delayed = line.read(1)
      else:
        delayed = tap.read(line, delay_s * SR, fade_s)
      line.write(in1 + delayed * feedback)
      line.advance()
      out1 = std::smoothing::_blend_at(in1, delayed, mix)
