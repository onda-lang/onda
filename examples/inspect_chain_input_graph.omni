proc Source {
  ins { in1 }
  outs { out1 }
  sample {
    out1 = in1 + 1.0
  }
}

proc Gain {
  ins { in1 }
  outs { out1 }
  sample {
    out1 = in1 * 2.0
  }
}

ins { in1 }
outs { out1 }

init {
  src = Source()
  gain = Gain()
}

graph {
  in1 >> src.in1
  src.out1 >> gain.in1
  gain.out1 >> out1
}
