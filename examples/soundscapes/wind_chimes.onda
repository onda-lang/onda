import std/delay
import std/env
import std/filter
import std/levels
import std/noise
import std/osc
import std/pitch
import std/random

const VoiceCount = 8
const ScaleLength = 9
const Scale: i32[ScaleLength] = [0, 2, 5, 7, 9, 12, 14, 17, 21]

proc Chime:
  params:
    decay_s = 4.0
    shimmer = 0.7

  init:
    freq = 440.0
    oscillator_1 = std::osc::Sine()
    oscillator_2 = std::osc::Sine()
    oscillator_3 = std::osc::Sine()
    envelope_1 = std::env::DecayEnv()
    envelope_2 = std::env::DecayEnv()
    envelope_3 = std::env::DecayEnv()

  event strike(note: f32, velocity: f32):
    freq = std::pitch::note_to_hz(note)
    oscillator_1.reset()
    oscillator_2.reset()
    oscillator_3.reset()
    envelope_1.start(velocity)
    envelope_2.start(velocity * shimmer)
    envelope_3.start(velocity * shimmer * shimmer)

  sample:
    tone = oscillator_1(freq = freq) * envelope_1(decay_s = decay_s)
    tone = tone + oscillator_2(freq = freq * 2.756) * envelope_2(decay_s = decay_s * 0.58) * 0.42
    tone = tone + oscillator_3(freq = freq * 5.404) * envelope_3(decay_s = decay_s * 0.31) * 0.16
    out1 = tone

params:
  auto_play = true
  root_note = 67 {48, 88}
  density = 0.48 {0.05, 1.0}
  decay_s = 4.2 {0.8, 12.0, unit = "s"}
  shimmer = 0.72 {0.0, 1.0}
  wind = 0.14 {0.0, 0.5}
  space = 0.46 {0.0, 0.8}
  level = 0.5 {0.0, 1.0}

init:
  voices: Chime[VoiceCount] = Chime()
  rng = std::random::Rng()
  air = std::noise::Pink(amp = 1.0)
  air_hp = std::filter::OnePole(cutoff = 420.0, mode = std::filter::mode::ONE_POLE_HIGHPASS)
  air_lp = std::filter::OnePole(cutoff = 4400.0)
  space_l = std::delay::Delay(delay_s = 0.37, feedback = 0.46, mix = 1.0)
  space_r = std::delay::Delay(delay_s = 0.53, feedback = 0.42, mix = 1.0)
  clock = 0
  next_hit = 1
  next_voice = 0
  pans: f32[VoiceCount]
  pending_bang = false

event bang():
  pending_bang = true

sample:
  if auto_play && clock >= next_hit:
    pending_bang = true

  if pending_bang:
    degree = i32(rng.next() * ScaleLength)
    if (degree >= ScaleLength):
      degree = ScaleLength - 1
    velocity = rng.range(0.32, 0.92)
    voices[next_voice].decay_s = decay_s * rng.range(0.78, 1.18)
    voices[next_voice].shimmer = shimmer
    voices[next_voice].strike(root_note + Scale[degree], velocity)
    pans[next_voice] = rng.range(-0.92, 0.92)
    next_voice = (next_voice + 1) % VoiceCount
    wait_s = rng.range(0.12, 1.4) / max(density, 0.05)
    next_hit = max(i32(wait_s * SR), 1)
    clock = 0
    pending_bang = false
  clock = min(clock + 1, next_hit)

  dry_l = 0.0
  dry_r = 0.0
  for i in 0..VoiceCount:
    voice = voices[i]()
    (gain_l, gain_r) = std::levels::pan_3db(pans[i])
    dry_l = dry_l + voice * gain_l
    dry_r = dry_r + voice * gain_r

  breeze = air_lp(air_hp(air())) * wind
  wet_l = space_l(dry_l + dry_r * 0.16 + breeze * 0.18)
  wet_r = space_r(dry_r + dry_l * 0.16 - breeze * 0.18)
  out1 = tanh((dry_l + breeze + wet_l * space) * level)
  out2 = tanh((dry_r - breeze + wet_r * space) * level)
