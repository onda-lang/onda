import std/delay
import std/env
import std/levels
import std/osc
import std/pitch

const VoiceCount = 5
const ScaleLength = 12
const Scale: f32[ScaleLength] = [0.0, 2.0, 3.0, 7.0, 9.0, 12.0, 14.0, 15.0, 19.0, 21.0, 24.0, 26.0]
const Starts: i32[VoiceCount] = [0, 2, 4, 7, 9]
const Leaps: i32[VoiceCount] = [5, 7, 4, 9, 2]

proc GlassBloom:
  params:
    duration_s = 3.1
    brightness = 0.68

  delegate faded(note)

  init:
    current_note = 60.0
    freq = 261.626
    strength = 0.0
    active = false
    carrier = std::osc::Sine()
    modulator = std::osc::Sine()
    high_partial = std::osc::Sine()
    air_partial = std::osc::Sine()
    amplitude = std::env::DecayEnv()

  event strike(note, velocity):
    current_note = note
    freq = std::pitch::note_to_hz(note)
    strength = max(velocity, 0.0)
    carrier.reset()
    modulator.reset()
    high_partial.reset()
    air_partial.reset()
    amplitude.decay_s = duration_s
    amplitude.start()
    active = true

  when amplitude.finished():
    active = false
    faded(current_note)

  sample:
    envelope = amplitude() * strength
    tone = 0.0

    if active:
      modulation = modulator(freq = freq * 1.414) * envelope * (2.0 + brightness * 7.0)
      fundamental = carrier(freq = freq, phase_offset_rad = modulation)
      high = high_partial(freq = freq * 2.756, phase_offset_rad = modulation * 0.24)
      air = air_partial(freq = freq * 5.404, phase_offset_rad = modulation * 0.08)
      tone = (fundamental * 0.68 + high * 0.24 + air * 0.08 * brightness) * envelope

    out1 = tone

params:
  auto_play = true
  root_note = 50 {36, 72}
  pace = 3.1 {0.1, 6.0, unit = "s"}
  brightness = 0.68 {0.0, 1.0}
  space = 0.5 {0.0, 0.8}
  level = 0.7 {0.0, 1.0}

delegate bloom_faded(voice: i32, note)

init:
  blooms: GlassBloom[VoiceCount] = GlassBloom()
  delay_l = std::delay::Delay(delay_s = 0.3, feedback = 0.42, mix = 1.0)
  delay_r = std::delay::Delay(delay_s = 0.5, feedback = 0.38, mix = 1.0)
  steps: i32[VoiceCount]
  pans: f32[VoiceCount]
  previous_auto_play = false
  pending_bang = false
  next_voice = 0

  for i in 0..VoiceCount:
    steps[i] = Starts[i]
    pans[i] = -0.84 + 1.68 * i / (VoiceCount - 1)

event strike(note = 62.0, velocity = 0.72):
  blooms[next_voice].duration_s = pace
  blooms[next_voice].brightness = brightness
  blooms[next_voice].strike(note, velocity)
  next_voice = (next_voice + 1) % VoiceCount

event bang():
  pending_bang = true

when blooms.faded(voice, note):
  bloom_faded(voice, note)

  if auto_play:
    pending_bang = true

sample:
  if auto_play && !previous_auto_play:
    pending_bang = true
  previous_auto_play = auto_play

  if pending_bang:
    velocity = 0.48 + 0.07 * ((steps[next_voice] + next_voice) % 5)
    blooms[next_voice].duration_s = pace
    blooms[next_voice].brightness = brightness
    blooms[next_voice].strike(root_note + Scale[steps[next_voice]], velocity)
    steps[next_voice] = (steps[next_voice] + Leaps[next_voice]) % ScaleLength
    next_voice = (next_voice + 1) % VoiceCount
    pending_bang = false

  dry_l = 0.0
  dry_r = 0.0
  for i in 0..VoiceCount:
    bloom = blooms[i]()
    gain_l, gain_r = std::levels::pan_3db(pans[i])
    dry_l = dry_l + bloom * gain_l
    dry_r = dry_r + bloom * gain_r

  wet_l = delay_l(dry_l + dry_r * 0.18)
  wet_r = delay_r(dry_r + dry_l * 0.18)
  out1 = tanh((dry_l + wet_l * space) * level)
  out2 = tanh((dry_r + wet_r * space) * level)
