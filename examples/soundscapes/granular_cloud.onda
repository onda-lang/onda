import std/levels
import std/pitch
import std/random
include "../effects/processors/effect_audition.onda"

const GrainCount = 16
const TapeSamples = i32(SR * 4)

params:
  auto_play = true
  live_input = false
  freeze = false
  density = 18.0 {2.0, 70.0, scale = log, unit = "grains/s"}
  grain_size = 0.34 {0.025, 1.4, scale = log, unit = "s"}
  scatter = 0.76 {0.0, 1.0}
  pitch = 0.0 {-24.0, 24.0, unit = "st"}
  pitch_jitter = 0.08 {0.0, 0.5}
  feedback = 0.18 {0.0, 0.92}
  wet = 0.8 {0.0, 1.0}
  level = 1.0 {0.0, 1.0}

init:
  tape: f32[TapeSamples]
  write_index = 0
  recorded_samples = 0

  grain_position: f32[GrainCount]
  grain_speed: f32[GrainCount]
  grain_pan: f32[GrainCount]
  grain_age: i32[GrainCount]
  grain_length: i32[GrainCount]
  next_grain = 0
  spawn_clock = 0

  audition = EffectAudition()
  rng = std::random::Rng()

event bang():
  audition.bang()

sample:
  source, _ = audition(auto_play = auto_play)
  if live_input:
    source = in1

  if !freeze:
    tape[write_index] = source + tape[write_index] * feedback
    write_index = (write_index + 1) % TapeSamples
    recorded_samples = min(recorded_samples + 1, TapeSamples)

  if spawn_clock <= 0 && recorded_samples > i32(SR * 0.12):
    available = max(recorded_samples - 4, 1)
    history = (0.08 + rng.next() * scatter * 3.6) * SR
    history = min(history, available)
    position = write_index - history
    if position < 0.0:
      position = position + TapeSamples

    grain_position[next_grain] = position
    grain_speed[next_grain] = std::pitch::ratio_between(0.0, pitch) * rng.range(1.0 - pitch_jitter, 1.0 + pitch_jitter)
    grain_pan[next_grain] = rng.range(-1.0, 1.0) * scatter
    grain_age[next_grain] = 0
    grain_length[next_grain] = max(i32(grain_size * rng.range(0.72, 1.28) * SR), 8)
    next_grain = (next_grain + 1) % GrainCount
    spawn_clock = max(i32(SR / max(density, 1.0)), 1)
  spawn_clock = spawn_clock - 1

  cloud_l = 0.0
  cloud_r = 0.0
  for i in 0..GrainCount:
    if grain_age[i] < grain_length[i]:
      progress = grain_age[i] / f32(max(grain_length[i], 1))
      window = 0.5 - 0.5 * cos(progress * TWO_PI)
      grain_signal = std::lookup::readCW(tape, grain_position[i]) * window
      gain_l, gain_r = std::levels::pan_3db(grain_pan[i])
      cloud_l = cloud_l + grain_signal * gain_l
      cloud_r = cloud_r + grain_signal * gain_r
      grain_position[i] = wrap(grain_position[i] + grain_speed[i], 0.0, TapeSamples)
      grain_age[i] = grain_age[i] + 1

  normalization = 1.0 / sqrt(max(density * grain_size, 1.0))
  out1 = tanh((cloud_l * normalization * wet + source * (1.0 - wet)) * level)
  out2 = tanh((cloud_r * normalization * wet + source * (1.0 - wet)) * level)
