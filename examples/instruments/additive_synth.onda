import std/delay
import std/env
import std/osc
import std/levels
import std/smoothing

const PartialCount = 8
const Notes: f32[16] = [0, 7, 12, 19, 3, 10, 15, 22, 5, 12, 17, 24, 3, 10, 7, 12]
const Velocities: f32[4] = [1.0, 0.55, 0.78, 0.48]

params:
  auto_play = true
  fundamental = 110.0 {30, 2000, scale = log, unit = "Hz"}
  bpm = 104.0 {35, 200, unit = "BPM"}
  decay_s = 1.6 {0.1, 6, unit = "s"}
  brightness = 0.75 {0, 1}
  stretch = 0.012 {0, 0.12}
  motion = 0.65 {0, 1}
  motion_rate = 0.13 {0.01, 2, scale = log, unit = "Hz"}
  space = 0.35 {0, 0.75}
  level = 1.0 {0, 1}
  levels: f32[PartialCount] = [1.0, 0.5, 0.333, 0.25, 0.2, 0.167, 0.143, 0.125] {0, 1}
  ratios: f32[PartialCount] = [1, 2, 3, 4, 5, 6, 7, 8] {0.25, 16}
  detune_cents: f32[PartialCount] = [0, -4, 3, -7, 5, -3, 8, -6] {-50, 50, unit = "cents"}
  pan: f32[PartialCount] = [0, -0.45, 0.45, -0.7, 0.7, -0.3, 0.3, 0.8] {-1, 1}
  enabled: bool[PartialCount] = true

init:
  sines: std::osc::Sine[PartialCount]
  envelopes: std::env::DecayEnv[PartialCount]
  smooth_amplitude: std::smoothing::Lag[PartialCount] = std::smoothing::Lag(time_s = 0.004)
  smooth_left: std::smoothing::Lag[PartialCount] = std::smoothing::Lag(time_s = 0.02)
  smooth_right: std::smoothing::Lag[PartialCount] = std::smoothing::Lag(time_s = 0.02)
  echo_l = std::delay::Delay(delay_s = 0.29, feedback = 0.32, mix = 1.0)
  echo_r = std::delay::Delay(delay_s = 0.43, feedback = 0.28, mix = 1.0)
  partial_ratio: f32[PartialCount]
  left_gain: f32[PartialCount]
  right_gain: f32[PartialCount]
  motion_phase = 0.0
  note_ratio = 1.0
  clock = 0
  step = 0
  pending_bang = false

event bang():
  pending_bang = true

block:
  step_samples = max(i32(SR * 30.0 / bpm), 1)
  motion_phase = (motion_phase + motion_rate * BS / SR) % 1.0
  total_level = 0.0
  for i in 0..PartialCount:
    if enabled[i]:
      total_level += levels[i]
  gain = 1.0 / max(1.0, total_level)

  for i in 0..PartialCount:
    # Stretch separates the upper partials from exact integer multiples.
    partial_ratio[i] = ratios[i] * (1.0 + stretch * i * i) * pow(2.0, detune_cents[i] / 1200.0)
    envelopes[i].decay_s = decay_s / (1.0 + i * 0.45)
    shimmer = 0.5 + 0.5 * sin(TWO_PI * (motion_phase + i * 0.17))
    spectral_gain = pow(brightness, i * 0.35) * lerp(1.0, 0.25 + 0.75 * shimmer, motion)
    amplitude = 0.0
    if enabled[i]:
      amplitude = levels[i] * gain * spectral_gain
    gain_l, gain_r = std::levels::pan_3db(pan[i])
    left_gain[i] = amplitude * gain_l
    right_gain[i] = amplitude * gain_r

  sample:
    if auto_play && clock == 0:
      pending_bang = true
    if pending_bang:
      note_ratio = pow(2.0, Notes[step] / 12.0)
      for i in 0..PartialCount:
        envelopes[i].start(Velocities[step % Velocities.len()])
      step = (step + 1) % Notes.len()
      pending_bang = false
    clock = (clock + 1) % step_samples

    left = 0.0
    right = 0.0
    for i in 0..PartialCount:
      frequency = fundamental * note_ratio * partial_ratio[i]
      # Fade partials near Nyquist, including stretched and transposed ones.
      band_gain = clamp((SR * 0.5 - frequency) / (SR * 0.05), 0.0, 1.0)
      tone = sines[i](freq = min(frequency, SR * 0.5))
      tone *= smooth_amplitude[i](envelopes[i]()) * band_gain
      left += tone * smooth_left[i](left_gain[i])
      right += tone * smooth_right[i](right_gain[i])

    wet_l = echo_l(left + right * 0.15)
    wet_r = echo_r(right + left * 0.15)
    out1 = (left + wet_l * space) * level
    out2 = (right + wet_r * space) * level
