import std/delay
import std/env
import std/filter
import std/osc
import std/pitch
import std/random
import std/smoothing

const LineCount = 4
const Capacity = i32(SR * 0.04) + 4
const Intervals: f32[LineCount] = [0.0, 7.0, 12.0, 19.0]
const Phrase: f32[8] = [0.0, 0.0, 3.0, 7.0, 0.0, -5.0, 3.0, -2.0]

params:
  auto_play = true
  root_note = 43 {31, 67}
  bpm = 76.0 {30.0, 180.0, unit = "BPM"}
  bow = 0.7 {0.0, 1.0}
  excitation = 0.2 {0.0, 1.0}
  feedback = 0.98 {0.0, 1.15}
  coupling = 0.3 {0.0, 1.0}
  tension = 0.4 {0.0, 1.0}
  damping = 4800.0 {600.0, 14000.0, scale = log, unit = "Hz"}
  level = 0.6 {0.0, 1.0}

init:
  lines: std::delay<Capacity>::Line<f32>[LineCount]
  dampers: std::filter::OnePole<f32>[LineCount]
  followers: std::smoothing::Lag<f32>[LineCount]
  tuning: std::smoothing::Lag<f32>[LineCount]
  envelopes: std::env::AR<f32>[LineCount]
  exciters: std::osc::Saw<f32>[LineCount]
  frequencies: f32[LineCount]
  energy: f32[LineCount]
  clock = 0
  step = 0
  transpose_ratio = 1.0
  strike_left = 0
  pending_bang = false
  rng = std::random::Rng()
  dc_l = std::filter::DCBlock()
  dc_r = std::filter::DCBlock()
  rng.seed(473)
  for i in 0..LineCount:
    tuning[i].lag_s = 0.08
    followers[i].lag_s = 0.04
    envelopes[i].attack_s = 0.04 + i * 0.07
    envelopes[i].release_s = 1.3 + i * 0.2
    tuning[i].reset(SR / (2.0 * std::pitch::note_to_hz(root_note + Intervals[i])))

event bang():
  pending_bang = true

block:
  step_samples = max(i32(SR * 120.0 / bpm), 1)
  rotation_c = cos(coupling * PI * 0.25)
  rotation_s = sin(coupling * PI * 0.25)
  for i in 0..LineCount:
    dampers[i].cutoff = damping
    frequencies[i] = std::pitch::note_to_hz(root_note + Intervals[i])

  sample:
    if auto_play && clock == 0:
      transpose_ratio = std::pitch::ratio_from_semitones(Phrase[step])
      step = (step + 1) % Phrase.len()
      pending_bang = true
    clock = (clock + 1) % step_samples
    if pending_bang:
      strike_left = i32(SR * 0.003)
      for i in 0..LineCount:
        envelopes[i].start()
      pending_bang = false

    strike = 0.0
    if strike_left > 0:
      strike = rng.bipolar() * 0.15
      strike_left -= 1

    taps: f32[LineCount]
    for i in 0..LineCount:
      frequency = frequencies[i] * transpose_ratio
      stretch = 1.0 + tension * energy[(i + 1) % LineCount] * 0.08
      delay_samples = tuning[i](SR / (2.0 * frequency * stretch))
      taps[i] = lines[i].readL(delay_samples)

    a = taps[0] * rotation_c + taps[1] * rotation_s
    b = taps[1] * rotation_c - taps[0] * rotation_s
    c = taps[2] * rotation_c + taps[3] * rotation_s
    d = taps[3] * rotation_c - taps[2] * rotation_s
    scattered: f32[LineCount] = [
      a * rotation_c + c * rotation_s,
      b * rotation_c + d * rotation_s,
      c * rotation_c - a * rotation_s,
      d * rotation_c - b * rotation_s
    ]
    for i in 0..LineCount:
      pressure = envelopes[i]()
      gain = feedback + bow * pressure * 0.12
      returning = -dampers[i](scattered[i])
      driven = exciters[i](freq = frequencies[i] * transpose_ratio) * pressure + strike
      lines[i].write(tanh(returning * gain + driven * excitation))
      lines[i].advance()
      energy[i] = followers[i](taps[i] * taps[i])

    out1 = dc_l(tanh((taps[0] + taps[1] - taps[2] - taps[3]) * 0.5) * level)
    out2 = dc_r(tanh((taps[0] - taps[1] - taps[2] + taps[3]) * 0.5) * level)
