import std/delay
import std/filter

params:
  inject = 0.014 {0.0, 0.08}
  pitch_hz = 20.0 {0.0, 880.0}
  coupling = 0.72 {0.0, 0.98}
  regen = 0.78 {0.0, 0.94}
  drive = 1.45 {0.5, 2.8}
  bias = 0.03 {-0.35, 0.35}
  tone = 4200.0 {180.0, 16000.0}
  spread = 0.42 {0.0, 1.0}
  wet = 1.0 {0.0, 1.0}
  level = 0.72 {0.0, 1.0}
  
proc CyberCell<T>:
  ins<T>:
    src
    fb

  outs<T> 1
  
  params<T>:
    drive = 1.0
    bias = 0.0
    
  sample 32:
    x = (src + fb + bias) * drive
    y = x - x * x * x * 0.18
    out1 = clamp(y, -1.0, 1.0)

init:
  cell_a = CyberCell<f64>()
  cell_b = CyberCell<f64>()

  smear_a = std::delay::Delay<f64>(delay_s = 0.031, feedback = 0.78, mix = 1.0)
  smear_b = std::delay::Delay<f64>(delay_s = 0.047, feedback = 0.74, mix = 1.0)

  tone_a = std::filter::OnePole<f64>(cutoff = 4200.0)
  tone_b = std::filter::OnePole<f64>(cutoff = 3600.0)

graph:
  drive >> cell_a.drive
  drive * (0.96 + spread * 0.10) >> cell_b.drive
  bias >> cell_a.bias
  -bias >> cell_b.bias

  inject * (1.0 + spread * 0.35) >> cell_a.src
  inject * (1.0 - spread * 0.25) >> cell_b.src

  tone_b.out1 * coupling >>[1] cell_a.fb
  tone_a.out1 * coupling >>[1] cell_b.fb

  1.0 / max(pitch_hz, 0.1) >> smear_a.delay_s
  1.0 / max(pitch_hz * (1.0 + spread * 0.012), 0.1) >> smear_b.delay_s
  regen >> smear_a.feedback
  regen * (0.97 - spread * 0.08) >> smear_b.feedback

  cell_a.out1 >> smear_a.in1
  cell_b.out1 >> smear_b.in1

  max(tone, pitch_hz * (8.0 + spread * 6.0)) >> tone_a.cutoff
  max(tone * (0.84 - spread * 0.16), pitch_hz * (7.0 + spread * 5.0)) >> tone_b.cutoff

  smear_a.out1 >> tone_a.in1
  smear_b.out1 >> tone_b.in1

  tanh(f32(cell_a.out1 * (1.0 - wet) + tone_a.out1 * wet) * level * 0.5) >> out1
  tanh(f32(cell_b.out1 * (1.0 - wet) + tone_b.out1 * wet) * level * 0.5) >> out2
