import std/filter
import std/osc
import std/random

const Neurons = 14
const Oversample = 4

struct Connections:
  weights: f32[Neurons]
  excitation: f32
  bias_weight: f32

params:
  neuron_hz = 1800.0 {1.0, 12000.0, scale = log, unit = "Hz"}
  excitation_hz = 41.0 {1.0, 3000.0, scale = log, unit = "Hz"}
  excitation_amount = 0.0 {0.0, 1.0}
  feedback = 0.8 {0.0, 3.0}
  resonant_feedback = 1.4 {0.0, 3.0}
  resonance_hz = 240.0 {20.0, 8000.0, scale = log, unit = "Hz"}
  resonance_q = 2.5 {0.5, 8.0}
  drive = 1.8 {0.1, 8.0}
  bias = 0.0 {-1.0, 1.0}
  motion_hz = 0.13 {0.01, 10.0, scale = log, unit = "Hz"}
  motion_depth = 0.12 {0.0, 1.0}
  noise_amount = 0.001 {0.0, 0.1}
  left_neuron: i32 = 0 {0, Neurons - 1}
  right_neuron: i32 = 7 {0, Neurons - 1}
  stereo_width = 1.0 {0.0, 1.0}
  level = 1.0 {0.0, 1.0}

init:
  neuron: f32[Neurons]
  next_neuron: f32[Neurons]
  resonant: f32[Neurons]
  connections: Connections[Neurons]
  filters: std::filter::Svf[Neurons]
  motion: std::osc::Sine[Neurons]
  excitation = std::osc::Saw()
  dc_l = std::filter::OnePole(mode = std::filter::mode::ONE_POLE_HIGHPASS, cutoff = 10.0)
  dc_r = std::filter::OnePole(mode = std::filter::mode::ONE_POLE_HIGHPASS, cutoff = 10.0)
  rng = std::random::Rng()
  rng.seed(90731)

  # Normalize each row's energy so feedback gain is meaningful as size changes.
  # All weights are built once; only state and signals change during playback.
  for n in 0..Neurons:
    energy = 0.0
    for j in 0..Neurons:
      connections[n].weights[j] = rng.bipolar()
      energy += connections[n].weights[j] * connections[n].weights[j]
    normalization = 1.0 / sqrt(max(energy, 0.000001))
    for j in 0..Neurons:
      connections[n].weights[j] *= normalization
    connections[n].excitation = rng.bipolar()
    connections[n].bias_weight = rng.bipolar()
    neuron[n] = rng.bipolar() * 0.01
    filters[n].mode = std::filter::mode::SVF_BANDPASS
    motion[n].reset(f32(n) / Neurons)

block:
  neuron_coefficient = 1.0 - exp(-TWO_PI * neuron_hz / (SR * Oversample))
  for n in 0..Neurons:
    position = f32(n) / (Neurons - 1)
    # Spread resonances over roughly an octave to avoid one identical loop tone.
    frequency = min(resonance_hz * pow(2.0, position - 0.5), SR * 0.4)
    filters[n].update_coeffs(frequency, resonance_q)
    motion[n].freq = motion_hz * (1.0 + position * 0.37)
  excitation.freq = excitation_hz

  sample Oversample:
    injected = excitation() * excitation_amount

    for n in 0..Neurons:
      coupled = 0.0
      for j in 0..Neurons:
        coupled += connections[n].weights[j] * neuron[j]
      signal = (
        coupled * feedback + resonant[n] * resonant_feedback +
        injected * connections[n].excitation + bias * connections[n].bias_weight +
        motion[n]() * motion_depth + rng.bipolar() * noise_amount
      )
      target = tanh(signal * drive)
      next_neuron[n] = neuron[n] + (target - neuron[n]) * neuron_coefficient

    for n in 0..Neurons:
      neuron[n] = next_neuron[n]
      # Divide by Q for unity gain at each resonator's centre frequency. Q changes
      # selectivity and ringing instead of multiplying the nominal loop gain.
      resonant[n] = filters[n](neuron[n]) / resonance_q

    left = dc_l(neuron[left_neuron])
    right = dc_r(neuron[right_neuron])
    mid = (left + right) * 0.5
    side = (left - right) * 0.5 * stereo_width
    
    out1 = tanh(mid + side) * 0.8 * level
    out2 = tanh(mid - side) * 0.8 * level
