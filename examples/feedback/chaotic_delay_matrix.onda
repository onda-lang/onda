import std/delay
import std/env
import std/filter
import std/osc
import std/random
import std/smoothing

proc SineDistortion:
  sample 4:
    out1 = sin(in1)

const LineCount = 4
const Capacity = i32(SR * 0.7) + 4
const Times: f32[LineCount] = [0.0137, 0.0211, 0.0317, 0.0473]
const Thresholds: f32[LineCount] = [0.12, 0.2, 0.16, 0.25]

params:
  auto_play = true
  memory = 0.4 {0.2, 4.0, scale = log}
  drive = 2.8 {0.5, 8.0}
  excitation = 0.3 {0.0, 1.0}
  warp = 0.7 {0.0, 1.0}
  recovery_s = 0.3 {0.02, 2.0, scale = log, unit = "s"}
  inhibition = 0.9 {0.0, 1.0}
  tone = 2800.0 {200.0, 14000.0, scale = log, unit = "Hz"}
  level = 0.5 {0.0, 1.0}

init:
  lines: std::delay<Capacity>::Line<f32>[LineCount]
  distortions: SineDistortion[LineCount]
  dampers: std::filter::OnePole<f32>[LineCount]
  washouts: std::filter::OnePole<f32>[LineCount]
  followers: std::smoothing::Lag<f32>[LineCount]
  energy: f32[LineCount]
  resting: bool[LineCount]
  strike_left = 0
  clock = 0
  pending_bang = auto_play
  rng = std::random::Rng()
  chirp = std::osc::Sine()
  envelope = std::env::DecayEnv(decay_s = 0.2)
  dc_l = std::filter::DCBlock()
  dc_r = std::filter::DCBlock()
  rng.seed(1279)
  for i in 0..LineCount:
    washouts[i].mode = std::filter::OnePoleMode::HighPass
    washouts[i].cutoff = 25.0

event bang():
  pending_bang = true

block:
  period = max(i32(SR * 1.7), 1)
  for i in 0..LineCount:
    dampers[i].cutoff = tone
    followers[i].lag_s = recovery_s * (1.0 + i * 0.23)

  sample:
    if auto_play && clock == 0:
      envelope.start()
      chirp.reset()
    clock = (clock + 1) % period
    if pending_bang:
      strike_left = i32(SR * 0.002)
      envelope.start()
      chirp.reset()
      pending_bang = false
    burst = envelope()
    injected = chirp(freq = 150.0 + burst * 1100.0) * burst
    if strike_left > 0:
      injected += rng.bipolar() * 0.4
      strike_left -= 1

    taps: f32[LineCount]
    for i in 0..LineCount:
      stretch = 1.0 + warp * (energy[(i + 1) % LineCount] * 3.0 - 0.5)
      delay_samples = clamp(Times[i] * memory * stretch * SR, 1.0, Capacity - 2)
      taps[i] = lines[i].readL(delay_samples)

    scattered: f32[LineCount] = [
      taps[0] * 0.8 + taps[1] * 0.6,
      taps[2] * 0.6 + taps[3] * 0.8,
      taps[2] * 0.8 - taps[3] * 0.6,
      taps[0] * 0.6 - taps[1] * 0.8
    ]
    for i in 0..LineCount:
      fatigue = energy[i] + energy[(i + 2) % LineCount] * 0.15
      if fatigue > Thresholds[i]:
        resting[i] = true
      elif fatigue < Thresholds[i] * 0.2:
        resting[i] = false
      gain = drive
      if resting[i]:
        gain *= 1.0 - inhibition * 0.95
      returning = washouts[i](dampers[i](scattered[i]))
      seed = 0.0
      if auto_play:
        seed = rng.bipolar() * 0.00001
      lines[i].write(distortions[i](returning * gain + (injected + seed) * excitation))
      lines[i].advance()
      energy[i] = followers[i](taps[i] * taps[i])

    out1 = dc_l((taps[0] + taps[2]) * 0.5 * level)
    out2 = dc_r((taps[1] - taps[3]) * 0.5 * level)
