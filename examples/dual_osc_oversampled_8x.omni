def add_phase(p, inc):
  tau = f32(TWO_PI)
  next = p + inc
  if (next >= tau):
    next = next - tau
  return next

proc DualOsc:
  params:
    frequency = 110.0
    modDepth = 1.5
    detune = 1.0

  init:
    phaseA = 0.0
    phaseB = 0.0
    lastA = 0.0
    lastB = 0.0

  sample:
    tau = f32(TWO_PI)
    incA = frequency * tau / SR
    incB = (frequency + detune) * tau / SR

    phaseA = add_phase(phaseA, incA)
    phaseB = add_phase(phaseB, incB)

    currentA = sin(phaseA + (lastB * modDepth))
    currentB = sin(phaseB + (lastA * modDepth))

    out1 = currentA
    out2 = currentB

    lastA = currentA
    lastB = currentB

params:
  frequency = 110.0 { 1, 1000 }
  modDepth = 1.5 { 1, 50 }
  detune = 1.0 { 0, 300 }

init:
  osc = DualOsc(frequency = frequency, modDepth = modDepth, detune = detune)

block:
  osc.frequency = frequency
  osc.modDepth = modDepth
  osc.detune = detune

  sample:
    osc()
    out1 = osc.out1
    out2 = osc.out2
