import processors/spectral_delay
include "../effects/processors/effect_audition.onda"

params:
  auto_play = true
  live_input = false
  delay_s = 0.34 {0.03, SpectralDelayCapacityS, scale = log, unit = "s"}
  slope = 0.78 {0.0, 1.0}
  feedback = 0.42 {0.0, 0.9}
  stereo = 0.68 {0.0, 1.0}
  mix = 0.72 {0.0, 1.0}
  level = 1.0 {0.0, 1.0}

init:
  spectral_delay = SpectralDelay::Engine()
  audition = EffectAudition()

event bang():
  audition.bang()

sample:
  source, _ = audition(auto_play = auto_play)
  if live_input:
    source = in1

  delayed_l, delayed_r = spectral_delay(
    source,
    delay_s = delay_s,
    slope = slope,
    feedback = feedback,
    stereo = stereo
  )

  out1 = tanh((source * (1.0 - mix) + delayed_l * mix) * level)
  out2 = tanh((source * (1.0 - mix) + delayed_r * mix) * level)
