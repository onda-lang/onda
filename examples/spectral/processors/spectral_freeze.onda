import std/fft
import std/pitch
import std/random

namespace SpectralFreeze<N = 1024>:
  proc Engine:
    params:
      freeze = true
      transpose = 0.0
      smear = 0.22

    init:
      analysis = std::fft<N>::RealFFT()
      synthesis_l = std::fft<N>::RealIFFT()
      synthesis_r = std::fft<N>::RealIFFT()
      magnitudes: f32[N]
      previous_phase: f32[N]
      deviations: f32[N]
      phase_l: f32[N]
      phase_r: f32[N]
      drift: f32[N]
      spectrum_re_l: f32[N]
      spectrum_im_l: f32[N]
      spectrum_re_r: f32[N]
      spectrum_im_r: f32[N]
      rng = std::random::Rng()
      configured = false
      history_ready = false
      has_capture = false
      was_frozen = false
      capture_pending = false
      capture_wait = 0

    event recapture():
      capture_pending = true
      capture_wait = N + (N >> 1)

    block:
      if !configured:
        for k in 0..N:
          drift[k] = rng.bipolar()
        configured = true

      ratio = std::pitch::ratio_between(0.0, transpose)

      sample:
        capture_wait = max(capture_wait - 1, 0)
        if analysis.push(in1):
          half = N >> 1
          for k in 0..(half + 1):
            spectrum_re_l[k] = 0.0
            spectrum_im_l[k] = 0.0
            spectrum_re_r[k] = 0.0
            spectrum_im_r[k] = 0.0

          capturing = !freeze || ((!has_capture || capture_pending || !was_frozen) && capture_wait == 0)
          reset_phase = !history_ready || (freeze && capturing) || (was_frozen && !freeze)
          for k in 0..(half + 1):
            phase = analysis.phase(k)
            nominal = PI * (k & 1)
            if capturing:
              magnitudes[k] = analysis.magnitude(k)
              deviations[k] = 0.0
              if history_ready:
                deviations[k] = wrap(phase - previous_phase[k] - nominal, -PI, PI)
            previous_phase[k] = phase

            if reset_phase:
              phase_l[k] = phase
              phase_r[k] = phase
            else:
              advance = PI * wrap(k * ratio, 0.0, 2.0) + deviations[k] * ratio
              spread = drift[k] * smear * 0.045
              phase_l[k] = wrap(phase_l[k] + advance + spread, -PI, PI)
              phase_r[k] = wrap(phase_r[k] + advance - spread, -PI, PI)

            destination = i32(k * ratio + 0.5)
            if destination >= 0 && destination <= half:
              amplitude = magnitudes[k]
              spectrum_re_l[destination] = spectrum_re_l[destination] + cos(phase_l[k]) * amplitude
              spectrum_im_l[destination] = spectrum_im_l[destination] + sin(phase_l[k]) * amplitude
              spectrum_re_r[destination] = spectrum_re_r[destination] + cos(phase_r[k]) * amplitude
              spectrum_im_r[destination] = spectrum_im_r[destination] + sin(phase_r[k]) * amplitude

          if capturing && history_ready:
            has_capture = true
            capture_pending = false
          history_ready = true
          was_frozen = freeze
          synthesis_l.load_complex(spectrum_re_l, spectrum_im_l)
          synthesis_r.load_complex(spectrum_re_r, spectrum_im_r)

        out1 = synthesis_l.tick()
        out2 = synthesis_r.tick()
