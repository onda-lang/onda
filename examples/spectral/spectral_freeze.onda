import std/delay
import processors/spectral_freeze
include "../effects/processors/effect_audition.onda"

params:
  auto_play = true
  live_input = false
  freeze = true
  transpose = 0 {-24, 24, unit = "st"}
  smear = 0.22 {0.0, 1.0}
  width = 0.72 {0.0, 1.0}
  mix = 0.86 {0.0, 1.0}
  space = 0.28 {0.0, 0.72}
  level = 1.0 {0.0, 1.0}

init:
  freezer = SpectralFreeze<1024>::Engine()
  audition = EffectAudition()
  space_l = std::delay::Delay(delay_s = 0.31, feedback = 0.34, mix = 1.0)
  space_r = std::delay::Delay(delay_s = 0.43, feedback = 0.31, mix = 1.0)

event recapture():
  freezer.recapture()

event bang():
  audition.bang()
  freezer.recapture()

block:
  freezer.freeze = freeze
  freezer.transpose = transpose
  freezer.smear = smear

  sample:
    dry_l, dry_r = audition(auto_play = auto_play)
    if live_input:
      dry_l = in1
      dry_r = in2

    mono = (dry_l + dry_r) * 0.5
    frozen_out_l, frozen_out_r = freezer(mono)
    frozen_mid = (frozen_out_l + frozen_out_r) * 0.5
    frozen_side = (frozen_out_l - frozen_out_r) * 0.5 * width
    frozen_l = frozen_mid + frozen_side
    frozen_r = frozen_mid - frozen_side

    wet_l = space_l(frozen_l + frozen_r * 0.14)
    wet_r = space_r(frozen_r + frozen_l * 0.14)
    cloud_l = frozen_l + wet_l * space
    cloud_r = frozen_r + wet_r * space
    out1 = tanh((dry_l * (1.0 - mix) + cloud_l * mix) * level)
    out2 = tanh((dry_r * (1.0 - mix) + cloud_r * mix) * level)
