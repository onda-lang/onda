import std/osc

# Paper-inspired recurrent neural synth:
# - 4 audio inputs + 3 control inputs in the early configuration
# - compile-time-instantiated neuron/input counts via namespace params
# - sigmoid neurons, direct feedback, and phase-shifted band feedback

namespace neural_synth<Neurons = 14, AudioInputs = 4, ControlInputs = 3, Oversample = 4>:
  assert(Neurons > 1)
  assert(AudioInputs > 0)
  assert(ControlInputs > 0)

  const TotalInputs = AudioInputs + ControlInputs

  def clamp_idx(i, max_i):
    if i < 0:
      return 0
    if i > max_i:
      return max_i
    return i

  def hash_i32(a: i32, b: i32, c: i32):
    x: i32 = a * 1103515245 + b * 12345 + c * 265443576
    x = x ^ (x >> 13)
    x = x * 1664525 + 1013904223
    return x

  def signed_weight(a: i32, b: i32, salt: i32):
    h = hash_i32(a + 1, b + 17, salt)
    mag_bits = (h >> 1) & 3
    mag = 1.0 + f32(mag_bits) * 0.5
    if (h & 1) == 0:
      return -mag
    return mag

  def neuron_bias(i: i32):
    h = hash_i32(i + 11, 7, 31337)
    raw = f32((h >> 2) & 255) / 255.0
    return (raw * 2.0 - 1.0) * 0.35

  proc Core:
    ins TotalInputs
    outs 2

    params:
      drive = 1.8 {0.1, 8.0}
      feedback = 0.68 {0.0, 1.25}
      band_feedback = 0.42 {0.0, 1.25}
      band_hz = 240.0 {10.0, 12000.0}
      band_damp = 0.18 {0.0, 1.0}
      audio_bias = 0.0 {-1.0, 1.0}
      control_gain = 5.0 {0.0, 24.0}
      control_slew_hz = 4.0 {0.1, 40.0}
      noise = 0.002 {0.0, 0.05}
      output_a: i32 = 0
      output_b: i32 = 1
      stereo_spread = 0.35 {0.0, 1.0}
      level = 0.25 {0.0, 1.0}

    init:
      neuron: f32[Neurons]
      next_neuron: f32[Neurons]
      band_lp: f32[Neurons]
      band_bp: f32[Neurons]
      audio_dc: f32[AudioInputs]
      control_env: f32[ControlInputs]
      noise_phase = 0.0

      for i in 0..Neurons:
        seed = f32(i + 1)
        neuron[i] = sin(seed * 1.6180339) * 0.001
        next_neuron[i] = 0.0
        band_lp[i] = 0.0
        band_bp[i] = 0.0

      for i in 0..AudioInputs:
        audio_dc[i] = 0.0

      for i in 0..ControlInputs:
        control_env[i] = 0.0

    sample Oversample:
      tau = f32(TWO_PI)
      eff_sr = SR * f32(Oversample)
      audio_dc_coeff = min(f32(30.0) * tau / eff_sr, f32(1.0))
      control_coeff = min(control_slew_hz * tau / eff_sr, f32(1.0))
      band_coeff = min(band_hz * tau / eff_sr, f32(0.5))

      audio_in: f32[AudioInputs]
      ctrl_in: f32[ControlInputs]

      for i in 0..AudioInputs:
        raw = ins[i]
        audio_dc[i] = audio_dc[i] + (raw - audio_dc[i]) * audio_dc_coeff
        audio_in[i] = raw - audio_dc[i] + audio_bias

      for i in 0..ControlInputs:
        raw = ins[AudioInputs + i]
        if raw < f32(0.0):
          raw = -raw
        control_env[i] = control_env[i] + (raw - control_env[i]) * control_coeff
        ctrl_in[i] = control_env[i] * control_gain

      noise_phase = noise_phase + 0.7548777
      if noise_phase > f32(1024.0):
        noise_phase = noise_phase - f32(1024.0)
      thermal_kick = sin(noise_phase * f32(12.9898)) * noise

      for n in 0..Neurons:
        sum = neuron_bias(n) + thermal_kick * signed_weight(n, 0, 997)

        for i in 0..AudioInputs:
          sum = sum + audio_in[i] * signed_weight(n, i, 101) * (0.85 / f32(AudioInputs))

        for i in 0..ControlInputs:
          sum = sum + ctrl_in[i] * signed_weight(n, i, 211) * (1.35 / f32(ControlInputs))

        for j in 0..Neurons:
          sum = sum + neuron[j] * signed_weight(n, j, 307) * (feedback / f32(Neurons))
          sum = sum + band_bp[j] * signed_weight(n, j, 401) * (band_feedback / f32(Neurons))

        local_drive = drive * (f32(1.0) + neuron_bias(n) * f32(0.08))
        next_neuron[n] = tanh(sum * local_drive)

      for n in 0..Neurons:
        hp = next_neuron[n] - band_lp[n] - band_bp[n] * band_damp
        band_bp[n] = band_bp[n] + hp * band_coeff
        band_lp[n] = band_lp[n] + band_bp[n] * band_coeff
        neuron[n] = next_neuron[n]

      ia = clamp_idx(output_a, Neurons - 1)
      ib = clamp_idx(output_b, Neurons - 1)

      mix = 0.0
      for n in 0..Neurons:
        mix = mix + neuron[n]
      mix = mix / f32(Neurons)

      out_a = neuron[ia]
      out_b = neuron[ib]

      out1 = (out_a * (f32(1.0) - stereo_spread) + mix * stereo_spread) * level
      out2 = (out_b * (f32(1.0) - stereo_spread) + mix * stereo_spread) * level

namespace Paper = neural_synth<14, 4, 3, 16>

params:
  pitch = 41.0 {0, 1000.0}
  detune = 1.013 {0, 10}
  drive = 1.8 {0.1, 8.0}
  feedback = 0.68 {0.0, 1.25}
  band_feedback = 0.42 {0.0, 1.25}
  band_hz = 240.0 {10.0, 12000.0}
  band_damp = 0.18 {0.0, 1.0}
  audio_bias = 0.0 {-1.0, 1.0}
  control_gain = 5.0 {0.0, 24.0}
  control_slew_hz = 4.0 {0.1, 40.0}
  noise = 0.002 {0.0, 0.05}
  output_a: i32 = 0
  output_b: i32 = 1
  stereo_spread = 0.35 {0.0, 1.0}
  level = 0.25 {0.0, 1.0}

init:
  src1 = std::osc::Saw(freq = pitch)
  src2 = std::osc::Sine(freq = pitch * detune)
  src3 = std::osc::Sine(freq = pitch * 0.501)
  src4 = std::osc::Saw(freq = pitch * 0.249)

  ctrl1 = std::osc::Phasor(freq = 0.21)
  ctrl2 = std::osc::Sine(freq = 0.083)
  ctrl3 = std::osc::Sine(freq = 0.013)

  net = Paper::Core()

block:
  src1.freq = pitch
  src2.freq = pitch * detune
  src3.freq = pitch * 0.501
  src4.freq = pitch * 0.249

  net.drive = drive
  net.feedback = feedback
  net.band_feedback = band_feedback
  net.band_hz = band_hz
  net.band_damp = band_damp
  net.audio_bias = audio_bias
  net.control_gain = control_gain
  net.control_slew_hz = control_slew_hz
  net.noise = noise
  net.output_a = output_a
  net.output_b = output_b
  net.stereo_spread = stereo_spread
  net.level = level

  sample:
    c1 = ctrl1() * f32(2.0) - f32(1.0)
    c2 = ctrl2()
    c3 = ctrl3()

    net(src1(), src2(), src3(), src4(), c1, c2, c3)
    out1 = net.out1
    out2 = net.out2
