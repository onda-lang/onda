params:
  decay = 0.996

struct KS:
  delay: f32[SR]
  delay_len: f32 = 240.0
  write_idx: f32
  next_idx: f32
  y0: f32
  y1: f32
  yn: f32
  seed: f32 = 0.2137

  def init(self):
    self.delay[0] = 1

  def next(self, d = 0.996):
    return (self.delay[self.write_idx] + self.delay[self.next_idx]) * 0.5 * d

init:
  ks = KS()
  ks.init()

sample:
  ks.next_idx = ks.write_idx + 1.0
  if (ks.next_idx >= ks.delay_len):
    ks.next_idx = 0.0

  ks.y0 = ks.delay[ks.write_idx]
  ks.y1 = ks.delay[ks.next_idx]
  ks.yn = ks.next(d = decay)

  ks.delay[ks.write_idx] = ks.yn
  ks.write_idx = ks.next_idx
  out1 = ks.y0
