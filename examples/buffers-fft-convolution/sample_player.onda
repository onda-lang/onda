buffers:
  clip: f32[]

params:
  speed = 1.0 {0.25, 4.0, log, "x"}

init:
  playhead = 0.0
  playing = false

event play(enabled: bool = true):
  playing = enabled
  if enabled:
    playhead = 0.0

block:
  clip_frames = clip.len()
  clip_channels = clip.chans()
  clip_step = speed * clip.samplerate() / HOST_SR

  sample:
    left = 0.0
    right = 0.0

    if playing:
      if playhead >= f32(clip_frames):
        playing = false
      else:
        clip_frame = i32(playhead)
        if clip_channels > 0:
          left = clip[0, clip_frame]
          right = left
        if clip_channels > 1:
          right = clip[1, clip_frame]
        playhead = playhead + clip_step

    out1 = left
    out2 = right
