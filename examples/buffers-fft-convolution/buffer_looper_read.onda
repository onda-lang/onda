buffers:
  src: f32[]

params:
  rate = 1.0 { 0.0, 4.0 }

init:
  pos = 0.0

block:
  frames = src.len()
  chans = src.chans()
  speed = rate * src.samplerate() / samplerate

  sample:
    if chans > 0:
      out1 = src.readLW(0, pos)
    if chans > 1:
      out2 = src.readLW(1, pos)

    pos = wrap(pos + speed, 0.0, f32(frames))
