import std/osc

outs:
  out1

init:
  freq_state = 220.0
  amp_state = 0.0
  gate = false
  osc = std::osc::Sine(freq = 220.0)

events:
  note_on(freq_hz: f32, amp: i32):
    freq_state = freq_hz
    amp_state = amp
    gate = true

  note_off():
    gate = false

sample:
  osc.freq = freq_state

  out1 = 0.0
  if (gate):
    out1 = osc() * amp_state
