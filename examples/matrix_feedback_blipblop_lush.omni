import std/delay
import std/filter
import std/osc

outs 2

params:
  drive = 0.72 {0.3, 1.5}
  spray = 0.22 {0.0, 1.0}
  density = 0.28 {0.0, 1.0}
  damp = 0.14 {0.02, 0.45}
  cutoff = 5200.0 {180.0, 17000.0}
  ping: i32 = 3200 {64, 16000}

def sat(x):
  return clamp(x - 0.10 * x * x * x, -1.0, 1.0)

init:
  o1 = std::osc::Sine<f32>(freq = 67.0)
  o2 = std::osc::Saw<f32>(freq = 91.0)
  o3 = std::osc::Sine<f32>(freq = 113.0)
  o4 = std::osc::Saw<f32>(freq = 149.0)

  m1 = std::osc::Phasor<f32>(freq = 0.006)
  m2 = std::osc::Phasor<f32>(freq = 0.009)
  m3 = std::osc::Phasor<f32>(freq = 0.014)

  d1 = std::delay::Delay<f32>(delay_s = 0.061, feedback = 0.56, mix = 1.0)
  d2 = std::delay::Delay<f32>(delay_s = 0.074, feedback = 0.54, mix = 1.0)
  d3 = std::delay::Delay<f32>(delay_s = 0.089, feedback = 0.52, mix = 1.0)
  d4 = std::delay::Delay<f32>(delay_s = 0.103, feedback = 0.50, mix = 1.0)

  src1 = std::filter::OnePole<f32>(cutoff = 2200.0)
  src2 = std::filter::OnePole<f32>(cutoff = 2600.0)
  src3 = std::filter::OnePole<f32>(cutoff = 2400.0)
  src4 = std::filter::OnePole<f32>(cutoff = 2800.0)

  lp_l = std::filter::OnePole<f32>(cutoff = 5200.0)
  lp_r = std::filter::OnePole<f32>(cutoff = 4700.0)

  fb1: f32 = 0.0
  fb2: f32 = 0.0
  fb3: f32 = 0.0
  fb4: f32 = 0.0
  fb1_lp: f32 = 0.0
  fb2_lp: f32 = 0.0
  fb3_lp: f32 = 0.0
  fb4_lp: f32 = 0.0
  burst_left: i32 = 0
  burst_env: f32 = 0.0
  n: i32 = 0

sample:
  tau = f32(TWO_PI)
  p1 = m1()
  p2 = m2()
  p3 = m3()

  ma = sin(p1 * tau)
  mb = sin((p1 * 0.7 + p2) * tau + 1.3)
  mc = sin((p2 * 0.4 + p3) * tau + 2.2)

  mod_a = 0.5 + 0.5 * ma
  mod_b = 0.5 + 0.5 * mb
  mod_c = 0.5 + 0.5 * mc

  o1.freq = 58.0 + 58.0 * mod_a
  o2.freq = 72.0 + 64.0 * mod_b
  o3.freq = 93.0 + 70.0 * mod_c
  o4.freq = 111.0 + 74.0 * (0.5 + 0.5 * sin((p1 + p2 + p3) * tau))

  d1.feedback = 0.44 + 0.12 * mod_a
  d2.feedback = 0.42 + 0.12 * mod_b
  d3.feedback = 0.40 + 0.12 * mod_c
  d4.feedback = 0.39 + 0.12 * (1.0 - mod_a)

  d1.delay_s = 0.052 + 0.018 * mod_a
  d2.delay_s = 0.066 + 0.016 * mod_b
  d3.delay_s = 0.082 + 0.014 * mod_c
  d4.delay_s = 0.097 + 0.012 * (1.0 - mod_b)

  src1.cutoff = 1500.0 + 1200.0 * mod_a
  src2.cutoff = 1700.0 + 1300.0 * mod_b
  src3.cutoff = 1600.0 + 1200.0 * mod_c
  src4.cutoff = 1800.0 + 1300.0 * mod_a

  hit: f32 = 0.0
  stride_a: i32 = ping / 2 + 37
  stride_b: i32 = ping / 3 + 59
  if ((n % ping) == 0):
    hit = hit + spray
  if ((n % stride_a) == 0 && (ma + mb * 0.6 > 1.28)):
    hit = hit + spray * 0.25
  if ((n % stride_b) == 0 && (ma * 0.6 + mb * 0.5 + mc * 0.4 > 1.02)):
    burst_left = 30
    burst_env = 1.0
    hit = hit + spray * 0.18

  if (burst_left > 0):
    burst_left = burst_left - 1
    burst_env = burst_env * 0.978
    hit = hit + burst_env * density * 0.20

  n = n + 1

  s1 = src1(o1() * 0.20)
  s2 = src2(o2() * 0.18)
  s3 = src3(o3() * 0.20)
  s4 = src4(o4() * 0.18)

  x1 = sat((s1 + fb2 * (0.48 + 0.07 * ma) - fb4 * (0.16 + 0.03 * mb) + hit) * drive)
  x2 = sat((s2 + fb3 * (0.46 - 0.06 * mb) + fb1 * (0.15 + 0.03 * mc) + hit * 0.40) * drive)
  x3 = sat((s3 + fb4 * (0.44 + 0.06 * mc) - fb2 * (0.14 + 0.03 * ma) + hit * 0.28) * drive)
  x4 = sat((s4 + fb1 * (0.47 - 0.06 * ma) + fb3 * (0.15 + 0.04 * mb) + hit * 0.22) * drive)

  y1 = d1(x1)
  y2 = d2(x2)
  y3 = d3(x3)
  y4 = d4(x4)

  fb1_lp = fb1_lp + damp * (y1 - fb1_lp)
  fb2_lp = fb2_lp + damp * (y2 - fb2_lp)
  fb3_lp = fb3_lp + damp * (y3 - fb3_lp)
  fb4_lp = fb4_lp + damp * (y4 - fb4_lp)
  fb1 = fb1_lp
  fb2 = fb2_lp
  fb3 = fb3_lp
  fb4 = fb4_lp

  lp_l.cutoff = cutoff
  lp_r.cutoff = cutoff * 0.92
  left = sat((y1 + y3 * 0.66 + (y2 - y4) * 0.21) * 0.64)
  right = sat((y2 + y4 * 0.66 + (y1 - y3) * 0.21) * 0.64)
  out1 = lp_l(left)
  out2 = lp_r(right)

