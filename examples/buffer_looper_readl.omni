import std/lookup

buffers:
  src: f32[]

params:
  rate = 1.0 { 0.0, 4.0 }

init:
  pos = 0.0

block:
  frames = src.len()
  chans = src.chans()

  sample:
    if chans > 0:
      out1 = std::lookup::readL(src, 0, pos)
    if chans > 1:
      out2 = std::lookup::readL(src, 1, pos)

    pos = pos + rate
    while pos >= frames:
      pos = pos - frames
