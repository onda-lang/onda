params:
  freq_a = 220.0
  freq_b = 330.0
  fm_ab = 120.0
  fm_ba = 80.0

struct Voice:
  phase: f32
  sig: f32
  inst: f32

  def process(self, phase_offset = 0.0):
    self.sig = sin(self.phase + phase_offset)

def wrap_phase(p, upper = TWO_PI):
  if (p > upper):
    return p - upper
  return p

def mix_voices(a, b, blend = 0.5):
  return (a.sig * blend + b.sig * (1.0 - blend))

init:
  a = Voice()
  b = Voice()

sample:
  a.process()
  b.process()

  a.inst = freq_a + b.sig * fm_ab
  b.inst = freq_b + a.sig * fm_ba

  a.phase = wrap_phase(p = a.phase + a.inst * TWO_PI / SR)
  b.phase = wrap_phase(p = b.phase + b.inst * TWO_PI / SR)

  out1 = mix_voices(a, b)
