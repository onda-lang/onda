def wrap_idx(i, n):
  if (i < 0.0):
    return i + n
  if (i >= n):
    return i - n
  return i

proc Comb:
  ins:
    in1

  outs:
    out1

  params:
    delay = 1695
    feedback = 0.95
    damp = 0.5

  init:
    line: f32[SR * 3]
    idx: f32 = 0.0
    size: f32 = SR * 3
    lp: f32 = 0.0

  sample:
    read_idx: f32 = wrap_idx(idx - delay, size)
    delayed: f32 = line[read_idx]
    lp = delayed * (1.0 - damp) + lp * damp
    line[idx] = in1 + lp * feedback
    idx = idx + 1.0
    if (idx >= size):
      idx = 0.0
    out1 = delayed

proc Allpass:
  ins:
    in1

  outs:
    out1

  params:
    delay = 245.0
    feedback = 0.9

  init:
    line: f32[SR * 3]
    idx: f32 = 0.0
    size: f32 = SR * 3

  sample:
    read_idx: f32 = wrap_idx(idx - delay, size)
    buf_out: f32 = line[read_idx]
    y: f32 = buf_out - in1 * feedback
    line[idx] = in1 + y * feedback
    idx = idx + 1.0
    if (idx >= size):
      idx = 0.0
    out1 = y

proc Impulse:
  event bang():
    x = 1.0

  init:
    x = 0.0

  sample:
    out1 = x
    x = 0.0

proc SchroederReverb:
  ins:
    in1

  outs:
    out1

  init:
    c1 = Comb(delay = 1695, feedback = 0.925, damp = 0.28)
    c2 = Comb(delay = 1760, feedback = 0.937, damp = 0.30)
    c3 = Comb(delay = 1624, feedback = 0.915, damp = 0.27)
    c4 = Comb(delay = 1548, feedback = 0.905, damp = 0.26)
    a1 = Allpass(delay = 245.0, feedback = 0.70)
    a2 = Allpass(delay = 605.0, feedback = 0.70)

  sample:
    csum: f32 = c1(in1) + c2(in1) + c3(in1) + c4(in1)
    ap1: f32 = a1(csum * 0.25)
    out1 = a2(ap1)

outs:
  out1

event bang():
  impulse.bang()

init:
  impulse = Impulse()
  rev = SchroederReverb()

sample:
  out1 = rev(impulse())
