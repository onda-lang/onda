import std/delay
import std/filter
import std/osc

const FlangerCapacity = i32(SR * 0.05)

params:
  rate = 0.17 {0.01, 3.0, log, "Hz"}
  base_ms = 1.2 {0.2, 8.0, unit = "ms"}
  depth_ms = 5.5 {0.1, 12.0, unit = "ms"}
  feedback = 0.62 {-0.88, 0.88}
  crossfeed = 0.35 {0.0, 1.0}
  tone = 7200.0 {500.0, 18000.0, log, "Hz"}
  drive = 1.25 {1.0, 3.0}
  mix = 0.5 {0.0, 1.0}
  level = 0.9 {0.0, 1.0}

init:
  line_l = std::delay<FlangerCapacity>::Line()
  line_r = std::delay<FlangerCapacity>::Line()
  lfo_l = std::osc::Sine()
  lfo_r = std::osc::Sine()
  feedback_tone_l = std::filter::OnePole()
  feedback_tone_r = std::filter::OnePole()

block:
  lfo_l.freq = rate
  lfo_r.freq = rate * 1.031
  feedback_tone_l.cutoff = tone
  feedback_tone_r.cutoff = tone * 0.93

  sample:
    sweep_l = lfo_l() * 0.5 + 0.5
    sweep_r = lfo_r(phase_offset = PI * 0.5) * 0.5 + 0.5
    delay_l = clamp((base_ms + depth_ms * sweep_l) * SR * 0.001, 1.0, f32(FlangerCapacity - 2))
    delay_r = clamp((base_ms + depth_ms * sweep_r) * SR * 0.001, 1.0, f32(FlangerCapacity - 2))
    wet_l = line_l.readL(delay_l)
    wet_r = line_r.readL(delay_r)

    colored_l = feedback_tone_l(wet_l)
    colored_r = feedback_tone_r(wet_r)
    feedback_l = lerp(colored_l, colored_r, crossfeed)
    feedback_r = lerp(colored_r, colored_l, crossfeed)
    line_l.write(in1 + tanh(feedback_l * drive) * feedback)
    line_r.write(in2 + tanh(feedback_r * drive) * feedback)
    line_l.advance()
    line_r.advance()

    out1 = lerp(in1, wet_l, mix) * level
    out2 = lerp(in2, wet_r, mix) * level
