import std/delay
import std/filter
import std/osc

outs 2

params:
  drive = 1.25 {0.5, 2.5}
  spray = 0.65 {0.0, 1.0}
  cutoff = 7200.0 {100.0, 18000.0}
  ping: i32 = 1536 {8192}

def sat(x):
  return clamp(x - 0.28 * x * x * x, -1.0, 1.0)

def fold(x):
  y = x
  if (y > 1.0):
    y = 2.0 - y
  elif (y < -1.0):
    y = -2.0 - y
  return y

init:
  o1 = std::osc::Saw[f32](freq = 95.0)
  o2 = std::osc::Saw[f32](freq = 141.0)
  o3 = std::osc::Sine[f32](freq = 203.0)
  o4 = std::osc::Sine[f32](freq = 257.0)
  chaos = std::osc::Phasor[f32](freq = 0.17)

  d1 = std::delay::Delay[f32](delay_s = 0.041, feedback = 0.86, mix = 1.0)
  d2 = std::delay::Delay[f32](delay_s = 0.053, feedback = 0.84, mix = 1.0)
  d3 = std::delay::Delay[f32](delay_s = 0.067, feedback = 0.83, mix = 1.0)
  d4 = std::delay::Delay[f32](delay_s = 0.079, feedback = 0.81, mix = 1.0)

  lp_l = std::filter::OnePole[f32](cutoff = 7200.0)
  lp_r = std::filter::OnePole[f32](cutoff = 6400.0)

  fb1: f32 = 0.0
  fb2: f32 = 0.0
  fb3: f32 = 0.0
  fb4: f32 = 0.0
  n: i32 = 0

sample:
  ph = chaos()
  l1 = sin(ph * TWO_PI)
  l2 = sin(ph * TWO_PI * 1.73 + 0.7)
  l3 = sin(ph * TWO_PI * 2.41 + 1.9)
  l4 = sin(ph * TWO_PI * 3.17 + 2.6)

  o1.freq = 55.0 + 42.0 * (l1 + 1.0)
  o2.freq = 73.0 + 54.0 * (l2 + 1.0)
  o3.freq = 97.0 + 66.0 * (l3 + 1.0)
  o4.freq = 121.0 + 77.0 * (l4 + 1.0)

  s1 = o1() * 0.22
  s2 = o2() * 0.20
  s3 = o3() * 0.24
  s4 = o4() * 0.21

  imp: f32 = 0.0
  if ((n % ping) == 0):
    imp = spray
  n = n + 1

  x1 = sat((s1 + fb2 * (0.74 + 0.20 * l1) - fb4 * 0.41 + imp) * drive)
  x2 = sat((s2 + fb3 * (0.66 - 0.18 * l2) + fb1 * 0.27) * drive)
  x3 = sat((s3 + fb4 * (0.71 + 0.13 * l3) - fb2 * 0.29) * drive)
  x4 = sat((s4 + fb1 * (0.69 - 0.16 * l4) + fb3 * 0.33) * drive)

  y1 = d1(x1)
  y2 = d2(x2)
  y3 = d3(x3)
  y4 = d4(x4)

  fb1 = y1
  fb2 = y2
  fb3 = y3
  fb4 = y4

  lp_l.cutoff = cutoff
  lp_r.cutoff = cutoff * 0.93

  left = fold((y1 + y3 * 0.8 + (y2 - y4) * 0.35) * 0.9)
  right = fold((y2 + y4 * 0.8 + (y1 - y3) * 0.35) * 0.9)
  out1 = lp_l(left)
  out2 = lp_r(right)
