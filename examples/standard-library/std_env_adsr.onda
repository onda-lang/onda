import std/env
import std/osc

params:
  freq = 220.0 {20.0, 2000.0}
  attack_s = 0.01 {0.0, 2.0}
  decay_s = 0.15 {0.0, 2.0}
  sustain = 0.35 {0.0, 1.0}
  release_s = 0.25 {0.0, 4.0}

init:
  gate = 0.0
  osc = std::osc::Saw(freq = freq)
  env = std::env::ADSR(
    attack_s = attack_s,
    decay_s = decay_s,
    sustain = sustain,
    release_s = release_s,
    gate = gate,
  )

events:
  note_on():
    gate = 1.0

  note_off():
    gate = 0.0

sample:
  osc.freq = freq
  env.attack_s = attack_s
  env.decay_s = decay_s
  env.sustain = sustain
  env.release_s = release_s
  env.gate = gate
  out1 = osc() * env() * 0.2
