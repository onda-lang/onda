import std/osc
import std/smoothing

params:
  freq = 110.0 {20.0, 880.0}
  target = 0.0 {1.0}
  attack_s = 0.02 {0.0, 1.0}
  release_s = 0.15 {0.0, 2.0}

init:
  osc = std::osc::Saw(freq = freq, amp = 0.2)
  amp = std::smoothing::LagUD(attack_s = attack_s, release_s = release_s)

sample:
  osc.freq = freq
  amp.attack_s = attack_s
  amp.release_s = release_s
  out1 = osc() * amp(target)
