import std/osc

params:
  freq = 110.0 {20.0, 880.0}
  pulse_width = 0.3 {0.05, 0.95}

init:
  square = std::osc::Square(freq = freq, amp = 0.18)
  pulse = std::osc::Pulse(freq = freq * 1.5, width = pulse_width, amp = 0.12)
  down = std::osc::SawDown(freq = freq * 0.5, amp = 0.1)
  tri = std::osc::Triangle(freq = freq * 0.75, amp = 0.08)

sample:
  square.freq = freq
  pulse.freq = freq * 1.5
  pulse.width = pulse_width
  down.freq = freq * 0.5
  tri.freq = freq * 0.75
  out1 = square() + pulse() + down() + tri()
