import std/sample

buffers:
  clip: f32[]

params:
  speed = 1.0 {0.25, 4.0, scale = log}
  level = 1.0 {0.0, 1.0}

init:
  player = std::sample::Player(clip = clip)

events:
  play(start_frame = 0.0):
    player.play(start_frame)

  stop():
    player.stop()

sample:
  left, right = player(speed = speed)
  out1 = left * level
  out2 = right * level
