import std/sample

buffers:
  clip: f32[]

params:
  speed = 1.0 {0.25, 4.0, log, "x"}

delegate playback_finished()

init:
  player = std::sample::Player(clip = clip)

events:
  play(start_frame: f32 = 0.0):
    player.play(start_frame)

  stop():
    player.stop()

when player.finished():
  playback_finished()

sample:
  out1, out2 = player(speed = speed)
