import std/sample

buffers:
  clip: f32[]

params:
  speed = 1.0 {0.25, 4.0, scale = log}
  level = 1.0 {0.0, 1.0}

init:
  player = std::sample::Player<f64, f32>(clip = clip)

events:
  play(start_frame: f64 = 0.0):
    player.play(start_frame)

  stop():
    player.stop()

sample:
  left, right = player(speed = speed)
  out1 = f32(left * level)
  out2 = f32(right * level)
