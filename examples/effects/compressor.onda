import std/env
import std/filter
import std/noise
import std/osc
import processors/compressor

params:
  auto_play: i32 = 1 {0, 1, step = 1}
  live_input: i32 = 0 {0, 1, step = 1}
  threshold_db = -18.0 {-48.0, 0.0, unit = "dB"}
  ratio = 4.0 {1.0, 20.0}
  attack_ms = 8.0 {0.1, 100.0, log, "ms"}
  release_ms = 120.0 {10.0, 1000.0, log, "ms"}
  knee_db = 6.0 {0.0, 18.0, unit = "dB"}
  makeup_db = 2.0 {0.0, 18.0, unit = "dB"}
  mix = 1.0 {0.0, 1.0}
  level = 1.0 {0.0, 1.0}

init:
  comp = StereoCompressor()
  kick = std::osc::Sine(freq = 58.0)
  noise = std::noise::White(amp = 1.0)
  noise_tone = std::filter::OnePole(cutoff = 4800.0)
  low_tone = std::filter::OnePole(cutoff = 900.0)
  envelope = std::env::DecayEnv(decay_s = 0.023)
  tick: i32 = 0
  step: i32 = 0
  pending_bang = false

event bang():
  pending_bang = true

sample:
  interval = max(i32(SR * 0.25), 1)
  if auto_play != 0 && tick == 0:
    pending_bang = true

  if pending_bang:
    kick.reset()
    envelope.start()
    step = (step + 1) & 3
    pending_bang = false
  tick = (tick + 1) % interval

  env_level = envelope()
  transient = kick() * env_level * 0.84
  if ((step & 1) == 1):
    transient = transient + noise_tone(noise()) * env_level * env_level * 0.32
  bed = 0.0
  if auto_play != 0:
    bed = low_tone(noise()) * 0.05
  audition_source = transient + bed

  dry_l = in1
  dry_r = in2
  if live_input == 0:
    dry_l = audition_source
    dry_r = audition_source

  comp.threshold_db = threshold_db
  comp.ratio = ratio
  comp.attack_ms = attack_ms
  comp.release_ms = release_ms
  comp.knee_db = knee_db
  comp.makeup_db = makeup_db
  comp(dry_l, dry_r)
  out1 = (dry_l * (1.0 - mix) + comp.out1 * mix) * level
  out2 = (dry_r * (1.0 - mix) + comp.out2 * mix) * level
