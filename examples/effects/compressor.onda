import processors/compressor
import processors/effect_audition

params:
  auto_play = true
  live_input = false
  threshold_db = -18.0 {-48.0, 0.0, unit = "dB"}
  ratio = 4.0 {1.0, 20.0}
  attack_lag_ms = 8.0 {0.1, 100.0, scale = log, unit = "ms"}
  release_lag_ms = 120.0 {10.0, 1000.0, scale = log, unit = "ms"}
  knee_db = 6.0 {0.0, 18.0, unit = "dB"}
  makeup_db = 2.0 {0.0, 18.0, unit = "dB"}
  mix = 1.0 {0.0, 1.0}
  level = 0.8 {0.0, 1.0}

init:
  comp = StereoCompressor()
  audition = EffectAudition()

event bang():
  audition.bang()

sample:
  dry_l, dry_r = audition(auto_play = auto_play)
  if live_input:
    dry_l = in1
    dry_r = in2

  comp.threshold_db = threshold_db
  comp.ratio = ratio
  comp.attack_lag_ms = attack_lag_ms
  comp.release_lag_ms = release_lag_ms
  comp.knee_db = knee_db
  comp.makeup_db = makeup_db
  wet_l, wet_r = comp(dry_l, dry_r)
  out1 = (dry_l * (1.0 - mix) + wet_l * mix) * level
  out2 = (dry_r * (1.0 - mix) + wet_r * mix) * level
