import std/delay
import std/filter
import std/pitch_shift
import processors/effect_audition

params:
  auto_play = true
  live_input = 0.0 {0.0, 1.0, step = 1.0}
  time_s = 0.5 {0.01, 2.0, unit = "s"}
  feedback = 0.5 {0.0, 0.95}
  shimmer = 0.3 {0.0, 0.8}
  shift = 12.0 {0.0, 24.0, unit = "st"}
  window_s = 0.1 {0.01, 0.5, log, unit = "s"}
  mix = 0.5 {0.0, 1.0}
  level = 1.0 {0.0, 1.0}

init:
  audition = EffectAudition()
  delay_l = std::delay<SR * 3>::Delay(
    delay_s = time_s,
    feedback = 0.0,
    mix = 1.0
  )
  delay_r = std::delay<SR * 3>::Delay(
    delay_s = time_s * 1.317,
    feedback = 0.0,
    mix = 1.0
  )
  shifter_l = std::pitch_shift::DualWindow(semitones = shift, window_s = window_s)
  shifter_r = std::pitch_shift::DualWindow(semitones = shift, window_s = window_s)
  dc_l = std::filter::DCBlock()
  dc_r = std::filter::DCBlock()
  feedback_l = 0.0
  feedback_r = 0.0

event bang():
  audition.bang()

sample:
  audition_l, audition_r = audition(auto_play = auto_play)
  source_l = audition_l * (1.0 - live_input) + in1 * live_input
  source_r = audition_r * (1.0 - live_input) + in2 * live_input

  wet_l = dc_l(delay_l(source_l + feedback_r, delay_s = time_s))
  wet_r = dc_r(delay_r(source_r + feedback_l, delay_s = time_s * 1.317))
  octave_l = shifter_l(wet_l, semitones = shift, window_s = window_s)
  octave_r = shifter_r(wet_r, semitones = shift, window_s = window_s)
  feedback_l = tanh(wet_l * feedback + octave_l * shimmer)
  feedback_r = tanh(wet_r * feedback + octave_r * shimmer)

  out1 = tanh((source_l * (1.0 - mix) + (wet_l + octave_l * shimmer) * mix) * level)
  out2 = tanh((source_r * (1.0 - mix) + (wet_r + octave_r * shimmer) * mix) * level)
