import std/osc
import processors/wavefolder

params:
  live_input = false
  folds = 3.2 {0.5, 12.0}
  bias = 0.0 {-1.0, 1.0}
  movement = 0.38 {0.0, 1.0}
  mix = 0.82 {0.0, 1.0}
  level = 0.5 {0.0, 1.0}

init:
  wavefolder = StereoWavefolder()
  source_a = std::osc::Sine(freq = 110.0)
  source_b = std::osc::Sine(freq = 165.0)

sample:
  source_l = in1
  source_r = in2
  if !live_input:
    audition_a = source_a()
    audition_b = source_b()
    source_l = audition_a * 0.72 + audition_b * 0.28
    source_r = audition_a * 0.68 - audition_b * 0.32

  wavefolder.folds = folds
  wavefolder.bias = bias
  wavefolder.movement = movement
  wavefolder.mix = mix
  folded_l, folded_r = wavefolder(source_l, source_r)
  out1 = folded_l * level
  out2 = folded_r * level
