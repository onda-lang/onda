import processors/effect_audition
import processors/wavefolder

params:
  auto_play = true
  live_input = false
  folds = 3.2 {0.5, 12.0}
  bias = 0.0 {-1.0, 1.0}
  movement = 0.38 {0.0, 1.0}
  mix = 0.82 {0.0, 1.0}
  level = 0.7 {0.0, 1.0}

init:
  wavefolder = StereoWavefolder()
  audition = EffectAudition()

event bang():
  audition.bang()

sample:
  source_l, source_r = audition(auto_play = auto_play)
  if live_input:
    source_l = in1
    source_r = in2

  wavefolder.folds = folds
  wavefolder.bias = bias
  wavefolder.movement = movement
  wavefolder.mix = mix
  folded_l, folded_r = wavefolder(source_l, source_r)
  out1 = folded_l * level
  out2 = folded_r * level
