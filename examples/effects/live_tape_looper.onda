import std/osc
import processors/effect_audition

const TapeCapacity = i32(SR * 8)

params:
  auto_play = true
  live_input = 0.0 {0.0, 1.0, step = 1.0}
  loop_s = 2.8 {0.5, 7.5, unit = "s"}
  speed = 1.0 {0.25, 2.0}
  overdub = 0.0 {0.0, 0.92}
  wow = 0.0025 {0.0, 0.02}
  mix = 0.82 {0.0, 1.0}
  level = 1.0 {0.0, 1.0}

init:
  tape_l: f32[TapeCapacity]
  tape_r: f32[TapeCapacity]
  captured_samples = 0
  write_index = 0
  read_position = 0.0
  recording = true
  direction = 1.0

  audition = EffectAudition()
  wow_lfo = std::osc::Sine(freq = 0.27)

event recapture():
  recording = true
  captured_samples = 0
  write_index = 0
  read_position = 0.0

event reverse():
  direction = -direction

event clear():
  recording = false
  captured_samples = 0
  write_index = 0
  read_position = 0.0

event bang():
  audition.bang()

sample:
  source_l, source_r = audition(auto_play = auto_play)
  input_l = lerp(source_l, in1, live_input)
  input_r = lerp(source_r, in2, live_input)
  target_samples = min(max(i32(loop_s * SR), 8), TapeCapacity)

  loop_l = 0.0
  loop_r = 0.0
  if recording:
    tape_l[write_index] = input_l
    tape_r[write_index] = input_r
    write_index = write_index + 1
    captured_samples = captured_samples + 1
    if write_index >= target_samples:
      recording = false
      captured_samples = target_samples
      read_position = 0.0
  elif captured_samples > 1:
    loop_l = std::lookup::readCW(tape_l, read_position)
    loop_r = std::lookup::readCW(tape_r, read_position)
    if overdub > 0.0:
      overdub_index = i32(read_position) % captured_samples
      tape_l[overdub_index] = loop_l * overdub + input_l * (1.0 - overdub)
      tape_r[overdub_index] = loop_r * overdub + input_r * (1.0 - overdub)

    transport_speed = speed * direction * (1.0 + wow_lfo() * wow)
    read_position = wrap(read_position + transport_speed, 0.0, captured_samples)

  out1 = tanh((input_l * (1.0 - mix) + loop_l * mix) * level)
  out2 = tanh((input_r * (1.0 - mix) + loop_r * mix) * level)
