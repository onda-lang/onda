import std/delay
import std/filter
import std/osc

const TapeLineSamples = i32(SR * 3)

proc TapeLine:
  params:
    delay_s = 0.36
    feedback = 0.58
    tone = 3600.0
    wow = 0.002
    wow_rate = 0.31
    drive = 1.4

  init:
    line = std::delay<TapeLineSamples>::Linear()
    feedback_sample = 0.0
    wow_lfo = std::osc::Sine(freq = wow_rate)
    flutter_lfo = std::osc::Sine(freq = wow_rate * 7.31)
    feedback_filter = std::filter::OnePole(cutoff = tone)

  sample:
    drift = wow_lfo(freq = wow_rate) + flutter_lfo(freq = wow_rate * 7.31) * 0.18
    moving_delay = delay_s * (1.0 + wow * drift)
    write_sample = tanh((in1 + feedback_sample * feedback) * drive)
    delayed = line(write_sample, delay_samples = moving_delay * SR)

    feedback_filter.cutoff = tone
    dark_repeat = feedback_filter(delayed)
    feedback_sample = dark_repeat
    out1 = delayed

proc StereoTapeEcho:
  params:
    time_s = 0.36
    feedback = 0.58
    tone = 3600.0
    wow = 0.0025
    drive = 1.4
    mix = 0.42

  init:
    left = TapeLine(wow_rate = 0.27)
    right = TapeLine(wow_rate = 0.34)

  sample:
    left.delay_s = time_s
    right.delay_s = time_s * 1.333
    left.feedback = feedback
    right.feedback = feedback * 0.97
    left.tone = tone
    right.tone = tone * 0.88
    left.wow = wow
    right.wow = wow * 1.17
    left.drive = drive
    right.drive = drive
    wet_l = left(in1 + in2 * 0.12)
    wet_r = right(in2 + in1 * 0.12)

    out1 = tanh(in1 * (1.0 - mix) + wet_l * mix)
    out2 = tanh(in2 * (1.0 - mix) + wet_r * mix)
