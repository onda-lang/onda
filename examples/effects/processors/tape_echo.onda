import std/delay
import std/filter
import std/osc
import std/smoothing

const TapeLineSamples = i32(SR * 3)

proc TapeLine:
  params:
    delay_s = 0.36
    feedback = 0.58
    tone = 3600.0
    wow = 0.002
    wow_rate = 0.31
    drive = 1.4
    transition_s = 0.04 {0.0, 1.0} => update_transition

  init:
    line = std::delay<TapeLineSamples>::Line()
    smoothed_delay = delay_s
    transition_coefficient = 0.0
    wow_lfo = std::osc::Sine(freq = wow_rate)
    flutter_lfo = std::osc::Sine(freq = wow_rate * 7.31)
    feedback_filter = std::filter::OnePole(cutoff = tone)

  def update_transition():
    transition_coefficient = std::smoothing::time_coefficient(transition_s)

  sample:
    drift = wow_lfo(freq = wow_rate) + flutter_lfo(freq = wow_rate * 7.31) * 0.18
    smoothed_delay = delay_s + (smoothed_delay - delay_s) * transition_coefficient
    moving_delay = smoothed_delay * (1.0 + wow * drift)
    delayed = line.readL(moving_delay * SR)

    feedback_filter.cutoff = tone
    dark_repeat = feedback_filter(delayed)
    write_sample = tanh((in1 + dark_repeat * feedback) * drive)
    line.write(write_sample)
    line.advance()
    out1 = delayed

proc StereoTapeEcho:
  params:
    time_s = 0.36
    feedback = 0.58
    tone = 3600.0
    wow = 0.0025
    drive = 1.4
    mix = 0.42

  init:
    left = TapeLine(wow_rate = 0.27)
    right = TapeLine(wow_rate = 0.34)

  sample:
    left.delay_s = time_s
    right.delay_s = time_s * 1.333
    left.feedback = feedback
    right.feedback = feedback * 0.97
    left.tone = tone
    right.tone = tone * 0.88
    left.wow = wow
    right.wow = wow * 1.17
    left.drive = drive
    right.drive = drive
    wet_l = left(in1 + in2 * 0.12)
    wet_r = right(in2 + in1 * 0.12)

    out1 = tanh(in1 * (1.0 - mix) + wet_l * mix)
    out2 = tanh(in2 * (1.0 - mix) + wet_r * mix)
