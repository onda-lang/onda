import std/dynamics

proc StereoCompressor:
  params:
    threshold_db = -18.0
    ratio = 4.0
    attack_ms = 8.0
    release_ms = 120.0
    knee_db = 6.0
    makeup_db = 2.0

  init:
    compressor = std::dynamics::Compressor()

  block:
    compressor.threshold_db = threshold_db
    compressor.ratio = ratio
    compressor.attack_s = attack_ms * 0.001
    compressor.release_s = release_ms * 0.001
    compressor.knee_db = knee_db
    compressor.makeup_db = makeup_db

    sample:
      out1, out2 = compressor(in1, in2)
