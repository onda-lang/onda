import processors/effect_audition
import processors/tape_echo

params:
  auto_play = true
  live_input = false
  delay_s = 0.36 {0.04, 1.2, scale = log, unit = "s"}
  feedback = 0.58 {0.0, 0.92}
  tone = 3600.0 {250.0, 14000.0, scale = log, unit = "Hz"}
  wow = 0.0025 {0.0, 0.015}
  drive = 1.2 {0.5, 3.0}
  mix = 0.42 {0.0, 1.0}
  level = 1.0 {0.0, 1.0}

init:
  echo = StereoTapeEcho()
  audition = EffectAudition()

event bang():
  audition.bang()

sample:
  source_l, source_r = audition(auto_play = auto_play)
  if live_input:
    source_l = in1
    source_r = in2

  echo.delay_s = delay_s
  echo.feedback = feedback
  echo.tone = tone
  echo.wow = wow
  echo.drive = drive
  echo.mix = mix
  echo_l, echo_r = echo(source_l, source_r)
  out1 = echo_l * level
  out2 = echo_r * level
