import processors/effect_audition
import processors/stereo_chorus

params:
  auto_play = true
  live_input = false
  rate = 0.23 {0.03, 4.0, scale = log, unit = "Hz"}
  depth_ms = 5.0 {0.0, 12.0, unit = "ms"}
  width = 0.9 {0.0, 1.0}
  mix = 0.48 {0.0, 1.0}
  level = 1.0 {0.0, 1.0}

init:
  chorus = StereoChorus()
  audition = EffectAudition()

event bang():
  audition.bang()

sample:
  source_l, source_r = audition(auto_play = auto_play)
  if live_input:
    source_l = in1
    source_r = in2

  chorus.rate = rate
  chorus.depth_ms = depth_ms
  chorus.width = width
  chorus.mix = mix
  chorus_l, chorus_r = chorus(source_l, source_r)
  out1 = chorus_l * level
  out2 = chorus_r * level
