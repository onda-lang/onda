struct Tone:
  frequency = 110.0
  modulator_ratio = 1.498307
  modulation_index = 1.6
  gain = 0.15

struct Motion:
  rate = 0.08
  depth = 0.65

struct Patch:
  tone: Tone
  motion: Motion
  enabled: bool = true

init:
  current = Patch()
  carrier_phase = 0.0
  modulator_phase = 0.0
  motion_phase = 0.0

event configure(patch: Patch):
  current = patch

sample:
  carrier_phase = wrap(carrier_phase + current.tone.frequency / SR, 0.0, 1.0)
  modulator_phase = wrap(
    modulator_phase + current.tone.frequency * current.tone.modulator_ratio / SR,
    0.0,
    1.0
  )
  motion_phase = wrap(motion_phase + current.motion.rate / SR, 0.0, 1.0)
  motion = 0.5 + 0.5 * sin(motion_phase * TWO_PI)
  index = current.tone.modulation_index * (1.0 + current.motion.depth * motion)
  phase_modulation = sin(modulator_phase * TWO_PI) * index
  if current.enabled:
    out1 = sin(carrier_phase * TWO_PI + phase_modulation) * current.tone.gain
  else:
    out1 = 0.0
