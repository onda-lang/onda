import std/convolution
import std/filter

const RoomFFTSize = 16384
const RoomMaxImpulseSamples = i32(SR * 10)
const RoomImpulseLoadSeconds = 0.5

use std::convolution<RoomFFTSize, RoomMaxImpulseSamples> as RoomConvolution

proc ConvolutionRoom:
  buffers:
    room_ir: f32[2]

  params:
    damping = 12000.0
    impulse_gain = 0.02

  init:
    convolver_l = RoomConvolution::ZeroLatencyConvolver()
    convolver_r = RoomConvolution::ZeroLatencyConvolver()
    convolver_l.set_channel(0)
    convolver_r.set_channel(1)
    tone_l = std::filter::OnePole(cutoff = damping)
    tone_r = std::filter::OnePole(cutoff = damping)

  task load_impulse():
    samples = min(room_ir.samples(), RoomMaxImpulseSamples)
    total_transforms = RoomConvolution::impulse_window_count(samples) * 2
    loading_samples = i32(RoomImpulseLoadSeconds * HOST_SR)
    loading_blocks = 1 + (loading_samples - 1) / BS

    convolver_l.begin_impulse(samples)
    convolver_r.begin_impulse(samples)

    start = 0
    end = 0
    channel = 0
    transform_credit = 0
    blocks_done = 0

    while blocks_done < loading_blocks:
      transform_credit = transform_credit + total_transforms
      while transform_credit >= loading_blocks && start < samples:
        if channel == 0:
          end = RoomConvolution::impulse_window_end(start, samples)
          convolver_l.set_impulse_window(start, room_ir[0, start:end])
          channel = 1
        else:
          convolver_r.set_impulse_window(start, room_ir[1, start:end])
          start = end
          channel = 0
        transform_credit = transform_credit - loading_blocks

      blocks_done = blocks_done + 1
      if blocks_done < loading_blocks:
        yield

  event reload_impulse():
    load_impulse.reset()

  block:
    await load_impulse()

    sample:
      excitation = (in1 + in2) * 0.5
      tone_l.cutoff = damping
      tone_r.cutoff = damping * 0.9
      out1 = tone_l(convolver_l(excitation) * impulse_gain)
      out2 = tone_r(convolver_r(excitation) * impulse_gain)
