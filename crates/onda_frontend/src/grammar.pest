WHITESPACE = _{ " " | "\t" | "\r" }
COMMENT = _{ "#" ~ (!"\n" ~ ANY)* }
NEWLINE = _{ "\n" }

program = { SOI ~ NEWLINE* ~ block* ~ EOI }
block = _{ ins_block | outs_block | params_block | const_block | events_block | event_block | buffers_block | proc_block | struct_block | def_block | namespace_block | namespace_alias_decl | init_block | block_exec_block | sample_block | graph_block }

namespace_block = { "namespace" ~ namespace_decl_head ~ NEWLINE* ~ "{" ~ NEWLINE* ~ namespace_item* ~ NEWLINE* ~ "}" ~ NEWLINE* }
namespace_alias_decl = { "namespace" ~ ident ~ NEWLINE* ~ "=" ~ NEWLINE* ~ namespace_any_ref ~ NEWLINE* }
namespace_item = _{ assert_block | const_block | struct_block | def_block | proc_block | namespace_block | namespace_alias_decl }
namespace_decl_head = { namespace_name ~ namespace_param_list? }
namespace_name = @{ ident ~ ("::" ~ ident)* }
namespace_param_list = { "<" ~ namespace_param_decl ~ ("," ~ namespace_param_decl)* ~ ">" }
namespace_param_decl = { ident ~ "=" ~ expr }
namespace_any_ref = { namespace_ref_segment ~ ("::" ~ namespace_ref_segment)* }
namespace_ref = { namespace_ref_segment ~ ("::" ~ namespace_ref_segment)+ }
namespace_ref_segment = { ident ~ namespace_call_arg_list? }
namespace_call_arg_list = { "<" ~ namespace_call_arg ~ ("," ~ namespace_call_arg)* ~ ">" }
namespace_call_arg = { (ident ~ "=")? ~ expr }

section_count = { int_lit | namespace_ref | path_ident | "(" ~ expr ~ ")" }
ins_block = {
  ins_kw ~ section_default_decl_type? ~ (
    (section_count? ~ NEWLINE* ~ "{" ~ NEWLINE* ~ port_list? ~ NEWLINE* ~ "}" ~ NEWLINE*)
    | (section_count ~ NEWLINE*)
  )
}
outs_block = {
  outs_kw ~ section_default_decl_type? ~ (
    (section_count? ~ NEWLINE* ~ "{" ~ NEWLINE* ~ port_list? ~ NEWLINE* ~ "}" ~ NEWLINE*)
    | (section_count ~ NEWLINE*)
  )
}
params_block = {
  "params" ~ section_default_decl_type? ~ (
    (section_count? ~ NEWLINE* ~ "{" ~ NEWLINE* ~ param_list? ~ NEWLINE* ~ "}" ~ NEWLINE*)
    | (section_count ~ NEWLINE*)
  )
}
buffers_block = {
  "buffers" ~ section_default_elem_type? ~ (
    (NEWLINE* ~ "{" ~ NEWLINE* ~ buffer_list? ~ NEWLINE* ~ "}" ~ NEWLINE*)
    | (section_count ~ NEWLINE*)
  )
}
events_block = { "events" ~ NEWLINE* ~ "{" ~ NEWLINE* ~ event_list? ~ NEWLINE* ~ "}" ~ NEWLINE* }
event_block = { "event" ~ event_decl ~ NEWLINE* }
event_list = { event_decl ~ (stmt_sep+ ~ event_decl)* ~ stmt_sep* }
event_decl = { ident ~ "(" ~ event_param_list? ~ ")" ~ NEWLINE* ~ stmt_block }
event_param_list = { event_param_decl ~ ("," ~ event_param_decl)* }
event_param_decl = { ident ~ (":" ~ event_param_type)? ~ ("=" ~ expr)? }
event_param_type = { array_type | fn_typed_array_param | type_name }
proc_block = { proc_kw ~ ident ~ generic_param_list? ~ NEWLINE* ~ "{" ~ NEWLINE* ~ proc_item* ~ NEWLINE* ~ "}" ~ NEWLINE* }
proc_item = _{ ins_block | outs_block | params_block | const_block | events_block | event_block | buffers_block | init_block | block_exec_block | sample_block | graph_block | def_block }
struct_block = { "struct" ~ ident ~ generic_param_list? ~ NEWLINE* ~ "{" ~ NEWLINE* ~ field_list? ~ NEWLINE* ~ struct_method_list? ~ NEWLINE* ~ "}" ~ NEWLINE* }
def_block = { "def" ~ ident ~ generic_param_list? ~ "(" ~ fn_param_list? ~ ")" ~ (NEWLINE* ~ fn_return_arrow ~ NEWLINE* ~ fn_return_type)? ~ NEWLINE* ~ stmt_block ~ NEWLINE* }
assert_block = { "assert" ~ NEWLINE* ~ "(" ~ NEWLINE* ~ expr ~ NEWLINE* ~ ")" ~ NEWLINE* }
const_block = { const_decl ~ NEWLINE* }
const_decl = { "const" ~ ident ~ (":" ~ type_name)? ~ "=" ~ expr }
init_block = { "init" ~ section_default_decl_type? ~ NEWLINE* ~ "{" ~ NEWLINE* ~ stmt_list? ~ NEWLINE* ~ "}" ~ NEWLINE* }
block_exec_block = { "block" ~ NEWLINE* ~ "{" ~ NEWLINE* ~ block_exec_list? ~ NEWLINE* ~ "}" ~ NEWLINE* }
block_exec_list = { block_exec_item ~ (stmt_sep+ ~ block_exec_item)* ~ stmt_sep* }
block_exec_item = _{ sample_nested_block | stmt }
sample_nested_block = { "sample" ~ sample_factor? ~ NEWLINE* ~ stmt_block }
sample_block = { "sample" ~ sample_factor? ~ NEWLINE* ~ "{" ~ NEWLINE* ~ stmt_list? ~ NEWLINE* ~ "}" ~ NEWLINE* }
sample_factor = { expr }
graph_block = { "graph" ~ NEWLINE* ~ "{" ~ NEWLINE* ~ graph_edge_list? ~ NEWLINE* ~ "}" ~ NEWLINE* }
graph_edge_list = { graph_edge ~ (stmt_sep+ ~ graph_edge)* ~ stmt_sep* }
graph_edge = { graph_rate? ~ (graph_send_edge | graph_recv_edge) }
graph_send_edge = { graph_expr ~ graph_arrow ~ graph_edge_targets }
graph_recv_edge = { graph_edge_targets ~ graph_receiver_arrow ~ graph_expr }
graph_rate = { "@block" | "@sample" }
graph_arrow = { ">>" ~ graph_delay? }
graph_receiver_arrow = { "<<" ~ graph_delay? }
graph_delay = { "[" ~ expr ~ "]" }
graph_expr = { prefix* ~ graph_term ~ ((or_op | and_op | bit_or_op | bit_xor_op | bit_and_op | cmp_op | add_op | mul_op) ~ prefix* ~ graph_term)* }
graph_term = _{ call_field_expr | call_expr | slice_expr | graph_nested_indexed_member_expr | indexed_member_expr | index_expr | array_lit | bool_lit | number | namespace_ref | path_ident | "(" ~ graph_expr ~ ")" }
graph_nested_indexed_member_expr = { path_ident ~ "[" ~ expr ~ "]" ~ "." ~ ident ~ "[" ~ expr ~ "]" ~ !"::" }
graph_edge_targets = { graph_endpoint_set | graph_endpoint }
graph_endpoint_set = { "{" ~ NEWLINE* ~ graph_endpoint ~ (NEWLINE* ~ "," ~ NEWLINE* ~ graph_endpoint)* ~ (NEWLINE* ~ ",")? ~ NEWLINE* ~ "}" }
graph_endpoint = { indexed_graph_endpoint | path_ident }
indexed_graph_endpoint = { path_ident ~ "[" ~ expr ~ "]" ~ "." ~ ident ~ !"::" }

ins_kw = { "ins" | "inputs" }
outs_kw = { "outs" | "outputs" }
proc_kw = { "proc" | "processor" }
section_default_decl_type = { "<" ~ (type_name | namespace_ref | qualified_ident) ~ ">" }
section_default_elem_type = { "[" ~ (type_name | namespace_ref | qualified_ident) ~ "]" }

port_list = { port_decl ~ (list_sep+ ~ port_decl)* ~ list_sep* }
decl_type = { array_type | tuple_type | type_name | namespace_ref | qualified_ident }
tuple_type = { "(" ~ type_name ~ ("," ~ type_name)+ ~ ")" }
decl_range = { "{" ~ expr ~ ("," ~ expr)? ~ "}" }
port_decl = { ident ~ (":" ~ decl_type)? ~ ("=" ~ expr)? ~ decl_range? }
param_list = { param_decl ~ (list_sep+ ~ param_decl)* ~ list_sep* }
param_decl = { ident ~ (":" ~ decl_type)? ~ ("=" ~ expr)? ~ decl_range? }
buffer_list = { buffer_decl ~ (list_sep+ ~ buffer_decl)* ~ list_sep* }
buffer_decl = { ident ~ (":" ~ buffer_decl_type)? }
buffer_decl_type = { buffer_type | buffer_inner }
buffer_type = { "buffer" ~ "[" ~ buffer_inner ~ "]" }
buffer_inner = { (type_name | qualified_ident) ~ ("[" ~ (expr)? ~ "]")? }
field_list = { field_decl ~ (field_sep+ ~ field_decl)* ~ field_sep* }
field_decl = {
  (ident ~ ":" ~ field_type ~ ("=" ~ expr)?)
  | (ident ~ "=" ~ expr)
  | (ident ~ &field_sep)
}
field_type = { array_type | tuple_type | type_name | named_type }
array_type = { (type_name | named_type) ~ "[" ~ expr ~ "]" }
type_name = { "f32" | "f64" | "i32" | "i64" | "bool" }
generic_param_list = { "<" ~ ident ~ ("," ~ ident)* ~ ">" }
generic_type_arg_list = { "<" ~ generic_type_arg ~ ("," ~ generic_type_arg)* ~ ">" }
generic_type_arg = { type_name | ident }
fn_param_list = { fn_param_decl ~ ("," ~ fn_param_decl)* }
fn_typed_array_param = { (type_name | namespace_ref | qualified_ident) ~ "[" ~ "]" }
fn_sized_array_param = { (type_name | namespace_ref | qualified_ident) ~ "[" ~ expr ~ "]" }
fn_untyped_array_param = { "[" ~ "]" }
fn_bare_buffer = { "buffer" }
fn_tuple_param = { "(" ~ type_name ~ ("," ~ type_name)+ ~ ")" }
fn_param_type = { fn_typed_array_param | fn_untyped_array_param | buffer_type | fn_sized_array_param | fn_bare_buffer | fn_tuple_param | type_name | namespace_ref | qualified_ident }
fn_return_arrow = { "->" }
fn_return_scalar_type = { type_name | namespace_ref | qualified_ident }
fn_return_tuple_type = { "(" ~ fn_return_scalar_type ~ ("," ~ fn_return_scalar_type)+ ~ ")" }
fn_return_type = { fn_return_tuple_type | fn_return_scalar_type }
fn_param_decl = { ident ~ (":" ~ fn_param_type)? ~ ("=" ~ expr)? }
struct_method_list = { struct_method_decl ~ (NEWLINE* ~ struct_method_decl)* ~ NEWLINE* }
struct_method_decl = { "def" ~ ident ~ generic_param_list? ~ "(" ~ fn_param_list? ~ ")" ~ (NEWLINE* ~ fn_return_arrow ~ NEWLINE* ~ fn_return_type)? ~ NEWLINE* ~ stmt_block }

stmt_list = { stmt ~ (stmt_sep+ ~ stmt)* ~ stmt_sep* }
stmt = _{ if_stmt | for_stmt | while_stmt | loop_stmt | break_stmt | continue_stmt | return_stmt | const_decl | assign_stmt | call_stmt }
assign_stmt = { typed_assign_stmt | plain_assign_stmt }
named_type = { (namespace_ref | qualified_ident | ident) ~ generic_type_arg_list? }
typed_decl_type = { array_type | tuple_type | type_name | named_type }
typed_assign_stmt = { ident ~ ":" ~ typed_decl_type ~ ("=" ~ expr)? }
plain_assign_stmt = { assign_target ~ "=" ~ expr }
assign_target = _{ slice_target | indexed_member_target | index_target | tuple_target | path_ident }
tuple_target = { "(" ~ ident ~ ("," ~ ident)+ ~ ")" }
indexed_member_target = { path_ident ~ "[" ~ expr ~ "]" ~ "." ~ ident ~ !"::" }
index_target = { path_ident ~ "[" ~ expr ~ "]" ~ ("[" ~ expr ~ "]")? }
slice_target = { path_ident ~ "[" ~ slice_start? ~ ":" ~ slice_end? ~ "]" }
return_stmt = { "return" ~ expr }
call_stmt = { call_expr }
if_cond = { expr }
if_stmt = { "if" ~ if_cond ~ stmt_block ~ elif_clause* ~ (NEWLINE* ~ "else" ~ stmt_block)? }
elif_clause = { NEWLINE* ~ "elif" ~ if_cond ~ stmt_block }
for_stmt = { "for" ~ ident ~ for_step? ~ "in" ~ for_bound ~ for_range_op ~ for_bound ~ stmt_block }
for_step = { "@" ~ expr }
for_range_op = { "..=" | ".." }
while_stmt = { "while" ~ expr ~ stmt_block }
loop_stmt = { "loop" ~ for_bound ~ stmt_block }
break_stmt = { "break" }
continue_stmt = { "continue" }
for_bound = { int_lit | namespace_ref | path_ident | "(" ~ expr ~ ")" }
stmt_block = { "{" ~ NEWLINE* ~ stmt_list? ~ NEWLINE* ~ "}" }

list_sep = _{ "," | ";" | NEWLINE+ }
field_sep = _{ "," | ";" | NEWLINE+ }
stmt_sep = _{ ";" | NEWLINE+ }

expr = { prefix* ~ term ~ ((or_op | and_op | bit_or_op | bit_xor_op | bit_and_op | shift_op | cmp_op | add_op | mul_op) ~ prefix* ~ term)* }
term = _{ call_field_expr | call_expr | slice_expr | indexed_member_expr | index_expr | array_lit | bool_lit | number | namespace_ref | path_ident | tuple_expr | "(" ~ expr ~ ")" }
tuple_expr = { "(" ~ expr ~ ("," ~ expr)+ ~ ")" }
array_lit = { "[" ~ NEWLINE* ~ (expr ~ (NEWLINE* ~ "," ~ NEWLINE* ~ expr)*)? ~ NEWLINE* ~ "]" }
call_field_expr = { call_expr ~ "." ~ ident }
call_expr = { call_target ~ generic_type_arg_list? ~ "(" ~ NEWLINE* ~ arg_list? ~ NEWLINE* ~ ")" }
call_target = { call_index_member_target | call_index_target | namespace_ref | path_ident }
call_index_member_target = { path_ident ~ "[" ~ expr ~ "]" ~ "." ~ ident ~ !"::" }
call_index_target = { path_ident ~ "[" ~ expr ~ "]" ~ !"::" }
arg_list = { call_arg ~ (NEWLINE* ~ "," ~ NEWLINE* ~ call_arg)* ~ (NEWLINE* ~ ",")? }
call_arg = { (ident ~ "=")? ~ expr }
index_expr = { path_ident ~ "[" ~ expr ~ "]" ~ !"::" ~ ("[" ~ expr ~ "]")? }
indexed_member_expr = { path_ident ~ "[" ~ expr ~ "]" ~ "." ~ ident ~ !"::" ~ ("[" ~ expr ~ "]")? }
slice_expr = { path_ident ~ "[" ~ slice_start? ~ ":" ~ slice_end? ~ "]" ~ !"::" }
slice_start = { expr }
slice_end = { expr }
bool_lit = { "true" | "false" }
path_ident = @{ ident ~ (("." | "::") ~ ident)* }
qualified_ident = @{ ident ~ ("::" ~ ident)* }

prefix = { "-" | "!" | "~" }
or_op = { "||" }
and_op = { "&&" }
bit_or_op = { "|" }
bit_xor_op = { "^" }
bit_and_op = { "&" }
shift_op = { "<<" | ">>" }
add_op = { "+" | "-" }
mul_op = { "*" | "/" | "%" }
cmp_op = { "==" | "!=" | "<=" | ">=" | "<" | ">" }

ident_char = _{ ASCII_ALPHANUMERIC | "_" }
keyword = _{ ("while" | "break" | "continue") ~ !ident_char }
ident = @{ !keyword ~ (ASCII_ALPHA | "_") ~ ident_char* }
int_lit = @{ ASCII_DIGIT+ }
number = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT*)? | "." ~ ASCII_DIGIT+ }
