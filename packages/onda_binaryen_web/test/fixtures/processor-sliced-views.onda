proc Voice:
  delegate fired(value: i32)
  sample:
    fired(1)
    out1 = 0.0
proc Bank:
  init:
    voices: Voice[3] = Voice()
    count: i32 = 0
  when voices[1].fired(value):
    count += value
  sample:
    out1 = f32(count)
def step(voice) -> f32:
  return voice()
def exercise(bank: Bank) -> f32:
  window = bank.voices[1:3]
  step(window[0])
  return bank()
init:
  bank = Bank()
sample:
  out1 = exercise(bank)
