proc Voice:
  delegate finished(value: i32)
  init:
    before: i32 = 0
    after: i32 = 0
  block:
    before += 1
    sample:
      out1 = f32(before * 10 + after)
    after += 1
    finished(after)
def step(voice) -> f32:
  return voice()
proc Bank:
  init:
    voice = Voice()
    completions: i32 = 0
    observed: i32 = 0
  when voice.finished(value):
    completions = value
  block:
    sample:
      out1 = step(voice) + f32(observed * 100)
    observed = completions
init:
  bank = Bank()
sample:
  out1 = bank()
