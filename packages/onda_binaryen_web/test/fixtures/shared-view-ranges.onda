def transform(source: f32[], destination: f32[]):
  for i in 0..min(source.len(), destination.len()):
    destination[i] = source[source.len() - 1 - i] * 0.5 + source[i]

def forward(source: f32[], destination: f32[]):
  transform(source[4:68], destination[8:72])

init:
  values: f32[512]

block:
  for i in 0..512:
    values[i] = f32(i)
  forward(values[12:108], values[248:344])
  forward(values[108:204], values[344:440])
  error = 0.0
  for i in 0..64:
    error += abs(values[256 + i] - (f32(79 - i) * 0.5 + f32(16 + i)))
    error += abs(values[352 + i] - (f32(175 - i) * 0.5 + f32(112 + i)))
  for i in 0..256:
    error += abs(values[i] - f32(i))
  for i in 320..352:
    error += abs(values[i] - f32(i))
  for i in 416..512:
    error += abs(values[i] - f32(i))
  sample:
    out1 = error
