outs:
  out1

buffers:
  first: f32
  second: f32

delegate observed(value: f32)

init:
  count: i32 = 0
  first[0] += 1.0
  print(
    "init",
    i32(-2147483647 - 1),
    i64(-9223372036854775807 - 1),
    true,
    first.len(),
    second.len(),
    first[0]
  )

event report(value: i64):
  print("event", value, false)
  observed(f32(-0.0))
  observed(f32(1.0) / f32(0.0))
  observed(-f32(1.0) / f32(0.0))
  observed(f32(0.0) / f32(0.0))

block:
  print("block", count)

  sample:
    if count == 0:
      print("sample", f32(-0.0), f64(1.25))
    count += 1
    out1 = f32(count)
