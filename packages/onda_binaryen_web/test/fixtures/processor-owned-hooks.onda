proc Voice:
  init:
    before: i32 = 0
    after: i32 = 0
  block:
    before += 1
    sample:
      out1 = f32(before * 10 + after)
    after += 1
proc Bank:
  init:
    voices: Voice[2] = Voice()
  sample:
    out1 = 0.0
def step(voice) -> f32:
  return voice()
init:
  bank = Bank()
  copy: Bank = bank
sample:
  out1 = step(copy.voices[0])
