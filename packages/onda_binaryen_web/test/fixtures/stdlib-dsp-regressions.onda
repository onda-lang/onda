import std/osc
import std/env
import std/filter
import std/levels

outs 13

init:
  triangle = std::osc::Triangle<f64>(freq = 4800.0)
  saw = std::osc::Saw<f64>(freq = -4800.0)
  adsr = std::env::ADSR(attack_s = 0.0, decay_s = 0.0, sustain = 0.5, release_s = 8.0 / SR)
  decay = std::env::DecayEnv(end_level = 1.0)
  low = std::filter::Biquad()
  high = std::filter::Biquad()
  low_coefficients = std::filter::design_lowpass<f32>(1.0, 0.707107)
  high_coefficients = std::filter::design_highpass<f32>(1.0, 0.707107)
  impulse = 1.0
  completions = 0
  frame = 0

when decay.finished():
  completions += 1

when adsr.finished():
  completions += 1

sample:
  if frame == 0:
    adsr.start()
    decay.start()
    low.set_coefficients(low_coefficients)
    high.set_coefficients(high_coefficients)
  if frame == 4:
    adsr.release()
  left, right = std::levels::pan_linear(0)
  out1 = f32(triangle())
  out2 = f32(saw())
  out3 = adsr()
  out4 = decay()
  out5 = f32(completions)
  out6 = f32(inverse_lerp(0, 10, 5))
  out7 = left
  out8 = right
  out9 = low(1.0)
  out10 = high(impulse)
  out11 = low_coefficients.b0 / 0.0000000042832864
  out12 = linexp(0.5, 0.0, 1.0, 2, 9)
  out13 = std::osc::poly_blep<f32>(0.025, -0.1)
  impulse = 0.0
  frame += 1
