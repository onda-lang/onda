const N = 256
init:
  frequency: f32[N]
  phase: f32[N]
  rendered: f32[N]
  observed = 0.0
  for i in 0..N:
    frequency[i] = 110.0 + f32(i)
sample:
  for i in 0..N:
    phase[i] += frequency[i] / SR
    if phase[i] >= 1.0:
      phase[i] -= 1.0
    if i == 0:
      observed = phase[i]
    rendered[i] = phase[i]
  total = 0.0
  for i in 0..N:
    total += rendered[i]
  out1 = total / f32(N) + observed
