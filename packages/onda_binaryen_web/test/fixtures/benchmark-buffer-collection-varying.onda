buffers:
  mono: f32 {4}
  fixed: f32[2] {4}
  dynamic: f32[] {4}

init:
  index = 0

block:
  samples = mono[0].samples()

  sample:
    slot = (index / 32) % 4
    out1 = mono[slot][index] + fixed[slot][1, index] + dynamic[slot][1, index]
    index = index + 1
    if index >= samples:
      index = 0
