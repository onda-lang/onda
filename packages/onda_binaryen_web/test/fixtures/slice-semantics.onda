outs:
  out1

struct Counter:
  value: f32 = 0.0
  history: (f32, i32) = (0.0, 1)
  steps: f32[2]

  def advance(self, amount: f32):
    self.value = self.value + amount
    self.history[0] = self.value
    self.steps[0] = self.history[0]
    step_view = self.steps[:]
    return self.value + step_view[0] - step_view[0] + f32(self.history[1] - 1) + f32(self.steps.len() - 2)

struct MarkerMeta:
  score: f32 = 0.0

struct Marker:
  value: f32 = 1.0
  meta: MarkerMeta
  trail: f32[2]

def sum_markers_inner(markers):
  total = 0.0
  for i in 0..(markers.len()):
    marker = markers[i]
    marker.trail[0] = marker.value
    marker.meta.score = marker.trail[0]
    total = total + marker.meta.score
  return total

def sum_markers(markers):
  return sum_markers_inner(markers)

def advance_counter(counter: Counter):
  return counter.advance(0.25)

def pair_total(values: (f32, i32)):
  return values[0] + f32(values[1])

def sum(values: f32[]):
  edges = [values[0], values[values.len() - 1]]
  edge_view = edges[:]
  total = 0.0
  for i in 0..(values.len()):
    total = total + values[i]
  return total + pair_total((edge_view[0], 0)) - values[0] + f32(edges.len() - 2)

def bump_first(values: f32[]):
  values[0] = values[0] + 0.5

init:
  samples: f32[4] = [1.0, 2.0, 3.0, 4.0]
  counter = Counter()
  markers: Marker[2] = [Marker(value = 2.0), Marker()]

event seed(scale: f32, values: f32[], add: f32):
  samples[0] = values[0] * scale
  samples[1] = values[values.len() - 1] + add

sample:
  offset = advance_counter(counter)
  marker_ref = markers[1]
  marker_ref.value = markers[0].value + 0.25
  marker = marker_ref.value
  marker_sum = sum_markers(markers)
  middle = samples[1:3]
  bump_first(middle)
  samples[2:3] = 4.0
  samples[-1:] = middle
  out1 = sum(samples[:]) + offset - offset + marker - marker + marker_sum - marker_sum
