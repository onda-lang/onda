import std/filter
import std/smoothing

proc Exercise<T>:
  outs<T> 2

  init<T>:
    filter = std::filter::OnePole<T>(cutoff = 0.0)
    lag = std::smoothing::Lag<T>(lag_s = 0.0)
    expected_filter = 0.0
    expected_lag: f64 = 0.0
    frame: i32 = 0

  sample:
    # Repeated assignments, changes within a block, and zero/negative times.
    cutoff = T((frame / 7) % 5) * T(700.0)
    lag_time = T((frame / 5) % 4 - 1) * T(0.0005)
    filter.cutoff = cutoff
    lag.lag_s = lag_time
    if frame % 9 == 0:
      lag.reset(T(1.0))
      expected_lag = T(1.0)

    input = T(frame % 11 - 5) / T(8.0)
    coefficient: T = 1.0 - exp(-TWO_PI * cutoff / SR)
    expected_filter += coefficient * (input - expected_filter)
    out1 = filter(input) - expected_filter

    lag_coefficient = f64(0.0)
    if lag_time > 0.0:
      lag_coefficient = exp(-1.0 / (f64(lag_time) * SR))
    expected_lag *= lag_coefficient
    out2 = lag(T(0.0)) - T(expected_lag)
    frame += 1

outs 4
init:
  check32 = Exercise<f32>()
  check64 = Exercise<f64>()
sample:
  filter32, lag32 = check32()
  filter64, lag64 = check64()
  out1 = filter32
  out2 = lag32
  out3 = f32(filter64)
  out4 = f32(lag64)
