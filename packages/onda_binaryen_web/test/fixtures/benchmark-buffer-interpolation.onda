import std/lookup

buffers:
  clip: f32[]

init:
  position = 0.0

block:
  samples = clip.samples()

  sample:
    out1 = std::lookup::readL(clip, 0, position)
    out2 = std::lookup::readC(clip, 1, position)
    position = position + 0.75
    if position >= f32(samples):
      position = position - f32(samples)

