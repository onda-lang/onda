struct Counter:
  value: i32
proc Voice:
  buffers:
    left: f32
    right: f32
  sample:
    out1 = left[0] * 10.0 + right[0]
proc Bank:
  buffers:
    source: f32
  init:
    voice = Voice(left = source, right = source)
  sample:
    out1 = voice()
def advance(counter: Counter) -> i32:
  result = counter.value
  counter.value += 1
  return result
def step(voice) -> f32:
  return voice()
buffers:
  clips: f32 {2}
init:
  counter = Counter(0)
  bank = Bank(source = clips[advance(counter)])
sample:
  clips[0][0] = 7.0
  clips[1][0] = 11.0
  counter.value = 0
  out1 = step(bank.voice)
  out2 = f32(counter.value)
  counter.value = 0
  out3 = bank()
  out4 = f32(counter.value)
