proc Voice:
  delegate fired(value: i32)
  sample:
    fired(1)
    out1 = 0.0
proc Bank:
  params:
    weight: i32 = 1
  init:
    voices: Voice[2] = Voice()
    count: i32 = 0
  when voices[0].fired(value):
    count += value * weight
  sample:
    out1 = f32(count)
proc OtherBank:
  init:
    voices: Voice[2] = Voice()
    count: i32 = 0
  when voices[0].fired(value):
    count += value * 100
  sample:
    out1 = f32(count)
def step(voice) -> f32:
  return voice()
def exercise(left: Bank, right: Bank, other: OtherBank, outer: bool, inner: bool):
  if outer:
    if inner:
      selected = left.voices[0]
    else:
      selected = right.voices[0]
  else:
    selected = other.voices[0]
  step(selected)
init:
  left = Bank(weight = 2)
  right = Bank(weight = 7)
  other = OtherBank()
  index: i32 = 0
sample:
  exercise(left, right, other, index % 2 == 0, index % 4 < 2)
  index += 1
  out1 = left()
  out2 = right()
  out3 = other()
