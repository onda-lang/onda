proc Loader:
  init:
    pin progress: i32 = 0
    scratch: i32 = 5

  task load():
    progress += 1
    scratch += 1
    yield
    progress += 10
    scratch += 10

  block:
    await load()

    sample:
      out1 = f32(progress + scratch)

init:
  loader = Loader()

event soft_init():
  loader.init()

event hard_init():
  loader.init(full = true)

sample:
  out1 = loader()
