outs:
  out1
  out2
  out3
  out4
  out5
  out6
  out7
  out8
  out9
  out10

init:
  wide_negative_zero: f64 = 0.0
  wide_positive_infinity: f64 = 0.0
  wide_negative_infinity: f64 = 0.0
  wide_rounded: f64 = 0.0

sample:
  zero: f32 = 0.0
  out1 = -zero
  out2 = zero
  out3 = f32(1.0) / zero
  out4 = -f32(1.0) / zero
  out5 = zero / zero
  out6 = f32(16777216.0) + f32(1.0)
  wide_negative_zero = -f64(0.0)
  wide_positive_infinity = f64(1.0) / f64(0.0)
  wide_negative_infinity = -f64(1.0) / f64(0.0)
  wide_rounded = f64(9007199254740992.0) + f64(1.0)
  out7 = f32(wide_negative_zero)
  out8 = f32(wide_positive_infinity)
  out9 = f32(wide_negative_infinity)
  out10 = f32(wide_rounded - f64(9007199254740992.0))
