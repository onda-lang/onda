proc Voice:
  init:
    count: i32 = 0
  sample:
    count += 1
    out1 = f32(count)
proc Bank:
  init:
    voices: Voice[2] = Voice()
  sample:
    out1 = 0.0
def step(voices, index: i32) -> f32:
  return voices[index]()
def exercise(left: Bank, right: Bank, choose: bool) -> f32:
  if choose:
    selected = left.voices[0]
  else:
    selected = right.voices[1]
  return selected()
init:
  left = Bank()
  right = Bank()
  choose = true
sample:
  out1 = exercise(left, right, choose)
  choose = !choose
