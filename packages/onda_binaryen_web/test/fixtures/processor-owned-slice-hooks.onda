proc Voice:
  init:
    count: i32 = 0
  block:
    count += 100
    sample:
      count += 1
      out1 = f32(count)
def step(voice) -> f32:
  return voice()
proc Bank:
  init:
    voices: Voice[3] = Voice()
def exercise(bank: Bank) -> f32:
  copies: Voice[2] = bank.voices[1:3]
  return step(copies[1])
init:
  bank = Bank()
  bank.voices[1].count = 20
  bank.voices[2].count = 30
sample:
  out1 = exercise(bank)
