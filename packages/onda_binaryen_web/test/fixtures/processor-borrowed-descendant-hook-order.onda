proc Voice:
  delegate finished(value: i32)
  init:
    before: i32 = 0
    after: i32 = 0
  block:
    before += 1
    sample:
      out1 = f32(before * 10 + after)
    after += 1
    finished(after)
proc Middle:
  delegate finished(value: i32)
  init:
    voice = Voice()
  when voice.finished(value):
    finished(value)
  sample:
    out1 = 0.0
proc Bank:
  init:
    middle = Middle()
    completions: i32 = 0
    observed: i32 = 0
  when middle.finished(value):
    completions = value
  block:
    sample:
      out1 = f32(observed * 100)
    observed = completions
init:
  bank = Bank()
sample:
  out1 = bank.middle.voice() + bank()
