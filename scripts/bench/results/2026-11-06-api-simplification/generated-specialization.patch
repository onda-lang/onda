+//! Paired native-kernel comparison, excluding hosted runtime checks.
+//! cargo run --release -p onda_examples --example benchmark_full_block -- <source|--tiny> <frames>
+use onda_codegen_llvm::{
+    jit_program_from_optimized_mir_with_options, JitProgram, MirCompileOptions, RuntimeState,
+    TargetOptLevel, PROCESSOR_FULL_BLOCK,
+};
+use onda_frontend::{load_program_file, parse_program, PrimitiveType};
+use onda_semantics::{analyze_with_options, lower_program_to_optimized_mir, AnalysisOptions};
+use std::{env, hint::black_box, time::Instant};
+
+struct Kernel<'a> {
+    program: &'a JitProgram,
+    state: RuntimeState,
+    params: Vec<u8>,
+    inputs: Vec<Vec<f32>>,
+    outputs: Vec<Vec<f32>>,
+    input_pointers: Vec<*const u8>,
+    output_pointers: Vec<*mut u8>,
+}
+impl<'a> Kernel<'a> {
+    fn new(program: &'a JitProgram) -> Self {
+        let params = program.default_param_bytes();
+        let state = program.initialize_state(&params).unwrap();
+        let inputs = vec![vec![0.0; program.block_size()]; program.required_in_channels()];
+        let mut outputs = vec![vec![0.0; program.block_size()]; program.required_out_channels()];
+        let input_pointers = inputs.iter().map(|port| port.as_ptr().cast()).collect();
+        let output_pointers = outputs
+            .iter_mut()
+            .map(|port| port.as_mut_ptr().cast())
+            .collect();
+        Self {
+            program,
+            state,
+            params,
+            inputs,
+            outputs,
+            input_pointers,
+            output_pointers,
+        }
+    }
+    fn run<const FULL: bool>(&mut self) {
+        // Storage is program-shaped, bound for this kernel's lifetime and disjoint.
+        let status = unsafe {
+            if FULL {
+                self.program.process_block_unchecked(
+                    &mut self.state,
+                    &self.params,
+                    &self.input_pointers,
+                    &self.output_pointers,
+                    &[],
+                    &[],
+                    &[],
+                    &[],
+                    None,
+                )
+            } else {
+                self.program.process_unchecked(
+                    &mut self.state,
+                    &self.params,
+                    0,
+                    self.program.block_size() as u32,
+                    PROCESSOR_FULL_BLOCK,
+                    &self.input_pointers,
+                    &self.output_pointers,
+                    &[],
+                    &[],
+                    &[],
+                    &[],
+                    None,
+                )
+            }
+        }
+        .unwrap();
+        assert_eq!(status, 0);
+    }
+    fn snapshot(&self) -> Vec<u8> {
+        let mut bytes = vec![0; self.program.state_size_bytes()];
+        self.program
+            .write_state_snapshot(&self.state, &mut bytes)
+            .unwrap();
+        bytes
+    }
+    fn time<const FULL: bool>(&mut self, blocks: usize) -> f64 {
+        let start = Instant::now();
+        for _ in 0..blocks {
+            self.run::<FULL>();
+        }
+        let elapsed = start.elapsed().as_secs_f64() * 1e9 / blocks as f64;
+        black_box((&self.inputs, &self.outputs));
+        elapsed
+    }
+}
+fn median(values: &[f64]) -> f64 {
+    let mut values = values.to_vec();
+    values.sort_by(f64::total_cmp);
+    values[values.len() / 2]
+}
+fn main() {
+    onda_realtime::configure_current_thread_audio_fp_mode();
+    let args: Vec<_> = env::args().collect();
+    let source = args.get(1).expect("source or --tiny");
+    let frames: usize = args.get(2).expect("frames").parse().unwrap();
+    let parsed = if source == "--tiny" {
+        parse_program("sample:\n  out1 = in1 * 0.5\n").unwrap()
+    } else {
+        load_program_file(std::path::Path::new(source))
+            .unwrap()
+            .program
+    };
+    let typed = analyze_with_options(
+        parsed,
+        AnalysisOptions {
+            sample_rate: 48_000.0,
+            block_size: frames,
+        },
+    )
+    .unwrap();
+    let mir = lower_program_to_optimized_mir(&typed).unwrap();
+    let program = jit_program_from_optimized_mir_with_options(
+        mir,
+        MirCompileOptions {
+            opt_level: TargetOptLevel::O3,
+            ..Default::default()
+        },
+    )
+    .unwrap();
+    assert_eq!(program.buffer_count(), 0);
+    assert!(program
+        .inputs()
+        .iter()
+        .chain(program.outputs())
+        .all(|port| port.elem_ty() == PrimitiveType::F32));
+    let mut full = Kernel::new(&program);
+    let mut segment = Kernel::new(&program);
+    for _ in 0..256 {
+        full.run::<true>();
+        segment.run::<false>();
+        assert_eq!(full.outputs, segment.outputs);
+        assert_eq!(full.snapshot(), segment.snapshot());
+    }
+    let mut blocks = 256;
+    while full.time::<true>(blocks) * (blocks as f64) < 50_000_000.0 {
+        blocks *= 2;
+    }
+    // Fresh equal state after calibration; alternate order to reduce thermal/frequency bias.
+    full = Kernel::new(&program);
+    segment = Kernel::new(&program);
+    let mut full_ns = Vec::new();
+    let mut segment_ns = Vec::new();
+    for round in 0..11 {
+        if round % 2 == 0 {
+            full_ns.push(full.time::<true>(blocks));
+            segment_ns.push(segment.time::<false>(blocks));
+        } else {
+            segment_ns.push(segment.time::<false>(blocks));
+            full_ns.push(full.time::<true>(blocks));
+        }
+        assert_eq!(full.outputs, segment.outputs);
+        assert_eq!(full.snapshot(), segment.snapshot());
+    }
+    println!(
+        "{}",
+        serde_json::json!({"source": source, "frames": frames, "blocks_per_round": blocks, "full_ns": full_ns, "segment_ns": segment_ns, "full_median_ns": median(&full_ns), "segment_median_ns": median(&segment_ns), "audio_and_state_equal": true})
+    );
+}
