+//! JIT-only specialization of the canonical process body. The raw ABI stays segmented.
+use super::*;
+
+pub(super) unsafe fn emit(
+    module: LLVMModuleRef,
+    context: LLVMContextRef,
+    frames: u32,
+) -> Result<(), MirCodegenError> {
+    let process = LLVMGetNamedFunction(module, c"onda_process".as_ptr());
+    let process_type = LLVMGlobalGetValueType(process);
+    let pointer = LLVMPointerType(LLVMInt8TypeInContext(context), 0);
+    let i32_type = LLVMInt32TypeInContext(context);
+    let mut types = [pointer; 9];
+    let signature = LLVMFunctionType(i32_type, types.as_mut_ptr(), types.len() as u32, 0);
+    let function = LLVMAddFunction(module, c"__onda_process_block".as_ptr(), signature);
+    let entry = LLVMAppendBasicBlockInContext(context, function, c"entry".as_ptr());
+    let builder = OwnedLlvm::new(LLVMCreateBuilderInContext(context), LLVMDisposeBuilder);
+    LLVMPositionBuilderAtEnd(builder.get(), entry);
+    let mut arguments = [
+        LLVMGetParam(function, 0),
+        LLVMGetParam(function, 1),
+        LLVMGetParam(function, 2),
+        LLVMGetParam(function, 3),
+        LLVMConstInt(i32_type, 0, 0),
+        LLVMConstInt(i32_type, u64::from(frames), 0),
+        LLVMConstInt(i32_type, u64::from(crate::PROCESSOR_FULL_BLOCK), 0),
+        LLVMGetParam(function, 4),
+        LLVMGetParam(function, 5),
+        LLVMGetParam(function, 6),
+        LLVMGetParam(function, 7),
+        LLVMGetParam(function, 8),
+    ];
+    // Inline the canonical body before optimizing so offset, trip count and
+    // hook flags become constants inside this entry, irrespective of body size.
+    add_enum_attribute_at_index(
+        context,
+        process,
+        llvm_sys::LLVMAttributeFunctionIndex,
+        "alwaysinline",
+        0,
+    )?;
+    let result = LLVMBuildCall2(
+        builder.get(),
+        process_type,
+        process,
+        arguments.as_mut_ptr(),
+        arguments.len() as u32,
+        c"status".as_ptr(),
+    );
+    LLVMBuildRet(builder.get(), result);
+    Ok(())
+}
