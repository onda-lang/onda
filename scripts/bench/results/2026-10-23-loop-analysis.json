  "reproducer_source": "use onda_mir::*;\nuse std::time::Instant;\nfn s(kind: StatementKind) -> Statement { Statement { kind, source: SourceSpan::UNKNOWN } }\nfn a(local: LocalId, value: Rvalue) -> Statement { s(StatementKind::Assign { destination: Place::local(local), value }) }\nfn f(name: &str, kind: FunctionKind) -> Function { Function { name: name.into(), kind, attributes: FunctionAttributes { runtime_context: true, ..Default::default() }, params: vec![], results: vec![], locals: vec![], body: Block::default(), source: SourceSpan::UNKNOWN } }\nfn program(n: usize) -> Program {\n let i32t=TypeId::new(0); let boolt=TypeId::new(1); let f32t=TypeId::new(2); let arrt=TypeId::new(3);\n let mut p=Program::new(CompileConfig::new(48000.0,128).unwrap(),FunctionId::new(0),FunctionId::new(1));\n p.types=vec![Type::Scalar(ScalarType::I32),Type::Scalar(ScalarType::Bool),Type::Scalar(ScalarType::F32),Type::Array { element:f32t,len:128 }];\n p.state.push(StateSlot {name:\"state\".into(), ty:arrt,persistence:StatePersistence::Snapshot,authored:true,pinned:false,integer_range:None});\n p.functions.push(f(\"init\",FunctionKind::Init));\n let mut work=f(\"process\",FunctionKind::Process); work.params=process_function_params(i32t);\n for k in 0..n {\n  let index=LocalId::new((k*2) as u32); let condition=LocalId::new((k*2+1) as u32);\n  work.locals.extend([Local {name:None,ty:i32t,integer_range:None},Local {name:None,ty:boolt,integer_range:None}]);\n  work.body.statements.push(a(index,Rvalue::Use(Value::Constant(ScalarValue::I32(0)))));\n  work.body.statements.push(s(StatementKind::Loop {body:Block {statements:vec![\n   a(condition,Rvalue::Compare {op:CompareOp::Less,lhs:Value::Local(index),rhs:Value::Constant(ScalarValue::I32(128))}),\n   s(StatementKind::If {condition:Value::Local(condition),then_block:Block::default(),else_block:Block {statements:vec![s(StatementKind::Break)]}}),\n   s(StatementKind::Assign {destination:Place {base:PlaceBase::State(StateId::new(0)),projections:vec![Projection::Index {index:Value::Local(index),bounds:BoundsMode::Clamp}]}, value:Rvalue::Use(Value::Constant(ScalarValue::F32(1.0)))}),\n   a(index,Rvalue::Binary {op:BinaryOp::Add,lhs:Value::Local(index),rhs:Value::Constant(ScalarValue::I32(1))}),\n  ]}}));\n }\n p.functions.push(work);p\n}\n\nmod original {\n    include!(\"/tmp/onda-loops-oracle.rs\");\n    include!(\"/tmp/onda-loop-cost-oracle.rs\");\n}\nfn compare_file(path: &str) -> usize {\n    let json=std::fs::read_to_string(path).unwrap();\n    let validated=unsafe{from_json_with_producer_proofs(&json)}.unwrap();\n    let p=validated.as_program();\n    let effects=analyze_effects(&p);\n    let memory=analyze_memory(&p);\n    let ranges=analyze_program_integer_ranges_with_effects(&p,&effects);\n    let mut checked=0;\n    for (index,function) in p.functions.iter().enumerate() {\n        let id=FunctionId::new(index as u32);\n        let analysis=LoopAnalysis::new(&p,&effects,&memory,&ranges,id);\n        let mut pending=vec![&function.body];\n        while let Some(block)=pending.pop() {\n            for statement in &block.statements {\n                match &statement.kind {\n                    StatementKind::Loop {body} => {\n                        let before=original::independent_memory_loop(&p,&effects,&memory,&ranges,id,body);\n                        assert_eq!(analysis.independent_memory_loop(body),before,\"memory: {path}, {}\",function.name);\n                        let before=original::pointwise_audio_loop(&p,&effects,function,body).map(|p|(p.scalar,format!(\"{:?}\",p.ports)));\n                        let after=analysis.pointwise_audio_loop(body).map(|p|(p.scalar,format!(\"{:?}\",p.ports)));\n                        assert_eq!(after,before,\"audio: {path}, {}\",function.name);\n                        if let Some(counted)=counted_loop(body) {\n                            assert_eq!(analysis.nonnegative_induction(counted.index),original::nonnegative_induction(function,counted.index),\"induction: {path}, {}\",function.name);\n                        }\n                        checked+=1; pending.push(body);\n                    }\n                    StatementKind::If {then_block,else_block,..} => pending.extend([then_block,else_block]),\n                    _=>{}\n                }\n            }\n        }\n    }\n    checked\n}\nfn main() {\n    let mut files=0;let mut loops=0;\n    for path in std::env::args().skip(1).filter(|path| path!=\"--decisions-only\") {loops+=compare_file(&path);files+=1;}\n    println!(\"Matched all original memory/audio/induction decisions: {loops} loops, {files} programs\");\n    if std::env::args().any(|arg|arg==\"--decisions-only\") {return;}\n    for n in [256,512,1024,2048,4096,8192] {\n        let p=program(n);validate(&p).unwrap();let effects=analyze_effects(&p);let memory=analyze_memory(&p);let ranges=analyze_program_integer_ranges_with_effects(&p,&effects);\n        let mut before=vec![];let mut after=vec![];\n        for round in 0..3 {\n            for old in if round%2==0 {[true,false]} else {[false,true]} {\n                let start=Instant::now();let mut passed=0;\n                if old {\n                    for statement in &p.functions[1].body.statements {if let StatementKind::Loop {body}=&statement.kind {passed+=std::hint::black_box(original::independent_memory_loop(&p,&effects,&memory,&ranges,FunctionId::new(1),body)) as usize;}}\n                } else {\n                    let analysis=LoopAnalysis::new(&p,&effects,&memory,&ranges,FunctionId::new(1));\n                    for statement in &p.functions[1].body.statements {if let StatementKind::Loop {body}=&statement.kind {passed+=std::hint::black_box(analysis.independent_memory_loop(body)) as usize;}}\n                }\n                let elapsed=start.elapsed().as_secs_f64()*1000.0;\n                assert_eq!(passed,n);\n                if old {before.push(elapsed);} else {after.push(elapsed);}\n            }\n        }\n        println!(\"loops={n} before_ms={before:?} after_ms={after:?}\");\n    }\n}\n\ntrait OraclePlaceType { fn oracle_place_type(&self, function: &Function, place: &Place) -> Option<TypeId>; }\nimpl OraclePlaceType for Program {\n    fn oracle_place_type(&self, function: &Function, place: &Place) -> Option<TypeId> {\n        let mut ty = match place.base {\n            PlaceBase::Local(local) => function.locals.get(local.index())?.ty,\n            PlaceBase::Parameter(parameter) => function.params.get(parameter.index())?.ty,\n            PlaceBase::State(state) => self.state.get(state.index())?.ty,\n            PlaceBase::Param(param) => self.interface.params.get(param.index())?.ty,\n            PlaceBase::EventParam(param) => {\n                let FunctionKind::Event(event) = function.kind else {\n                    return None;\n                };\n                self.interface\n                    .events\n                    .get(event.index())?\n                    .params\n                    .get(param.index())?\n                    .ty\n            }\n        };\n        for projection in &place.projections {\n            ty = match (self.types.get(ty.index())?, projection) {\n                (Type::Struct(structure), Projection::Field(field)) => {\n                    self.structs\n                        .get(structure.index())?\n                        .fields\n                        .get(field.index())?\n                        .ty\n                }\n                (Type::Array { element, .. }, Projection::Index { .. }) => *element,\n                _ => return None,\n            };\n        }\n        Some(ty)\n    }\n\n}\n",
  "scratch_artifacts": "target/bench/loop-analysis"
