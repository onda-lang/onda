{
  "name": "Omni",
  "scopeName": "source.omni",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#section-headers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#const-declarations"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#typed-declarations"
    },
    {
      "include": "#keyword-operators"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#port-aliases"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#member-access"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#namespace-paths"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.omni",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.omni",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.omni",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "section-headers": {
      "patterns": [
        {
          "name": "meta.section.header.omni",
          "match": "^(\\s*)(ins|outs|params|const|events|buffers|init|block|sample|graph)(\\s*<[^>\\n]+>)?(\\s+\\d+)?(\\s*(?::|\\{))",
          "captures": {
            "2": {
              "name": "storage.type.block.omni"
            },
            "3": {
              "name": "meta.generic.section.omni"
            },
            "4": {
              "name": "constant.numeric.omni"
            },
            "5": {
              "name": "punctuation.separator.key-value.omni"
            }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.declaration.namespace.omni",
          "match": "^(\\s*)(namespace)(\\s+)([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)(\\s*<[^>\\n]+>)?(\\s*=)?",
          "captures": {
            "2": {
              "name": "storage.type.block.omni"
            },
            "4": {
              "name": "entity.name.namespace.omni"
            },
            "5": {
              "name": "meta.generic.namespace.omni"
            },
            "6": {
              "name": "keyword.operator.assignment.omni"
            }
          }
        },
        {
          "name": "meta.declaration.type.omni",
          "match": "^(\\s*)(proc|processor|struct)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(\\s*<[^>\\n]+>)?(\\s*:)?",
          "captures": {
            "2": {
              "name": "storage.type.block.omni"
            },
            "4": {
              "name": "entity.name.type.omni"
            },
            "5": {
              "name": "meta.generic.type.omni"
            },
            "6": {
              "name": "punctuation.separator.key-value.omni"
            }
          }
        },
        {
          "name": "meta.declaration.function.omni",
          "match": "^(\\s*)(def)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(\\s*<[^>\\n]+>)?",
          "captures": {
            "2": {
              "name": "storage.type.block.omni"
            },
            "4": {
              "name": "entity.name.function.omni"
            },
            "5": {
              "name": "meta.generic.function.omni"
            }
          }
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.import.omni",
          "match": "^(\\s*)(import)(\\s+)([A-Za-z_][A-Za-z0-9_]*(?:/[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "2": {
              "name": "keyword.control.import.omni"
            },
            "4": {
              "name": "string.unquoted.import-path.omni"
            }
          }
        },
        {
          "name": "meta.include.omni",
          "match": "^(\\s*)(include)(\\s+)(\"[^\"]+\")",
          "captures": {
            "2": {
              "name": "keyword.control.import.omni"
            },
            "4": {
              "name": "string.quoted.double.omni"
            }
          }
        }
      ]
    },
    "const-declarations": {
      "patterns": [
        {
          "name": "meta.declaration.const.omni",
          "match": "\\b(const)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.const.omni"
            },
            "3": {
              "name": "variable.other.constant.omni"
            }
          }
        }
      ]
    },
    "typed-declarations": {
      "patterns": [
        {
          "name": "meta.typed.declaration.omni",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(\\s*:\\s*)([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[^>\\n]+>)?(?:\\[[^\\]\\n]*\\])?)",
          "captures": {
            "1": {
              "name": "variable.other.definition.omni"
            },
            "2": {
              "name": "punctuation.separator.type.omni"
            },
            "3": {
              "name": "storage.type.annotation.omni"
            }
          }
        },
        {
          "name": "meta.named-argument.omni",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(\\s*=)",
          "captures": {
            "1": {
              "name": "variable.parameter.omni"
            },
            "2": {
              "name": "keyword.operator.assignment.omni"
            }
          }
        }
      ]
    },
    "keyword-operators": {
      "patterns": [
        {
          "name": "keyword.control.graph.omni",
          "match": "(>>\\[[^\\]\\n]+\\]|<<\\[[^\\]\\n]+\\]|>>|<<)"
        },
        {
          "name": "keyword.operator.range.omni",
          "match": "(\\.\\.=|\\.\\.)"
        },
        {
          "name": "keyword.operator.logical.omni",
          "match": "(==|!=|<=|>=|&&|\\|\\|)"
        },
        {
          "name": "keyword.operator.arithmetic.omni",
          "match": "(::|[+\\-*/%=&|^~!])"
        },
        {
          "name": "keyword.other.rate.omni",
          "match": "@(sample|block)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.omni",
          "match": "\\b(if|elif|else|for|in|while|loop|break|continue|return|assert)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.omni",
          "match": "\\b(PI|pi|TWO_PI|TWOPI|two_pi|twopi|SAMPLE_RATE|SAMPLERATE|SR|sample_rate|samplerate|BLOCK_SIZE|BLOCKSIZE|BS|block_size|blocksize|true|false)\\b"
        }
      ]
    },
    "port-aliases": {
      "patterns": [
        {
          "name": "variable.language.port.input.omni",
          "match": "\\bin(?:[1-9]|[1-5][0-9]|6[0-4])\\b"
        },
        {
          "name": "variable.language.port.output.omni",
          "match": "\\bout(?:[1-9]|[1-5][0-9]|6[0-4])\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.omni",
          "match": "\\b(f32|f64|i32|i64|bool|buffer)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.omni",
          "match": "\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "member-access": {
      "patterns": [
        {
          "name": "variable.other.member.omni",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.omni",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:<[^>\\n]+>\\s*)?\\()"
        }
      ]
    },
    "namespace-paths": {
      "patterns": [
        {
          "name": "meta.path.namespace.omni",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(::)([A-Za-z_][A-Za-z0-9_]*)(?:(::)([A-Za-z_][A-Za-z0-9_]*))*",
          "captures": {
            "1": {
              "name": "entity.name.namespace.omni"
            },
            "2": {
              "name": "keyword.operator.namespace.omni"
            },
            "3": {
              "name": "entity.name.namespace.omni"
            },
            "4": {
              "name": "keyword.operator.namespace.omni"
            },
            "5": {
              "name": "entity.name.namespace.omni"
            }
          }
        }
      ]
    }
  }
}
